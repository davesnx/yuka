# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Run a Yuka app on its own HTTP server (ache, Lwt)"
description:
  "The request cycle of Yuka on the ache HTTP/1.1 library and Lwt, with no other web framework: one handler that serves the routes of Routes.ml, the client JavaScript, public files and the live socket, with signed cookie sessions and CSRF tokens, and a function that starts the server."
maintainer: ["David Sancho Moreno"]
authors: ["David Sancho Moreno"]
license: "MIT"
homepage: "https://github.com/davesnx/yuka"
bug-reports: "https://github.com/davesnx/yuka/issues"
depends: [
  "dune" {>= "3.25"}
  "ocaml" {>= "5.4"}
  "yuka" {= version}
  "ache"
  "ache-lwt"
  "lwt"
  "digestif" {>= "1.0.0"}
  "magic-mime"
  "mirage-crypto-rng" {>= "1.2.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/davesnx/yuka.git"
x-maintenance-intent: ["(latest)"]
