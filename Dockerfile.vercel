FROM ocaml/opam:debian-12-ocaml-5.5 AS build
WORKDIR /home/opam/yuka
COPY --chown=opam Makefile yuka.opam yuka-dream.opam yuka-live-pg.opam ./
RUN git config --global http.version HTTP/1.1 \
 && sudo apt-get update \
 && make -s pin-list | grep -E '^(dune|melange)\.' | while read -r name target; do \
      opam pin add "$name" "$target" --yes --no-action || exit 1; \
    done \
 && opam install . --deps-only --yes \
 && opam install --yes cmarkit ochre tm-grammars \
 && sudo rm -rf /var/lib/apt/lists/* \
 && opam clean --download-cache --repo-cache
COPY --chown=opam . .
RUN sudo chown opam . \
 && opam exec -- dune build --root . --profile=release \
      demo/server/demo_server.exe @demo/client/demo-client demo/client/yuka_islands.json \
      lux/server/lux_server.exe @lux/client/lux-client lux/client/yuka_islands.json

FROM node:22-bookworm-slim AS bundle
WORKDIR /yuka
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY scripts scripts
COPY demo/bundle.sh demo/bundle.sh
COPY --from=build /home/opam/yuka/_build/default/demo/client _build/default/demo/client
COPY --from=build /home/opam/yuka/_build/default/lux/client _build/default/lux/client
RUN demo/bundle.sh && demo/bundle.sh lux

FROM debian:12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libev4 libpq5 libssl3 libonig5 nginx-light \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /home/opam/yuka/_build/default/demo/server/demo_server.exe /app/demo/server/demo_server.exe
COPY --from=build /home/opam/yuka/_build/default/demo/client/yuka_islands.json /app/demo/client/yuka_islands.json
COPY --from=bundle /yuka/_build/default/demo/client/meta.json /app/demo/client/meta.json
COPY --from=bundle /yuka/_build/default/demo/client/out/demo/client/bundle /app/demo/client/out/demo/client/bundle
COPY demo/static/style.css demo/static/markdown.css demo/static/favicon.svg demo/static/davesnx.jpg /app/demo/static/
COPY --from=build /home/opam/yuka/_build/default/lux/server/lux_server.exe /app/lux/server/lux_server.exe
COPY --from=build /home/opam/yuka/_build/default/lux/client/yuka_islands.json /app/lux/client/yuka_islands.json
COPY --from=bundle /yuka/_build/default/lux/client/meta.json /app/lux/client/meta.json
COPY --from=bundle /yuka/_build/default/lux/client/out/lux/client/bundle /app/lux/client/out/lux/client/bundle
COPY lux/static/style.css /app/lux/static/
COPY vercel/nginx.conf /app/nginx.conf
COPY vercel/start.sh /app/start.sh
RUN /app/demo/server/demo_server.exe --bundle --base /demo/mini-linear --prerender /app/demo/prerendered
USER nobody
EXPOSE 8080
ENTRYPOINT ["/app/start.sh"]
