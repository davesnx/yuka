FROM ocaml/opam:debian-12-ocaml-5.5 AS build
WORKDIR /home/opam/yuka
COPY --chown=opam Makefile yuka.opam yuka-dream.opam yuka-live-pg.opam ./
RUN git config --global http.version HTTP/1.1 \
 && sudo apt-get update \
 && make -s pin-list | grep -E '^(dune|melange)\.' | while read -r name target; do \
      opam pin add "$name" "$target" --yes --no-action || exit 1; \
    done \
 && opam install . --deps-only --yes \
 && opam install --yes cmarkit ochre tm-grammars \
 && sudo rm -rf /var/lib/apt/lists/* \
 && opam clean --download-cache --repo-cache
COPY --chown=opam . .
RUN sudo chown opam . \
 && opam exec -- dune build --root . --profile=release \
      demo/mini-linear/server/demo_server.exe @demo/mini-linear/client/demo-client demo/mini-linear/client/yuka_islands.json \
      @demo/async-feed/client/async-feed-client demo/async-feed/client/yuka_islands.json

FROM node:22-bookworm-slim AS bundle
WORKDIR /yuka
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY scripts scripts
COPY demo/mini-linear/bundle.sh demo/mini-linear/bundle.sh
COPY demo/async-feed/bundle.sh demo/async-feed/bundle.sh
COPY --from=build /home/opam/yuka/_build/default/demo/mini-linear/client _build/default/demo/mini-linear/client
COPY --from=build /home/opam/yuka/_build/default/demo/async-feed/client _build/default/demo/async-feed/client
RUN demo/mini-linear/bundle.sh && demo/async-feed/bundle.sh

FROM debian:12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends libev4 libpq5 libssl3 libonig5 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /home/opam/yuka/_build/default/demo/mini-linear/server/demo_server.exe /app/server/demo_server.exe
COPY --from=build /home/opam/yuka/_build/default/demo/mini-linear/client/yuka_islands.json /app/client/yuka_islands.json
COPY --from=bundle /yuka/_build/default/demo/mini-linear/client/meta.json /app/client/meta.json
COPY --from=bundle /yuka/_build/default/demo/mini-linear/client/out/demo/mini-linear/client/bundle /app/client/out/demo/mini-linear/client/bundle
COPY demo/mini-linear/static/style.css demo/mini-linear/static/markdown.css demo/mini-linear/static/favicon.svg demo/mini-linear/static/davesnx.jpg /app/static/
COPY --from=build /home/opam/yuka/_build/default/demo/async-feed/client/yuka_islands.json /app/async-feed/client/yuka_islands.json
COPY --from=bundle /yuka/_build/default/demo/async-feed/client/meta.json /app/async-feed/client/meta.json
COPY --from=bundle /yuka/_build/default/demo/async-feed/client/out/demo/async-feed/client/bundle /app/async-feed/client/out/demo/async-feed/client/bundle
COPY demo/async-feed/static/style.css demo/async-feed/static/favicon.svg /app/async-feed/static/
RUN /app/server/demo_server.exe --bundle --base /mini-linear --async-feed /app/async-feed --prerender /app/prerendered
USER nobody
EXPOSE 8080
ENTRYPOINT ["/app/server/demo_server.exe", "--bundle", "--base", "/mini-linear", "--async-feed", "/app/async-feed", "--interface", "0.0.0.0", "--prerendered", "/app/prerendered"]
