(rule
 (targets scope.actual)
 (deps
  body_get.ml
  unit_scope.ml
  (glob_files ../../src/.yuka.objs/byte/*.cmi))
 (action
  (with-outputs-to
   scope.actual
   (progn
    (with-accepted-exit-codes
     2
     (run %{ocamlc} -c -I ../../src/.yuka.objs/byte body_get.ml))
    (with-accepted-exit-codes
     2
     (run %{ocamlc} -c -I ../../src/.yuka.objs/byte unit_scope.ml))))))

(rule
 (alias runtest)
 (package yuka)
 (action
  (diff scope.expected scope.actual)))
