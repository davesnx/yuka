let count : int Yuka.State.t = Yuka.State.make 0

let fixed : Yuka.client Yuka.element =
  <ul class_="list">
    <li>"one"</li>
    <li on_click=(fun _ -> Yuka.State.update count succ)>(Yuka.text (string_of_int (Yuka.State.get count)))</li>
  </ul>

let by_hand : Yuka.client Yuka.element =
  Yuka.element "ul" [ Yuka.attr "class" "list" ]
    [ Yuka.element "li" [] [ Yuka.text "one" ];
      Yuka.element "li" [ Yuka.on "click" (fun _ -> Yuka.State.update count succ) ]
        [ Yuka.hole (fun () -> Yuka.text (string_of_int (Yuka.State.get count))) ] ]

let static_tree : Yuka.server Yuka.element =
  <section id="s"><h1>"Title"</h1><p>"body"</p></section>

let static_by_hand : Yuka.server Yuka.element =
  Yuka.element "section" [ Yuka.attr "id" "s" ]
    [ Yuka.element "h1" [] [ Yuka.text "Title" ]; Yuka.element "p" [] [ Yuka.text "body" ] ]

let not_fixed (label : string) : Yuka.server Yuka.element =
  <ul><li>"a"</li><li>(Yuka.text label)</li></ul>
