(executable
 (name pp)
 (modules pp)
 (libraries yuka.ppx ppxlib))

(rule
 (targets rewrite.pp.ml)
 (deps rewrite.mlx)
 (action
  (with-stdout-to
   rewrite.pp.ml
   (run mlx-pp rewrite.mlx))))

(rule
 (targets rewrite.actual)
 (deps rewrite.pp.ml)
 (action
  (with-stdout-to
   rewrite.actual
   (run ./pp.exe --impl rewrite.pp.ml))))

(rule
 (alias runtest)
 (action
  (diff rewrite.expected rewrite.actual)))

(cram
 (deps pp.exe %{bin:mlx-pp}))
