    type pair = (int tree * Other.t Other.foo)[@@deriving codec]
    include
      struct
        let _ = fun (_ : pair) -> ()
        let pair_codec : pair Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (fun (_yuka_x0, _yuka_x1) ->
                 `List
                   [Yuka.Codec.encode (tree_codec Yuka.Codec.int) _yuka_x0;
                   Yuka.Codec.encode (Other.foo_codec Other.codec) _yuka_x1]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `List (_yuka_j0::_yuka_j1::[]) ->
                     (match Yuka.Codec.decode (tree_codec Yuka.Codec.int)
                              _yuka_j0
                      with
                      | Stdlib.Ok _yuka_v0 ->
                          (match Yuka.Codec.decode
                                   (Other.foo_codec Other.codec) _yuka_j1
                           with
                           | Stdlib.Ok _yuka_v1 ->
                               Stdlib.Ok (_yuka_v0, _yuka_v1)
                           | Stdlib.Error e -> Stdlib.Error e)
                      | Stdlib.Error e -> Stdlib.Error e)
                 | _ -> Stdlib.Error "expected a list of 2 items")
          }
        let _ = pair_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type ('a, 'b) either =
      | Left of 'a 
      | Right of 'b [@@deriving codec]
    include
      struct
        let _ = fun (_ : ('a, 'b) either) -> ()
        let either_codec :
          'a 'b .
            'a Yuka.Codec.t ->
              'b Yuka.Codec.t -> ('a, 'b) either Yuka.Codec.t
          =
          fun _yuka_p_a _yuka_p_b ->
            {
              Yuka.Codec.encode =
                ((function
                  | Left _yuka_x0 ->
                      `List
                        [`String "Left";
                        Yuka.Codec.encode _yuka_p_a _yuka_x0]
                  | Right _yuka_x0 ->
                      `List
                        [`String "Right";
                        Yuka.Codec.encode _yuka_p_b _yuka_x0]));
              decode =
                (fun (j : Yuka.Json.t) ->
                   match j with
                   | `List ((`String "Left")::_yuka_j0::[]) ->
                       (match Yuka.Codec.decode _yuka_p_a _yuka_j0 with
                        | Stdlib.Ok _yuka_v0 -> Stdlib.Ok (Left _yuka_v0)
                        | Stdlib.Error e -> Stdlib.Error e)
                   | `List ((`String "Right")::_yuka_j0::[]) ->
                       (match Yuka.Codec.decode _yuka_p_b _yuka_j0 with
                        | Stdlib.Ok _yuka_v0 -> Stdlib.Ok (Right _yuka_v0)
                        | Stdlib.Error e -> Stdlib.Error e)
                   | _ -> Stdlib.Error "invalid either")
