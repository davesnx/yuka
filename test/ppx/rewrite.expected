  {
  name: string ;
  age: int ;
  plan: Plan.t ;
  news: bool ;
  tags: string list }[@@deriving form]
include
  struct
    let _ = fun (_ : signup) -> ()
    type signup_field = [ `Name  | `Age  | `Plan  | `News  | `Tags ]
    let signup_field_name =
      function
      | `Name -> "name"
      | `Age -> "age"
      | `Plan -> "plan"
      | `News -> "news"
      | `Tags -> "tags"
    let _ = signup_field_name
    let signup_form : (signup, signup_field) Yuka.Form.t =
      Yuka.runtime_form_fields
        ~names:[(`Name, "name");
               (`Age, "age");
               (`Plan, "plan");
               (`News, "news");
               (`Tags, "tags")]
        ~decode:(fun _yuka_d ->
                   let _yuka_f0 =
                     Yuka.runtime_form_field _yuka_d `Name "name"
                       Yuka.Form.string in
                   let _yuka_f1 =
                     Yuka.runtime_form_field _yuka_d `Age "age" Yuka.Form.int in
                   let _yuka_f2 =
                     Yuka.runtime_form_field _yuka_d `Plan "plan"
                       (Yuka.Form.custom Plan.of_string Plan.to_string) in
                   let _yuka_f3 =
                     Yuka.runtime_form_field _yuka_d `News "news"
                       Yuka.Form.bool in
                   let _yuka_f4 =
                     Yuka.runtime_form_field _yuka_d `Tags "tags"
                       (Yuka.Form.list Yuka.Form.string) in
                   Yuka.runtime_form_finish _yuka_d
                     (fun () ->
                        {
                          name = (Yuka.runtime_form_get _yuka_f0);
                          age = (Yuka.runtime_form_get _yuka_f1);
                          plan = (Yuka.runtime_form_get _yuka_f2);
                          news = (Yuka.runtime_form_get _yuka_f3);
                          tags = (Yuka.runtime_form_get _yuka_f4)
                        }))
        ~encode:(fun (_yuka_v : signup) ->
                   Stdlib.List.concat
                     [Yuka.runtime_form_put "name" Yuka.Form.string
                        _yuka_v.name;
                     Yuka.runtime_form_put "age" Yuka.Form.int _yuka_v.age;
                     Yuka.runtime_form_put "plan"
                       (Yuka.Form.custom Plan.of_string Plan.to_string)
                       _yuka_v.plan;
                     Yuka.runtime_form_put "news" Yuka.Form.bool _yuka_v.news;
                     Yuka.runtime_form_put "tags"
                       (Yuka.Form.list Yuka.Form.string) _yuka_v.tags])
    let _ = signup_form
  end[@@ocaml.doc "@inline"][@@merlin.hide ]
