let static_attrs =
  Yuka.lower "a"
    [Yuka.attr "class" ("nav" : string);
    Yuka.attr "href" ("/x" : string);
    Yuka.attr "tabindex" (Stdlib.string_of_int (3 : int))] [Yuka.text "home"]
let bool_and_optional =
  Yuka.lower "input"
    (Stdlib.List.filter_map (fun x -> x)
       [Some
          (Yuka.attr "type"
             (match (`text : [ `button  | `checkbox  | `color  | `date 
                             | `datetime_local  | `email  | `file  | 
                               `hidden 
                             | `image  | `month  | `number  | `password 
                             | `radio  | `range  | `reset  | `search 
                             | `submit  | `tel  | `text  | `time  | `url 
                             | `week ])
              with
              | `button -> "button"
              | `checkbox -> "checkbox"
              | `color -> "color"
              | `date -> "date"
              | `datetime_local -> "datetime-local"
              | `email -> "email"
              | `file -> "file"
              | `hidden -> "hidden"
              | `image -> "image"
              | `month -> "month"
              | `number -> "number"
              | `password -> "password"
              | `radio -> "radio"
              | `range -> "range"
              | `reset -> "reset"
              | `search -> "search"
              | `submit -> "submit"
              | `tel -> "tel"
              | `text -> "text"
              | `time -> "time"
              | `url -> "url"
              | `week -> "week"));
       Stdlib.Option.map (Yuka.attr "disabled")
         (if (true : bool) then Some "" else None);
       Stdlib.Option.map (Yuka.attr "hidden")
         (if (flag : bool) then Some "" else None);
       Stdlib.Option.map (Yuka.attr "placeholder")
         (Stdlib.Option.map (fun v -> (v : string))
            (placeholder : string option));
       Stdlib.Option.map (Yuka.attr "autofocus")
         (match (autofocus : bool option) with
          | Some true -> Some ""
          | _ -> None)]) []
