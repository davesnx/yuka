          {
            Yuka.Codec.encode =
              (function
               | Num _yuka_x0 ->
                   `List
                     [`String "Num";
                     Yuka.Codec.encode Yuka.Codec.int _yuka_x0]
               | Block _yuka_x0 ->
                   `List
                     [`String "Block";
                     Yuka.Codec.encode stmts_codec _yuka_x0]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `List ((`String "Num")::_yuka_j0::[]) ->
                     (match Yuka.Codec.decode Yuka.Codec.int _yuka_j0 with
                      | Stdlib.Ok _yuka_v0 -> Stdlib.Ok (Num _yuka_v0)
                      | Stdlib.Error e -> Stdlib.Error e)
                 | `List ((`String "Block")::_yuka_j0::[]) ->
                     (match Yuka.Codec.decode stmts_codec _yuka_j0 with
                      | Stdlib.Ok _yuka_v0 -> Stdlib.Ok (Block _yuka_v0)
                      | Stdlib.Error e -> Stdlib.Error e)
                 | _ -> Stdlib.Error "invalid expr")
          }
        and stmts_codec : stmts Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (fun x -> Yuka.Codec.encode (Yuka.Codec.list stmt_codec) x);
            decode =
              (fun j -> Yuka.Codec.decode (Yuka.Codec.list stmt_codec) j)
          }
        and stmt_codec : stmt Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (function
               | Do _yuka_x0 ->
                   `List
                     [`String "Do"; Yuka.Codec.encode expr_codec _yuka_x0]
               | Let _yuka_r ->
                   `List
                     [`String "Let";
                     `Assoc
                       [("name",
                          (Yuka.Codec.encode Yuka.Codec.string _yuka_r.name));
                       ("value",
                         (Yuka.Codec.encode expr_codec _yuka_r.value))]]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `List ((`String "Do")::_yuka_j0::[]) ->
                     (match Yuka.Codec.decode expr_codec _yuka_j0 with
                      | Stdlib.Ok _yuka_v0 -> Stdlib.Ok (Do _yuka_v0)
                      | Stdlib.Error e -> Stdlib.Error e)
                 | `List ((`String "Let")::(`Assoc _yuka_fields)::[]) ->
                     (match Stdlib.List.assoc_opt "name" _yuka_fields with
                      | Some _yuka_j0 ->
                          (match Yuka.Codec.decode Yuka.Codec.string _yuka_j0
                           with
                           | Stdlib.Ok _yuka_v0 ->
                               (match Stdlib.List.assoc_opt "value"
                                        _yuka_fields
                                with
                                | Some _yuka_j1 ->
                                    (match Yuka.Codec.decode expr_codec
                                             _yuka_j1
                                     with
                                     | Stdlib.Ok _yuka_v1 ->
                                         Stdlib.Ok
                                           (Let
                                              {
                                                name = _yuka_v0;
                                                value = _yuka_v1
                                              })
                                     | Stdlib.Error e ->
                                         Stdlib.Error ("value" ^ (": " ^ e)))
                                | None -> Stdlib.Error "missing field value")
                           | Stdlib.Error e ->
                               Stdlib.Error ("name" ^ (": " ^ e)))
                      | None -> Stdlib.Error "missing field name")
