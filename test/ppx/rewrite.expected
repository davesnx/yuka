module Awaiting =
  struct
    let basic =
      Yuka.Await.make ~async:comments
        ~loading:(Yuka.lower "p" [] [Yuka.text "loading"])
        ~children:(fun items ->
                     Yuka.template "rewrite:138:82"
                       (Yuka.lower "ul" []
                          [Yuka.lower "li" [] [Yuka.text "x"];
                          Yuka.lower "li" []
                            [Yuka.hole (fun () -> State.get n)]])) ()
    let with_failed =
      Yuka.Await.make ~async:comments ~loading:(Yuka.text "wait")
        ~failed:(fun msg -> Yuka.lower "p" [] [Yuka.text msg])
        ~children:(function
                   | Some v -> Yuka.lower "b" [] [Yuka.text v]
                   | None -> Yuka.empty) ()
    let optional_failed =
      Yuka.Await.make ~async:comments ~loading:(Yuka.text "wait") ?failed
        ~children:(fun v -> Yuka.lower "b" [] [Yuka.text "x"]) ()
    let inside_element =
      Yuka.lower "div" [Yuka.attr "class" ("c" : string)]
        [Yuka.Await.make ~async:comments ~loading:(Yuka.text "wait")
           ~children:(fun v ->
                        Yuka.lower "i" [] [Yuka.hole (fun () -> State.get n)])
           ()]
  end
