module Sigs :
  sig
    type 'a tree =
      | Leaf 
      | Node of 'a tree * 'a * 'a tree [@@deriving codec]
    include
      sig
        [@@@ocaml.warning "-32"]
        val tree_codec : 'a Yuka.Codec.t -> 'a tree Yuka.Codec.t
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
  end =
  struct
    type 'a tree =
      | Leaf 
      | Node of 'a tree * 'a * 'a tree [@@deriving codec]
    include
      struct
        let _ = fun (_ : 'a tree) -> ()
        let rec tree_codec : 'a . 'a Yuka.Codec.t -> 'a tree Yuka.Codec.t =
          fun _yuka_p_a ->
            {
              Yuka.Codec.encode =
                ((function
                  | Leaf -> `String "Leaf"
                  | Node (_yuka_x0, _yuka_x1, _yuka_x2) ->
                      `List
                        [`String "Node";
                        Yuka.Codec.encode (tree_codec _yuka_p_a) _yuka_x0;
                        Yuka.Codec.encode _yuka_p_a _yuka_x1;
                        Yuka.Codec.encode (tree_codec _yuka_p_a) _yuka_x2]));
              decode =
                (fun (j : Yuka.Json.t) ->
                   match j with
                   | `String "Leaf" -> Stdlib.Ok Leaf
                   | `List
                       ((`String "Node")::_yuka_j0::_yuka_j1::_yuka_j2::[])
                       ->
                       (match Yuka.Codec.decode (tree_codec _yuka_p_a)
                                _yuka_j0
                        with
                        | Stdlib.Ok _yuka_v0 ->
                            (match Yuka.Codec.decode _yuka_p_a _yuka_j1 with
                             | Stdlib.Ok _yuka_v1 ->
                                 (match Yuka.Codec.decode
                                          (tree_codec _yuka_p_a) _yuka_j2
                                  with
                                  | Stdlib.Ok _yuka_v2 ->
                                      Stdlib.Ok
                                        (Node (_yuka_v0, _yuka_v1, _yuka_v2))
                                  | Stdlib.Error e -> Stdlib.Error e)
                             | Stdlib.Error e -> Stdlib.Error e)
                        | Stdlib.Error e -> Stdlib.Error e)
                   | _ -> Stdlib.Error "invalid tree")
            }
        let _ = tree_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
  end 
let shared = State.make 0[@@yuka.shared ]
let in_function () = State.make 0
include
  struct
    let make ~label:(label : string) ~children:(children : Yuka.slot) () =
      Yuka.lower "div" [] [Yuka.slot children]
    let name = "Rewrite"
    let island ~label ~children ?loading () =
      (Yuka.Client.island ?loading ~name:"Rewrite"
         ~props:(`Assoc
                   [("label", (Yuka.Codec.encode Yuka.Codec.string label));
                   ("children", (Yuka.Codec.encode Yuka.Codec.slot children))])
         (fun () -> make ~label ~children ()) : Yuka.server Yuka.element)
    let register =
      Yuka.Client.entry ~name:"Rewrite"
        (fun (j : Yuka.Json.t) ->
           match j with
           | `Assoc _yuka_fields ->
               (match Stdlib.List.assoc_opt "label" _yuka_fields with
                | Some _yuka_j0 ->
                    (match Yuka.Codec.decode Yuka.Codec.string _yuka_j0 with
                     | Stdlib.Ok _yuka_v0 ->
                         (match Stdlib.List.assoc_opt "children" _yuka_fields
                          with
                          | Some _yuka_j1 ->
                              (match Yuka.Codec.decode Yuka.Codec.slot
                                       _yuka_j1
                               with
                               | Stdlib.Ok _yuka_v1 ->
                                   let label = _yuka_v0 in
                                   let children = _yuka_v1 in
                                   Stdlib.Ok
                                     ((fun () -> make ~label ~children ()))
                               | Stdlib.Error e ->
                                   Stdlib.Error ("children" ^ (": " ^ e)))
                          | None -> Stdlib.Error "missing field children")
                     | Stdlib.Error e -> Stdlib.Error ("label" ^ (": " ^ e)))
                | None -> Stdlib.Error "missing field label")
           | _ -> Stdlib.Error "expected an object")
  end
module Slotted = struct  end
