module Derived =
  struct
    type status =
      | Open 
      | Closed [@@deriving codec]
    include
      struct
        let _ = fun (_ : status) -> ()
        let status_codec : status Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (function | Open -> `String "Open" | Closed -> `String "Closed");
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `String "Open" -> Stdlib.Ok Open
                 | `String "Closed" -> Stdlib.Ok Closed
                 | _ -> Stdlib.Error "invalid status")
          }
        let _ = status_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type issue =
      {
      id: int ;
      title: string ;
      note: string option ;
      tags: string list }[@@deriving codec]
    include
      struct
        let _ = fun (_ : issue) -> ()
        let issue_codec : issue Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (fun (_yuka_x : issue) ->
                 `Assoc
                   [("id", (Yuka.Codec.encode Yuka.Codec.int _yuka_x.id));
                   ("title",
                     (Yuka.Codec.encode Yuka.Codec.string _yuka_x.title));
                   ("note",
                     (Yuka.Codec.encode (Yuka.Codec.option Yuka.Codec.string)
                        _yuka_x.note));
                   ("tags",
                     (Yuka.Codec.encode (Yuka.Codec.list Yuka.Codec.string)
                        _yuka_x.tags))]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `Assoc _yuka_fields ->
                     (match Stdlib.List.assoc_opt "id" _yuka_fields with
                      | Some _yuka_j0 ->
                          (match Yuka.Codec.decode Yuka.Codec.int _yuka_j0
                           with
                           | Stdlib.Ok _yuka_v0 ->
                               (match Stdlib.List.assoc_opt "title"
                                        _yuka_fields
                                with
                                | Some _yuka_j1 ->
                                    (match Yuka.Codec.decode
                                             Yuka.Codec.string _yuka_j1
                                     with
                                     | Stdlib.Ok _yuka_v1 ->
                                         let _yuka_j2 =
                                           match Stdlib.List.assoc_opt "note"
                                                   _yuka_fields
                                           with
                                           | Some j -> j
                                           | None -> `Null in
                                         (match Yuka.Codec.decode
                                                  (Yuka.Codec.option
                                                     Yuka.Codec.string)
                                                  _yuka_j2
                                          with
                                          | Stdlib.Ok _yuka_v2 ->
                                              (match Stdlib.List.assoc_opt
                                                       "tags" _yuka_fields
                                               with
                                               | Some _yuka_j3 ->
                                                   (match Yuka.Codec.decode
                                                            (Yuka.Codec.list
                                                               Yuka.Codec.string)
                                                            _yuka_j3
                                                    with
                                                    | Stdlib.Ok _yuka_v3 ->
                                                        Stdlib.Ok
                                                          {
                                                            id = _yuka_v0;
                                                            title = _yuka_v1;
                                                            note = _yuka_v2;
                                                            tags = _yuka_v3
                                                          }
                                                    | Stdlib.Error e ->
                                                        Stdlib.Error
                                                          ("tags" ^
                                                             (": " ^ e)))
                                               | None ->
                                                   Stdlib.Error
                                                     "missing field tags")
                                          | Stdlib.Error e ->
                                              Stdlib.Error
                                                ("note" ^ (": " ^ e)))
                                     | Stdlib.Error e ->
                                         Stdlib.Error ("title" ^ (": " ^ e)))
                                | None -> Stdlib.Error "missing field title")
                           | Stdlib.Error e ->
                               Stdlib.Error ("id" ^ (": " ^ e)))
                      | None -> Stdlib.Error "missing field id")
                 | _ -> Stdlib.Error "expected an object for issue")
          }
        let _ = issue_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type shape =
      | Dot 
      | Pair of int * string 
      | Box of {
      w: int ;
      h: int } [@@deriving codec]
    include
      struct
        let _ = fun (_ : shape) -> ()
        let shape_codec : shape Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (function
               | Dot -> `String "Dot"
               | Pair (_yuka_x0, _yuka_x1) ->
                   `List
                     [`String "Pair";
                     Yuka.Codec.encode Yuka.Codec.int _yuka_x0;
                     Yuka.Codec.encode Yuka.Codec.string _yuka_x1]
               | Box _yuka_r ->
                   `List
                     [`String "Box";
                     `Assoc
                       [("w", (Yuka.Codec.encode Yuka.Codec.int _yuka_r.w));
                       ("h", (Yuka.Codec.encode Yuka.Codec.int _yuka_r.h))]]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `String "Dot" -> Stdlib.Ok Dot
                 | `List ((`String "Pair")::_yuka_j0::_yuka_j1::[]) ->
                     (match Yuka.Codec.decode Yuka.Codec.int _yuka_j0 with
                      | Stdlib.Ok _yuka_v0 ->
                          (match Yuka.Codec.decode Yuka.Codec.string _yuka_j1
                           with
                           | Stdlib.Ok _yuka_v1 ->
                               Stdlib.Ok (Pair (_yuka_v0, _yuka_v1))
                           | Stdlib.Error e -> Stdlib.Error e)
                      | Stdlib.Error e -> Stdlib.Error e)
                 | `List ((`String "Box")::(`Assoc _yuka_fields)::[]) ->
                     (match Stdlib.List.assoc_opt "w" _yuka_fields with
                      | Some _yuka_j0 ->
                          (match Yuka.Codec.decode Yuka.Codec.int _yuka_j0
                           with
                           | Stdlib.Ok _yuka_v0 ->
                               (match Stdlib.List.assoc_opt "h" _yuka_fields
                                with
                                | Some _yuka_j1 ->
                                    (match Yuka.Codec.decode Yuka.Codec.int
                                             _yuka_j1
                                     with
                                     | Stdlib.Ok _yuka_v1 ->
                                         Stdlib.Ok
                                           (Box
                                              { w = _yuka_v0; h = _yuka_v1 })
                                     | Stdlib.Error e ->
                                         Stdlib.Error ("h" ^ (": " ^ e)))
                                | None -> Stdlib.Error "missing field h")
                           | Stdlib.Error e ->
                               Stdlib.Error ("w" ^ (": " ^ e)))
                      | None -> Stdlib.Error "missing field w")
                 | _ -> Stdlib.Error "invalid shape")
          }
        let _ = shape_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type point = (int * float)[@@deriving codec]
    include
      struct
        let _ = fun (_ : point) -> ()
        let point_codec : point Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (fun (_yuka_x0, _yuka_x1) ->
                 `List
                   [Yuka.Codec.encode Yuka.Codec.int _yuka_x0;
                   Yuka.Codec.encode Yuka.Codec.float _yuka_x1]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `List (_yuka_j0::_yuka_j1::[]) ->
                     (match Yuka.Codec.decode Yuka.Codec.int _yuka_j0 with
                      | Stdlib.Ok _yuka_v0 ->
                          (match Yuka.Codec.decode Yuka.Codec.float _yuka_j1
                           with
                           | Stdlib.Ok _yuka_v1 ->
                               Stdlib.Ok (_yuka_v0, _yuka_v1)
                           | Stdlib.Error e -> Stdlib.Error e)
                      | Stdlib.Error e -> Stdlib.Error e)
                 | _ -> Stdlib.Error "expected a list of 2 items")
          }
        let _ = point_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type alias = Other.t[@@deriving codec]
    include
      struct
        let _ = fun (_ : alias) -> ()
        let alias_codec : alias Yuka.Codec.t = Other.codec
        let _ = alias_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type later = Other.foo list[@@deriving codec]
    include
      struct
        let _ = fun (_ : later) -> ()
        let later_codec : later Yuka.Codec.t =
          Yuka.Codec.list Other.foo_codec
        let _ = later_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type refers = {
      s: status ;
      p: point }[@@deriving codec]
    include
      struct
        let _ = fun (_ : refers) -> ()
        let refers_codec : refers Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (fun (_yuka_x : refers) ->
                 `Assoc
                   [("s", (Yuka.Codec.encode status_codec _yuka_x.s));
                   ("p", (Yuka.Codec.encode point_codec _yuka_x.p))]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `Assoc _yuka_fields ->
                     (match Stdlib.List.assoc_opt "s" _yuka_fields with
                      | Some _yuka_j0 ->
                          (match Yuka.Codec.decode status_codec _yuka_j0 with
                           | Stdlib.Ok _yuka_v0 ->
                               (match Stdlib.List.assoc_opt "p" _yuka_fields
                                with
                                | Some _yuka_j1 ->
                                    (match Yuka.Codec.decode point_codec
                                             _yuka_j1
                                     with
                                     | Stdlib.Ok _yuka_v1 ->
                                         Stdlib.Ok
                                           { s = _yuka_v0; p = _yuka_v1 }
                                     | Stdlib.Error e ->
                                         Stdlib.Error ("p" ^ (": " ^ e)))
                                | None -> Stdlib.Error "missing field p")
                           | Stdlib.Error e ->
                               Stdlib.Error ("s" ^ (": " ^ e)))
                      | None -> Stdlib.Error "missing field s")
                 | _ -> Stdlib.Error "expected an object for refers")
          }
        let _ = refers_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
  end
include
  struct
    let make ~a:(a : int) ?b:(b : string option) ?c:((c : int)= 1) () =
      Yuka.lower "p" [] [Yuka.text "hi"]
    let name = "Rewrite"
    let island ~a ?b ?c ?loading () =
      (Yuka.Client.island ?loading ~name:"Rewrite"
         ~props:(`Assoc
                   [("a", (Yuka.Codec.encode Yuka.Codec.int a));
                   ("b",
                     (Yuka.Codec.encode (Yuka.Codec.option Yuka.Codec.string)
                        b));
                   ("c",
                     (Yuka.Codec.encode (Yuka.Codec.option Yuka.Codec.int) c))])
         (fun () -> make ~a ?b ?c ()) : Yuka.server Yuka.element)
    let register =
      Yuka.Client.entry ~name:"Rewrite"
        (fun (j : Yuka.Json.t) ->
           match j with
           | `Assoc _yuka_fields ->
               (match Stdlib.List.assoc_opt "a" _yuka_fields with
                | Some _yuka_j0 ->
                    (match Yuka.Codec.decode Yuka.Codec.int _yuka_j0 with
                     | Stdlib.Ok _yuka_v0 ->
                         let _yuka_j1 =
                           match Stdlib.List.assoc_opt "b" _yuka_fields with
                           | Some j -> j
                           | None -> `Null in
                         (match Yuka.Codec.decode
                                  (Yuka.Codec.option Yuka.Codec.string)
                                  _yuka_j1
                          with
                          | Stdlib.Ok _yuka_v1 ->
                              let _yuka_j2 =
                                match Stdlib.List.assoc_opt "c" _yuka_fields
                                with
                                | Some j -> j
                                | None -> `Null in
                              (match Yuka.Codec.decode
                                       (Yuka.Codec.option Yuka.Codec.int)
                                       _yuka_j2
                               with
                               | Stdlib.Ok _yuka_v2 ->
                                   let a = _yuka_v0 in
                                   let b = _yuka_v1 in
                                   let c = _yuka_v2 in
                                   Stdlib.Ok ((fun () -> make ~a ?b ?c ()))
                               | Stdlib.Error e ->
                                   Stdlib.Error ("c" ^ (": " ^ e)))
                          | Stdlib.Error e -> Stdlib.Error ("b" ^ (": " ^ e)))
                     | Stdlib.Error e -> Stdlib.Error ("a" ^ (": " ^ e)))
                | None -> Stdlib.Error "missing field a")
           | _ -> Stdlib.Error "expected an object")
  end
