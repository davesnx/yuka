module Recursive =
  struct
    type 'a tree =
      | Leaf 
      | Node of 'a tree * 'a * 'a tree [@@deriving codec]
    include
      struct
        let _ = fun (_ : 'a tree) -> ()
        let rec tree_codec : 'a . 'a Yuka.Codec.t -> 'a tree Yuka.Codec.t =
          fun _yuka_p_a ->
            {
              Yuka.Codec.encode =
                ((function
                  | Leaf -> `String "Leaf"
                  | Node (_yuka_x0, _yuka_x1, _yuka_x2) ->
                      `List
                        [`String "Node";
                        Yuka.Codec.encode (tree_codec _yuka_p_a) _yuka_x0;
                        Yuka.Codec.encode _yuka_p_a _yuka_x1;
                        Yuka.Codec.encode (tree_codec _yuka_p_a) _yuka_x2]));
              decode =
                (fun (j : Yuka.Json.t) ->
                   match j with
                   | `String "Leaf" -> Stdlib.Ok Leaf
                   | `List
                       ((`String "Node")::_yuka_j0::_yuka_j1::_yuka_j2::[])
                       ->
                       (match Yuka.Codec.decode (tree_codec _yuka_p_a)
                                _yuka_j0
                        with
                        | Stdlib.Ok _yuka_v0 ->
                            (match Yuka.Codec.decode _yuka_p_a _yuka_j1 with
                             | Stdlib.Ok _yuka_v1 ->
                                 (match Yuka.Codec.decode
                                          (tree_codec _yuka_p_a) _yuka_j2
                                  with
                                  | Stdlib.Ok _yuka_v2 ->
                                      Stdlib.Ok
                                        (Node (_yuka_v0, _yuka_v1, _yuka_v2))
                                  | Stdlib.Error e -> Stdlib.Error e)
                             | Stdlib.Error e -> Stdlib.Error e)
                        | Stdlib.Error e -> Stdlib.Error e)
                   | _ -> Stdlib.Error "invalid tree")
            }
        let _ = tree_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type rose = {
      label: string ;
      kids: rose list }[@@deriving codec]
    include
      struct
        let _ = fun (_ : rose) -> ()
        let rec rose_codec : rose Yuka.Codec.t =
          {
            Yuka.Codec.encode =
              (fun (_yuka_x : rose) ->
                 `Assoc
                   [("label",
                      (Yuka.Codec.encode Yuka.Codec.string _yuka_x.label));
                   ("kids",
                     (Yuka.Codec.encode (Yuka.Codec.list rose_codec)
                        _yuka_x.kids))]);
            decode =
              (fun (j : Yuka.Json.t) ->
                 match j with
                 | `Assoc _yuka_fields ->
                     (match Stdlib.List.assoc_opt "label" _yuka_fields with
                      | Some _yuka_j0 ->
                          (match Yuka.Codec.decode Yuka.Codec.string _yuka_j0
                           with
                           | Stdlib.Ok _yuka_v0 ->
                               (match Stdlib.List.assoc_opt "kids"
                                        _yuka_fields
                                with
                                | Some _yuka_j1 ->
                                    (match Yuka.Codec.decode
                                             (Yuka.Codec.list rose_codec)
                                             _yuka_j1
                                     with
                                     | Stdlib.Ok _yuka_v1 ->
                                         Stdlib.Ok
                                           {
                                             label = _yuka_v0;
                                             kids = _yuka_v1
                                           }
                                     | Stdlib.Error e ->
                                         Stdlib.Error ("kids" ^ (": " ^ e)))
                                | None -> Stdlib.Error "missing field kids")
                           | Stdlib.Error e ->
                               Stdlib.Error ("label" ^ (": " ^ e)))
                      | None -> Stdlib.Error "missing field label")
                 | _ -> Stdlib.Error "expected an object for rose")
          }
        let _ = rose_codec
      end[@@ocaml.doc "@inline"][@@merlin.hide ]
    type expr =
      | Num of int 
      | Block of stmts 
    and stmts = stmt list
    and stmt =
      | Do of expr 
      | Let of {
      name: string ;
      value: expr } [@@deriving codec]
    include
      struct
        let _ = fun (_ : expr) -> ()
        let _ = fun (_ : stmts) -> ()
        let _ = fun (_ : stmt) -> ()
