open Fixture_server

let routes =
  <Router layout=Layouts.root not_found=Pages.not_found error=Pages.error
    headers=[ ("x-frame-options", "DENY") ] cache=No_store>
    <Route name=Home path="/" page=Pages.home prerender=true />
    <Group path="/blog" layout=Layouts.blog search={ lang = optional string }>
      <Route name=Blog path="/" page=Pages.blog
        search={
          tag = optional string;
          page = default int 1;
          label = many string;
          draft = default bool false
        } />
      <Route name=Post path="/:slug<string>" page=Pages.post loader=Loaders.post />
      <Route name=New_post path="/new" page=Pages.new_post />
    </Group>
    <Group path="/issue/:id<Params.Issue_id>" loader=Loaders.issue
      guard=Guards.signed_in>
      <Route name=Issue path="/" page=Pages.issue
        search={
          tab = optional Params.Tab;
          seen = many int;
          view = default Params.Tab Params.Tab.Overview
        } />
      <Action name=Close_issue path="/close" method_=`POST handler=Actions.close />
      <Endpoint name=Issue_json path="/json" method_=`GET handler=Api.issue />
      <Action name=Update_issue path="/json" method_=`PUT handler=Actions.update />
    </Group>
    <Route name=Page_n path="/page/:n<int>" page=Pages.page />
    <Route name=Cafe path="/café" page=Pages.cafe />
    <Route name=Doc path="/docs/:parts<string...>" page=Pages.doc />
    <Endpoint name=Feed path="/feed.xml" method_=`GET handler=Feeds.rss
      cache=(Public { max_age = 60; s_max_age = None }) />
    <Action name=Clear_feed path="/feed.xml" method_=`DELETE handler=Actions.clear />
    <Route path="/i/:id<Params.Issue_id>" redirect=(Permanent "/issue/:id") />
    <Route path="/old-docs/:parts<string...>" redirect=(Temporary "/docs/:parts") />
    <Route path="/legacy-blog" redirect=(Temporary "/blog") />
  </Router>
