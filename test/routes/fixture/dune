(library
 (name routes_fixture)
 (modes native melange)
 (libraries yuka))

(rule
 (targets routes.ast)
 (deps ../Routes.mlx)
 (action
  (with-stdout-to
   routes.ast
   (run %{bin:mlx-pp} %{deps}))))

(rule
 (targets routes.ml)
 (action
  (with-stdout-to
   routes.ml
   (run %{bin:yuka-routes} --shared %{dep:routes.ast}))))

(rule
 (alias runtest)
 (action
  (diff routes.expected routes.ml)))
