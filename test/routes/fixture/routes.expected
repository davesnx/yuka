type t =
  | Home
  | Blog of { lang : string option; tag : string option; page : int; label : string list; draft : bool }
  | Post of { slug : string; lang : string option }
  | New_post of { lang : string option }
  | Issue of { id : Params.Issue_id.t; tab : Params.Tab.t option; seen : int list; view : Params.Tab.t }
  | Close_issue of { id : Params.Issue_id.t }
  | Issue_json of { id : Params.Issue_id.t }
  | Update_issue of { id : Params.Issue_id.t }
  | Page_n of { n : int }
  | Cafe
  | Doc of { parts : string list }
  | Feed
  | Clear_feed

let with_query path pairs =
  match pairs with
  | [] -> path
  | _ ->
      path ^ "?"
      ^ String.concat "&" (List.map (fun (k, v) -> k ^ "=" ^ v) pairs)

let href = function
  | Home -> "/"
  | Blog { lang; tag; page; label; draft } ->
      with_query "/blog"
        ((match lang with Some v -> [ ("lang", Yuka.Router.encode v) ] | None -> [])
        @ (match tag with Some v -> [ ("tag", Yuka.Router.encode v) ] | None -> [])
        @ (if page = (1) then [] else [ ("page", Stdlib.string_of_int page) ])
        @ List.map (fun v -> ("label", Yuka.Router.encode v)) label
        @ (if draft = (false) then [] else [ ("draft", Stdlib.string_of_bool draft) ]))
  | Post { slug; lang } ->
      with_query ("/blog/" ^ Yuka.Router.encode slug)
        ((match lang with Some v -> [ ("lang", Yuka.Router.encode v) ] | None -> []))
  | New_post { lang } ->
      with_query "/blog/new"
        ((match lang with Some v -> [ ("lang", Yuka.Router.encode v) ] | None -> []))
  | Issue { id; tab; seen; view } ->
      with_query ("/issue/" ^ Yuka.Router.encode (Params.Issue_id.to_string id))
        ((match tab with Some v -> [ ("tab", Yuka.Router.encode (Params.Tab.to_string v)) ] | None -> [])
        @ List.map (fun v -> ("seen", Stdlib.string_of_int v)) seen
        @ (if Params.Tab.to_string view = Params.Tab.to_string (Params.Tab.Overview) then [] else [ ("view", Yuka.Router.encode (Params.Tab.to_string view)) ]))
  | Close_issue { id } -> "/issue/" ^ Yuka.Router.encode (Params.Issue_id.to_string id) ^ "/close"
  | Issue_json { id } -> "/issue/" ^ Yuka.Router.encode (Params.Issue_id.to_string id) ^ "/json"
  | Update_issue { id } -> "/issue/" ^ Yuka.Router.encode (Params.Issue_id.to_string id) ^ "/json"
  | Page_n { n } -> "/page/" ^ Stdlib.string_of_int n
  | Cafe -> "/caf%C3%A9"
  | Doc { parts } -> "/docs" ^ String.concat "" (List.map (fun s -> "/" ^ Yuka.Router.encode s) parts)
  | Feed -> "/feed.xml"
  | Clear_feed -> "/feed.xml"

let find (meth : Yuka.Router.meth) (path : string list)
    (query : (string * string) list) : t Yuka.Router.lookup =
  match path with
  | [] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Home
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "blog" ] -> (
      match meth with
      | `GET | `HEAD -> (
          Yuka.Router.Found (Blog {
            lang = (match Yuka.Router.search query "lang" with v :: _ -> Some v | [] -> None);
            tag = (match Yuka.Router.search query "tag" with v :: _ -> Some v | [] -> None);
            page = (match Yuka.Router.search query "page" with v :: _ -> (match Yuka.Router.int_param v with Some v -> v | None -> (1)) | [] -> (1));
            label = Yuka.Router.search query "label";
            draft = (match Yuka.Router.search query "draft" with v :: _ -> (match (match v with "true" -> Some true | "false" -> Some false | _ -> None) with Some v -> v | None -> (false)) | [] -> (false));
          }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "caf\195\169" ] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Cafe
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "feed.xml" ] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Feed
      | `DELETE -> Yuka.Router.Found Clear_feed
      | _ -> Yuka.Router.Wrong_method [ `GET; `DELETE ])
  | [ "legacy-blog" ] -> Yuka.Router.Redirect { permanent = false; location = "/blog" }
  | [ "blog"; "new" ] -> (
      match meth with
      | `GET | `HEAD -> (
          Yuka.Router.Found (New_post {
            lang = (match Yuka.Router.search query "lang" with v :: _ -> Some v | [] -> None);
          }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "blog"; p1 ] -> (
      match meth with
      | `GET | `HEAD -> (
          Yuka.Router.Found (Post {
            slug = p1;
            lang = (match Yuka.Router.search query "lang" with v :: _ -> Some v | [] -> None);
          }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "issue"; p1 ] -> (
      match meth with
      | `GET | `HEAD -> (
          match Params.Issue_id.of_string p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> (
              Yuka.Router.Found (Issue {
                id = p1;
                tab = (match Yuka.Router.search query "tab" with v :: _ -> Params.Tab.of_string v | [] -> None);
                seen = List.filter_map (fun v -> Yuka.Router.int_param v) (Yuka.Router.search query "seen");
                view = (match Yuka.Router.search query "view" with v :: _ -> (match Params.Tab.of_string v with Some v -> v | None -> (Params.Tab.Overview)) | [] -> (Params.Tab.Overview));
              })))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "page"; p1 ] -> (
      match meth with
      | `GET | `HEAD -> (
          match Yuka.Router.int_param p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Page_n { n = p1 }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "i"; p1 ] -> (
      match Params.Issue_id.of_string p1 with
      | None -> Yuka.Router.Missing
      | Some p1 -> Yuka.Router.Redirect { permanent = true; location = "/issue/" ^ Yuka.Router.encode (Params.Issue_id.to_string p1) })
  | [ "issue"; p1; "close" ] -> (
      match meth with
      | `POST -> (
          match Params.Issue_id.of_string p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Close_issue { id = p1 }))
      | _ -> Yuka.Router.Wrong_method [ `POST ])
  | [ "issue"; p1; "json" ] -> (
      match meth with
      | `GET | `HEAD -> (
          match Params.Issue_id.of_string p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Issue_json { id = p1 }))
      | `PUT -> (
          match Params.Issue_id.of_string p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Update_issue { id = p1 }))
      | _ -> Yuka.Router.Wrong_method [ `GET; `PUT ])
  | "docs" :: (_ :: _ as p1) -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found (Doc { parts = p1 })
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | "old-docs" :: (_ :: _ as p1) -> Yuka.Router.Redirect { permanent = false; location = "/docs/" ^ String.concat "/" (List.map Yuka.Router.encode p1) }
  | _ -> Yuka.Router.Missing
