type t =
  | Home
  | Blog of { lang : string option; tag : string option; page : int; label : string list; draft : bool }
  | Post of { slug : string; lang : string option }
  | New_post of { lang : string option }
  | Issue of { id : Params.issue_id; tab : Params.Tab.t option; seen : int list; view : Params.Tab.t }
  | Close_issue of { id : Params.issue_id }
  | Issue_json of { id : Params.issue_id }
  | Update_issue of { id : Params.issue_id }
  | Page_n of { n : int }
  | Cafe
  | Doc of { parts : string list }
  | Feed
  | Clear_feed
  | Missing

let with_query path pairs =
  match pairs with
  | [] -> path
  | _ ->
      Stdlib.String.concat ""
        [
          path;
          "?";
          Stdlib.String.concat "&"
            (Stdlib.List.map (fun (k, v) -> Stdlib.String.concat "=" [ k; v ]) pairs);
        ]

let href = function
  | Home -> "/"
  | Blog { lang; tag; page; label; draft } ->
      with_query "/blog"
        (Stdlib.List.concat
           [
             (match lang with Some v -> [ ("lang", Yuka.Router.encode v) ] | None -> []);
             (match tag with Some v -> [ ("tag", Yuka.Router.encode v) ] | None -> []);
             (if Stdlib.( = ) page (1) then [] else [ ("page", Stdlib.string_of_int page) ]);
             Stdlib.List.map (fun v -> ("label", Yuka.Router.encode v)) label;
             (if Stdlib.( = ) draft (false) then [] else [ ("draft", Stdlib.string_of_bool draft) ]);
           ])
  | Post { slug; lang } ->
      with_query (Stdlib.( ^ ) "/blog/" (Yuka.Router.segment slug))
        ((match lang with Some v -> [ ("lang", Yuka.Router.encode v) ] | None -> []))
  | New_post { lang } ->
      with_query "/blog/new"
        ((match lang with Some v -> [ ("lang", Yuka.Router.encode v) ] | None -> []))
  | Issue { id; tab; seen; view } ->
      with_query (Stdlib.( ^ ) "/issue/" (Yuka.Router.segment (Yuka.Router.Param.encode Params.issue_id_param id)))
        (Stdlib.List.concat
           [
             (match tab with Some v -> [ ("tab", Yuka.Router.encode (Yuka.Router.Param.encode Params.Tab.param v)) ] | None -> []);
             Stdlib.List.map (fun v -> ("seen", Stdlib.string_of_int v)) seen;
             (if Stdlib.( = ) (Yuka.Router.Param.encode Params.Tab.param view) (Yuka.Router.Param.encode Params.Tab.param (Params.Tab.Overview)) then [] else [ ("view", Yuka.Router.encode (Yuka.Router.Param.encode Params.Tab.param view)) ]);
           ])
  | Close_issue { id } -> Stdlib.( ^ ) "/issue/" (Stdlib.( ^ ) (Yuka.Router.segment (Yuka.Router.Param.encode Params.issue_id_param id)) "/close")
  | Issue_json { id } -> Stdlib.( ^ ) "/issue/" (Stdlib.( ^ ) (Yuka.Router.segment (Yuka.Router.Param.encode Params.issue_id_param id)) "/json")
  | Update_issue { id } -> Stdlib.( ^ ) "/issue/" (Stdlib.( ^ ) (Yuka.Router.segment (Yuka.Router.Param.encode Params.issue_id_param id)) "/json")
  | Page_n { n } -> Stdlib.( ^ ) "/page/" (Stdlib.string_of_int n)
  | Cafe -> "/caf%C3%A9"
  | Doc { parts } -> Stdlib.( ^ ) "/docs" (Yuka.Router.segments parts)
  | Feed -> "/feed.xml"
  | Clear_feed -> "/feed.xml"
  | Missing -> "/missing"

let with_fragment path fragment =
  Stdlib.( ^ ) path
    (match fragment with None -> "" | Some fragment -> Stdlib.( ^ ) "#" (Yuka.Router.encode fragment))

let home ?fragment () = with_fragment (href Home) fragment

let blog ?lang ?tag ?(page = 1) ?(label = []) ?(draft = false) ?fragment () = with_fragment (href (Blog { lang; tag; page; label; draft })) fragment

let post ~slug ?lang ?fragment () = with_fragment (href (Post { slug; lang })) fragment

let new_post ?lang ?fragment () = with_fragment (href (New_post { lang })) fragment

let issue ~id ?tab ?(seen = []) ?(view = Params.Tab.Overview) ?fragment () = with_fragment (href (Issue { id; tab; seen; view })) fragment

let close_issue ~id ?fragment () = with_fragment (href (Close_issue { id })) fragment

let issue_json ~id ?fragment () = with_fragment (href (Issue_json { id })) fragment

let update_issue ~id ?fragment () = with_fragment (href (Update_issue { id })) fragment

let page_n ~n ?fragment () = with_fragment (href (Page_n { n })) fragment

let cafe ?fragment () = with_fragment (href Cafe) fragment

let doc ~parts ?fragment () = with_fragment (href (Doc { parts })) fragment

let feed ?fragment () = with_fragment (href Feed) fragment

let clear_feed ?fragment () = with_fragment (href Clear_feed) fragment

let missing ?fragment () = with_fragment (href Missing) fragment

let find (meth : Yuka.Router.meth) (path : string list)
    (query : (string * string) list) : t Yuka.Router.lookup =
  match path with
  | [] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Home
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "blog" ] -> (
      match meth with
      | `GET | `HEAD -> (
          Yuka.Router.Found (Blog {
            lang = (match Yuka.Router.search query "lang" with v :: _ -> Some v | [] -> None);
            tag = (match Yuka.Router.search query "tag" with v :: _ -> Some v | [] -> None);
            page = (match Yuka.Router.search query "page" with v :: _ -> (match Yuka.Router.int_param v with Some v -> v | None -> (1)) | [] -> (1));
            label = Yuka.Router.search query "label";
            draft = (match Yuka.Router.search query "draft" with v :: _ -> (match (match v with "true" -> Some true | "false" -> Some false | _ -> None) with Some v -> v | None -> (false)) | [] -> (false));
          }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "caf\195\169" ] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Cafe
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "feed.xml" ] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Feed
      | `DELETE -> Yuka.Router.Found Clear_feed
      | _ -> Yuka.Router.Wrong_method [ `GET; `DELETE ])
  | [ "missing" ] -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found Missing
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "legacy-blog" ] -> Yuka.Router.Redirect { permanent = false; location = "/blog" }
  | [ "blog"; "new" ] -> (
      match meth with
      | `GET | `HEAD -> (
          Yuka.Router.Found (New_post {
            lang = (match Yuka.Router.search query "lang" with v :: _ -> Some v | [] -> None);
          }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "blog"; p1 ] -> (
      match meth with
      | `GET | `HEAD -> (
          Yuka.Router.Found (Post {
            slug = p1;
            lang = (match Yuka.Router.search query "lang" with v :: _ -> Some v | [] -> None);
          }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "issue"; p1 ] -> (
      match meth with
      | `GET | `HEAD -> (
          match Yuka.Router.Param.decode Params.issue_id_param p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> (
              Yuka.Router.Found (Issue {
                id = p1;
                tab = (match Yuka.Router.search query "tab" with v :: _ -> Yuka.Router.Param.decode Params.Tab.param v | [] -> None);
                seen = Stdlib.List.filter_map (fun v -> Yuka.Router.int_param v) (Yuka.Router.search query "seen");
                view = (match Yuka.Router.search query "view" with v :: _ -> (match Yuka.Router.Param.decode Params.Tab.param v with Some v -> v | None -> (Params.Tab.Overview)) | [] -> (Params.Tab.Overview));
              })))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "page"; p1 ] -> (
      match meth with
      | `GET | `HEAD -> (
          match Yuka.Router.int_param p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Page_n { n = p1 }))
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | [ "i"; p1 ] -> (
      match Yuka.Router.Param.decode Params.issue_id_param p1 with
      | None -> Yuka.Router.Missing
      | Some p1 -> Yuka.Router.Redirect { permanent = true; location = Stdlib.( ^ ) "/issue/" (Yuka.Router.encode (Yuka.Router.Param.encode Params.issue_id_param p1)) })
  | [ "issue"; p1; "close" ] -> (
      match meth with
      | `POST -> (
          match Yuka.Router.Param.decode Params.issue_id_param p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Close_issue { id = p1 }))
      | _ -> Yuka.Router.Wrong_method [ `POST ])
  | [ "issue"; p1; "json" ] -> (
      match meth with
      | `GET | `HEAD -> (
          match Yuka.Router.Param.decode Params.issue_id_param p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Issue_json { id = p1 }))
      | `PUT -> (
          match Yuka.Router.Param.decode Params.issue_id_param p1 with
          | None -> Yuka.Router.Missing
          | Some p1 -> Yuka.Router.Found (Update_issue { id = p1 }))
      | _ -> Yuka.Router.Wrong_method [ `GET; `PUT ])
  | "docs" :: (_ :: _ as p1) -> (
      match meth with
      | `GET | `HEAD -> Yuka.Router.Found (Doc { parts = p1 })
      | _ -> Yuka.Router.Wrong_method [ `GET ])
  | "old-docs" :: (_ :: _ as p1) -> Yuka.Router.Redirect { permanent = false; location = Stdlib.( ^ ) "/docs/" (Stdlib.String.concat "/" (Stdlib.List.map Yuka.Router.encode p1)) }
  | _ -> Yuka.Router.Missing
