(library
 (name routes_shadowed)
 (modes native melange)
 (libraries yuka shadow)
 (flags
  (:standard -open Shadow)))

(copy_files# ../fixture/params.ml)

(rule
 (targets routes.ast)
 (deps ../Routes.mlx)
 (action
  (with-stdout-to
   routes.ast
   (run %{bin:mlx-pp} %{deps}))))

(rule
 (targets routes.ml)
 (action
  (with-stdout-to
   routes.ml
   (run %{bin:yuka-routes} --shared %{dep:routes.ast}))))
