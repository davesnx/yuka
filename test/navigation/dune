   (run node %{dep:out/test/navigation/run.js} move)
   (run node %{dep:out/test/navigation/run.js} replay)
   (run node %{dep:out/test/navigation/run.js} stall)
   (run node %{dep:out/test/navigation/run.js} fail))))
