(library
 (name cycle_shadowed)
 (libraries yuka cycle_shared cycle_server shadow)
 (flags
  (:standard -open Cycle_shared -open Cycle_server)))

(rule
 (targets routes.txt)
 (action
  (with-stdout-to
   routes.txt
   (progn
    (echo "open Shadow [@@warning \"-33\"]\n")
    (cat %{dep:../Routes.ml})))))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Cycle_shared.Routes
    --source
    %{dep:routes.txt}))))
