let rules_0 =
  Yuka.Server.rules ~headers:[ [("x-frame-options", "DENY"); ("x-a", "root")] ] ~cache:(No_store) ~prerender:false ()

let rules_1 =
  Yuka.Server.rules ~headers:[ [("x-frame-options", "DENY"); ("x-a", "root")] ] ~cache:(No_store) ~prerender:true ()

let rules_2 =
  Yuka.Server.rules ~headers:[ [("x-frame-options", "DENY"); ("x-a", "root")]; [("X-A", "team")] ] ~cache:(Private { max_age = 5 }) ~prerender:false ()

let rules_3 =
  Yuka.Server.rules ~headers:[ [("x-frame-options", "DENY"); ("x-a", "root")]; [("X-A", "team")] ] ~cache:(Public { max_age = 60; s_max_age = (Some 600) }) ~prerender:false ()

let rules_4 =
  Yuka.Server.rules ~headers:[ [("x-frame-options", "DENY"); ("x-a", "root")]; [("Vary", "Cookie")] ] ~cache:(No_store) ~prerender:false ()

let rules_5 =
  Yuka.Server.rules ~headers:[ [("x-frame-options", "DENY"); ("x-a", "root")] ] ~cache:(Immutable) ~prerender:false ()

let layer_0 : Yuka.Server.layer =
  { Yuka.Server.key = "L0"; data = false; wrap = (fun children -> App.Layouts.root ~children ()) }

let fallback_0 : Yuka.Server.fallback =
  {
    Yuka.Server.layers =
      [
        layer_0;
      ];
    not_found = (fun target -> App.Pages.not_found ~target ());
    error = (fun status -> App.Pages.error ~status ());
  }

let resolve req (route : Cycle_shared.Routes.t) : Yuka.Server.target =
  match route with
  | Cycle_shared.Routes.Home ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.home ();
                   }));
        }
  | Cycle_shared.Routes.Plain ->
      Yuka.Server.Page
        {
          rules = rules_1;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.plain ();
                   }));
        }
  | Cycle_shared.Routes.Entry ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.entry ();
                   }));
        }
  | Cycle_shared.Routes.Find { q; tag } ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.find ~q ~tag ();
                   }));
        }
  | Cycle_shared.Routes.Islands ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.islands ();
                   }));
        }
  | Cycle_shared.Routes.Slow ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.slow ();
                   }));
        }
  | Cycle_shared.Routes.Twice ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.twice ();
                   }));
        }
  | Cycle_shared.Routes.Broken ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.broken ();
                   }));
        }
  | Cycle_shared.Routes.Boom ->
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              let exploding = App.Loaders.exploding req in
              Yuka.Server.loaded exploding (fun exploding ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.boom ~exploding ();
                   })));
        }
  | Cycle_shared.Routes.Member { team; user } ->
      Yuka.Server.Page
        {
          rules = rules_2;
          guards = [ (fun () -> App.Guards.outer req ~team); (fun () -> App.Guards.inner req ~team ~user) ];
          fallback = fallback_0;
          load =
            (fun () ->
              let squad = App.Loaders.squad req ~team in
              let profile = App.Loaders.profile req ~team ~user in
              Yuka.Server.loaded squad (fun squad ->
              Yuka.Server.loaded profile (fun profile ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                         { Yuka.Server.key = Stdlib.String.concat "/" [ "L1"; Yuka.Router.encode (Params.Team.to_string team) ]; data = true; wrap = (fun children -> App.Layouts.team ~squad ~children ()) };
                       ];
                     page = App.Pages.member ~team ~user ~squad ~profile ();
                   }))));
        }
  | Cycle_shared.Routes.Team_form { team } ->
      Yuka.Server.Page
        {
          rules = rules_2;
          guards = [ (fun () -> App.Guards.outer req ~team) ];
          fallback = fallback_0;
          load =
            (fun () ->
              let squad = App.Loaders.squad req ~team in
              Yuka.Server.loaded squad (fun squad ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                         { Yuka.Server.key = Stdlib.String.concat "/" [ "L1"; Yuka.Router.encode (Params.Team.to_string team) ]; data = true; wrap = (fun children -> App.Layouts.team ~squad ~children ()) };
                       ];
                     page = App.Pages.team_form ~team ~squad ();
                   })));
        }
  | Cycle_shared.Routes.Team_json { team } ->
      Yuka.Server.Handler
        {
          rules = rules_3;
          same_origin = false;
          guards = [ (fun () -> App.Guards.outer req ~team) ];
          run = (fun () -> App.Api.team req ~team);
        }
  | Cycle_shared.Routes.Rename { team } ->
      Yuka.Server.Handler
        {
          rules = rules_2;
          same_origin = true;
          guards = [ (fun () -> App.Guards.outer req ~team) ];
          run = (fun () -> App.Api.rename req ~team);
        }
  | Cycle_shared.Routes.Varied ->
      Yuka.Server.Page
        {
          rules = rules_4;
          guards = [];
          fallback = fallback_0;
          load =
            (fun () ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                       ];
                     page = App.Pages.plain ();
                   }));
        }
  | Cycle_shared.Routes.Asset ->
      Yuka.Server.Handler
        {
          rules = rules_5;
          same_origin = false;
          guards = [];
          run = (fun () -> App.Api.asset req);
        }
  | Cycle_shared.Routes.Org_item { org; n } ->
      let layer_2 = { Yuka.Server.key = Stdlib.String.concat "/" [ "L2"; Yuka.Router.encode org ]; data = false; wrap = (fun children -> App.Layouts.org ~children ()) } in
      Yuka.Server.Page
        {
          rules = rules_0;
          guards = [];
          fallback = {
            Yuka.Server.layers =
              [
                layer_0;
                layer_2;
              ];
            not_found = (fun target -> App.Pages.org_missing ~org ~target ());
            error = (fun status -> App.Pages.error ~status ());
          };
          load =
            (fun () ->
              let org_item = App.Loaders.org_item req ~org ~n in
              Yuka.Server.loaded org_item (fun org_item ->
              Yuka.Async.return
                (Stdlib.Ok
                   {
                     Yuka.Server.layers =
                       [
                         layer_0;
                         layer_2;
                       ];
                     page = App.Pages.org_item ~org ~n ~org_item ();
                   })));
        }
  | Cycle_shared.Routes.Feed ->
      Yuka.Server.Handler
        {
          rules = rules_1;
          same_origin = false;
          guards = [];
          run = (fun () -> App.Api.feed req);
        }
  | Cycle_shared.Routes.Later ->
      Yuka.Server.Handler
        {
          rules = rules_0;
          same_origin = false;
          guards = [];
          run = (fun () -> App.Api.later req);
        }
  | Cycle_shared.Routes.Clear_feed ->
      Yuka.Server.Handler
        {
          rules = rules_5;
          same_origin = true;
          guards = [];
          run = (fun () -> App.Api.clear req);
        }

let app =
  Yuka.Server.app ~build:"1cf6dadd97bc028213341b9942bb4780"
    ~headers:([("x-frame-options", "DENY"); ("x-a", "root")])
    ~prerender:[ "/plain"; "/feed.xml" ]
    ~find:Cycle_shared.Routes.find ~resolve ~missing:fallback_0
