(library
 (name cycle_server)
 (libraries yuka cycle_shared forms_shared)
 (flags
  (:standard -open Cycle_shared)))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Cycle_shared.Routes
    --source
    %{dep:../Routes.ml}))))

(rule
 (alias runtest)
 (package yuka)
 (action
  (diff yuka_routes.expected yuka_routes.ml)))
