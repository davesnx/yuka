let name : string Yuka.State.t = Yuka.State.make "a"
let enabled : bool Yuka.State.t = Yuka.State.make false
let greeting = "hi"
let label () = Yuka.text (Yuka.State.get name)
let query = Yuka.Action.query ~name:"holes" ~input:Yuka.Codec.string ~output:Yuka.Codec.string

let remote_view () : Yuka.client Yuka.element =
  let remote = Yuka.Remote.make ~enabled:(fun () -> Yuka.State.get enabled) query (fun () -> "a") in
  <b>
    "status: "
    (match Yuka.Remote.status remote with
     | Yuka.Status.Idle -> Yuka.text "idle"
     | Yuka.Status.Loading _ -> Yuka.text "loading"
     | _ -> Yuka.text "other")
  </b>

let helper_view () : Yuka.client Yuka.element = <p>"name: " (label ())</p>
let static_view () : Yuka.client Yuka.element = <p>"a" (Yuka.text greeting) <i /></p>
let explicit_static_view () : Yuka.client Yuka.element = <p>"a" (Yuka.hole (fun () -> Yuka.text greeting)) <i /></p>
let badge ~count = <b class_=("n" ^ string_of_int count)>(Yuka.text (if count > 1 then "many" else "one"))</b>

let constant_view () : Yuka.client Yuka.element =
  <p title=(greeting ^ "!")>
    (badge ~count:2)
    (Yuka.fragment (List.map (fun item -> <i>(Yuka.text item)</i>) [ "x"; "y" ]))
  </p>
let dynamic_view () : Yuka.client Yuka.element = <p>"a" (Yuka.text (Yuka.State.get name)) <i /></p>

let conditional_view ~read () : Yuka.client Yuka.element =
  <p>"a" (if read then Yuka.text (Yuka.State.get name) else Yuka.text "none") <i /></p>

let static_list_view () : Yuka.client Yuka.element =
  <ul>(Yuka.each ~key:(fun item -> item) (fun () -> [| "x"; "y" |]) (fun item -> <li>(Yuka.text item)</li>))</ul>

module Body = struct
  let runs = ref 0

  let make () =
    incr runs;
    let own = Yuka.State.make 0 in
    ignore (Yuka.State.get name);
    <i>(Yuka.int (Yuka.State.get own))</i>
end

let calls = ref 0

let plain () =
  incr calls;
  Yuka.text (Yuka.State.get name)

let component_view () : Yuka.client Yuka.element =
  <p>(if Yuka.State.get enabled then <Body /> else <Body />) <span>(plain ())</span></p>

module Styled = struct
  type style = { color : string }

  let make ~style () = <i>(Yuka.text style.color)</i>
end

let styled_view () : Yuka.client Yuka.element = <p><Styled style=({ color = Yuka.State.get name ^ "!" }) /></p>

let unique_id_view () : Yuka.client Yuka.element = <p>(Yuka.with_unique_id (fun id -> Yuka.text (id ^ Yuka.State.get name)))</p>

let shown text = text

module Reads = struct
  let shown _ = Yuka.State.get name
end

let local_open_view () : Yuka.client Yuka.element = let open Reads in <p>(Yuka.text (shown "x"))</p>

module Nested = struct
  module Int = struct
    let to_string _ = Yuka.State.get name
  end

  let view () : Yuka.client Yuka.element = <p>(Yuka.text (Int.to_string 1))</p>
end

let format ?(sep = "") () = fun () -> sep ^ Yuka.State.get name
let optional_view () : Yuka.client Yuka.element = <p>(Yuka.text (format () ()))</p>

let over_applied_view () : Yuka.client Yuka.element =
  <p>(Yuka.text (Option.value None ~default:(fun _ -> Yuka.State.get name) "x"))</p>
