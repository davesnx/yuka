open Yuka

module Str_like = struct
  let contains text part =
    let n = String.length part in
    let rec at i = i + n <= String.length text && (String.sub text i n = part || at (i + 1)) in
    at 0
end

let html node = Server.to_string (fun () -> node)
let check_html msg expected node = Alcotest.(check string) msg expected (html node)

let print_client node =
  Private.print (Private.session ~streaming:false ~islands_only:true) (fun () -> Private.node node)

let check_client msg expected node = Alcotest.(check string) msg expected (print_client node)

let raises msg f =
  match f () with
  | _ -> Alcotest.failf "%s: no exception" msg
  | exception Invalid_argument _ -> ()

let script_urls =
  [
    "javascript:alert(1)";
    " JaVaScRiPt:alert(1)";
    "java\tscript:alert(1)";
    "java\nscr\ript:alert(1)";
    "\x00javascript:alert(1)";
    "\x01\x1f javascript:alert(1)";
    "vbscript:msgbox(1)";
  ]

let data_urls = [ "data:text/html,<script>alert(1)</script>"; " DATA:text/html;base64,PHNjcmlwdD4="; "da\tta:text/html,x" ]
let safe = [ "https://example.com/a"; "/issue/1"; "#top"; "mailto:a@b.c"; "javascript"; "./javascript:x" ]
let escaped v = String.concat "&lt;" (String.split_on_char '<' (String.concat "&amp;" (String.split_on_char '&' v)))
let one tag name v = html (lower tag [ attr name v ] [])
let blocked tag name = Printf.sprintf {|<%s %s="about:blank#blocked">|} tag name
let kept tag name v = Printf.sprintf {|<%s %s="%s">|} tag name (escaped v)

let close tag = if List.mem tag [ "img"; "input"; "embed"; "source"; "track"; "area"; "link" ] then "" else "</" ^ tag ^ ">"

let script_schemes () =
  List.iter
    (fun v ->
      List.iter
        (fun (tag, name) ->
          Alcotest.(check string) (tag ^ " " ^ name ^ " " ^ String.escaped v) (blocked tag name ^ close tag) (one tag name v))
        [ ("a", "href"); ("img", "src"); ("form", "action"); ("button", "formaction"); ("iframe", "src"); ("video", "poster");
          ("blockquote", "cite"); ("object", "data"); ("link", "href"); ("use", "xlink:href"); ("a", "HREF");
          ("button", "FormAction"); ("img", "Src"); ("animate", "values"); ("set", "to") ])
    script_urls;
  List.iter
    (fun v -> Alcotest.(check string) ("kept " ^ v) (kept "a" "href" v ^ "</a>") (one "a" "href" v))
    safe;
  Alcotest.(check string) "not a URL attribute" (kept "a" "title" "javascript:x" ^ "</a>") (one "a" "title" "javascript:x");
  Alcotest.(check string) "values: any item" (blocked "animate" "values" ^ "</animate>")
    (one "animate" "values" "https://a;  javascript:alert(1)");
  Alcotest.(check string) "to on another element is not a URL" (kept "p" "to" "javascript:x" ^ "</p>") (one "p" "to" "javascript:x")

let data_scheme () =
  List.iter
    (fun v ->
      List.iter
        (fun (tag, name) ->
          Alcotest.(check string) ("blocked " ^ tag ^ " " ^ name) (blocked tag name ^ close tag) (one tag name v))
        [ ("a", "href"); ("area", "href"); ("form", "action"); ("button", "formaction"); ("input", "formaction");
          ("iframe", "src"); ("frame", "src"); ("embed", "src"); ("object", "data"); ("use", "href"); ("use", "xlink:href") ];
      List.iter
        (fun (tag, name) ->
          Alcotest.(check string) ("kept " ^ tag ^ " " ^ name) (kept tag name v ^ close tag) (one tag name v))
        [ ("img", "src"); ("video", "src"); ("audio", "src"); ("source", "src"); ("track", "src"); ("video", "poster");
          ("link", "href"); ("input", "src") ])
    data_urls

let printer_paths () =
  raises "attr_unchecked refuses a URL name" (fun () -> attr_unchecked "href" "/x");
  raises "attr_unchecked refuses any case" (fun () -> attr_unchecked "SRC" "/x");
  raises "hole_attr_unchecked refuses a URL name" (fun () -> hole_attr_unchecked "formaction" (fun () -> None));
  check_client "a dynamic attribute" {|<a href="about:blank#blocked">x</a>|}
    (lower "a" [ hole_attr "href" (fun () -> Some " javascript:x") ] [ text "x" ]);
  let t =
    Template.make
      (Template.element "form" [ Template.fixed "action" "javascript:alert(1)"; Template.part_attr 0 ] [])
      ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
  in
  check_html "a template: fixed and part" {|<form action="about:blank#blocked" formaction="about:blank#blocked"></form>|}
    (Template.instance t [| Template.attribute (attr "formaction" "vbscript:x") |])

let mlx () =
  let url = "java\tscript:alert(1)" in
  check_html "a template part from mlx" {|<a href="about:blank#blocked" class="c">x</a>|} <a href=url class_="c">"x"</a>;
  let state = State.make url in
  check_client "a hole from mlx" {|<a href="about:blank#blocked">x</a>|} <a href=(State.get state)>"x"</a>;
  let data = "data:image/png;base64,iVBORw0KGgo=" in
  check_html "a data image in mlx" {|<img src="data:image/png;base64,iVBORw0KGgo=">|} <img src=data />

let raw_text () =
  check_html "script text is not HTML-escaped, its end tag and <!-- are made safe"
    {|<script>if (a < b && c > d) { s = "<\/script><b>"; t = '<\/SCRIPT '; } <\!-- x</script>|}
    (lower "script" [] [ text {|if (a < b && c > d) { s = "</script><b>"; t = '</SCRIPT '; } <!-- x|} ]);
  check_html "a module script" {|<script type="module">a<\/script></script>|}
    (lower "script" [ attr "type" "module" ] [ text "a</script>" ]);
  check_html "style text" {|<style>a > b { content: "<\/style>"; } <!-- kept</style>|}
    (lower "style" [] [ text {|a > b { content: "</style>"; } <!-- kept|} ]);
  check_html "a JSON script: every < is \\u003c"
    {|<script type="application/json">{"a":"\u003c/script>\u003c!--"}</script>|}
    (lower "script" [ attr "type" "application/json" ] [ text {|{"a":"</script><!--"}|} ]);
  check_html "an import map" {|<script type="importmap">{"imports":{"\u003ca":"/x"}}</script>|}
    (lower "script" [ attr "type" "importmap" ] [ text {|{"imports":{"<a":"/x"}}|} ]);
  check_client "one hole: one text, no markers" {|<script>a && "<\/script>"</script>|}
    (lower "script" [] [ hole (fun () -> text {|a && "</script>"|}) ]);
  check_html "mlx: texts and a value joined, then made safe as one string"
    {|<div><script>x = 1 < 2 && "<\/script>"</script><style>p > a {} <\/style></style></div>|}
    (let tail = "/style>" in
     <div><script>{|x = 1 < 2 && "</script>"|}</script><style>"p > a {} <"(Yuka.text tail)</style></div>);
  check_html "inside svg, style is foreign content: escaped"
    {|<svg><style>&lt;img src=x onerror=alert(1)&gt;</style></svg>|}
    (lower "svg" [] [ lower "style" [] [ text "<img src=x onerror=alert(1)>" ] ]);
  check_html "inside math, script is escaped" {|<math><script>a &lt; b</script></math>|}
    (lower "math" [] [ lower "script" [] [ text "a < b" ] ]);
  check_html "foreignObject is HTML again" {|<svg><foreignObject><style>a > b</style></foreignObject></svg>|}
    (lower "svg" [] [ lower "foreignObject" [] [ lower "style" [] [ text "a > b" ] ] ]);
  check_html "mlx: style in svg" {|<svg><style>&lt;img src=x onerror=alert(1)&gt;</style></svg>|}
    (let user = "<img src=x onerror=alert(1)>" in
     <svg><style>(Yuka.text user)</style></svg>);
  let t =
    Template.make
      (Template.element "svg" [] [ Template.part 0 ])
      ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
  in
  check_html "a template svg with a style part" {|<svg><style>&lt;b&gt;</style></svg>|}
    (Template.instance t [| Template.child (lower "style" [] [ text "<b>" ]) |]);
  check_html "text outside script is still escaped" {|<p>a &lt; b &amp;&amp; c</p>|} (lower "p" [] [ text "a < b && c" ])

let raw_text_children () =
  raises "two texts" (fun () -> html (lower "script" [] [ text "a"; text "b" ]));
  raises "an element" (fun () -> html (lower "style" [] [ lower "b" [] [] ]));
  raises "a hole that gives an element" (fun () -> print_client (lower "script" [] [ hole (fun () -> lower "b" [] []) ]));
  let printed =
    match html (lower "div" [] [ text "before"; Catch.make ~fallback:(fun ~error:_ ~reset:_ -> text "caught") ~children:(fun () -> lower "script" [] [ text "a"; text "b" ]) () ]) with
    | s -> s
    | exception Invalid_argument _ -> "raised"
  in
  Alcotest.(check bool) "no partial script" false (Str_like.contains printed "<script")

let () =
  Alcotest.run "safety"
    [
      ( "urls",
        [
          Alcotest.test_case "script schemes, any case and clean-up, any URL attribute" `Quick script_schemes;
          Alcotest.test_case "data: only where it loads a document" `Quick data_scheme;
          Alcotest.test_case "unchecked constructors, dynamic and template attributes" `Quick printer_paths;
          Alcotest.test_case "mlx attributes and holes" `Quick mlx;
        ] );
      ( "raw text",
        [
          Alcotest.test_case "script and style" `Quick raw_text;
          Alcotest.test_case "only one text or one hole" `Quick raw_text_children;
        ] );
    ]
