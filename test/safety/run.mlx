open Yuka

module Str_like = struct
  let contains text part =
    let n = String.length part in
    let rec at i = i + n <= String.length text && (String.sub text i n = part || at (i + 1)) in
    at 0
end

let html node = Server.to_string (fun () -> node)
let check_html msg expected node = Alcotest.(check string) msg expected (html node)

let print_client node =
  Private.print (Private.session ~streaming:false ~islands_only:true) (fun () -> Private.node node)

let check_client msg expected node = Alcotest.(check string) msg expected (print_client node)

let raises msg f =
  match f () with
  | _ -> Alcotest.failf "%s: no exception" msg
  | exception Invalid_argument _ -> ()

let script_urls =
  [
    "javascript:alert(1)";
    " JaVaScRiPt:alert(1)";
    "java\tscript:alert(1)";
    "java\nscr\ript:alert(1)";
    "\x00javascript:alert(1)";
    "\x01\x1f javascript:alert(1)";
    "vbscript:msgbox(1)";
  ]

let data_urls = [ "data:text/html,<script>alert(1)</script>"; " DATA:text/html;base64,PHNjcmlwdD4="; "da\tta:text/html,x" ]
let safe = [ "https://example.com/a"; "/issue/1"; "#top"; "mailto:a@b.c"; "javascript"; "./javascript:x" ]
let escaped v = String.concat "&lt;" (String.split_on_char '<' (String.concat "&amp;" (String.split_on_char '&' v)))
let one tag name v = html (element tag [ attr name v ] [])
let blocked tag name = Printf.sprintf {|<%s %s="about:blank#blocked">|} tag name
let kept tag name v = Printf.sprintf {|<%s %s="%s">|} tag name (escaped v)

let close tag = if List.mem tag [ "img"; "input"; "embed"; "source"; "track"; "area"; "link" ] then "" else "</" ^ tag ^ ">"

let script_schemes () =
  List.iter
    (fun v ->
      List.iter
        (fun (tag, name) ->
          Alcotest.(check string) (tag ^ " " ^ name ^ " " ^ String.escaped v) (blocked tag name ^ close tag) (one tag name v))
        [ ("a", "href"); ("img", "src"); ("form", "action"); ("button", "formaction"); ("iframe", "src"); ("video", "poster");
          ("blockquote", "cite"); ("object", "data"); ("link", "href"); ("use", "xlink:href"); ("a", "HREF");
          ("button", "FormAction"); ("img", "Src"); ("animate", "values"); ("set", "to") ])
    script_urls;
  List.iter
    (fun v -> Alcotest.(check string) ("kept " ^ v) (kept "a" "href" v ^ "</a>") (one "a" "href" v))
    safe;
  Alcotest.(check string) "not a URL attribute" (kept "a" "title" "javascript:x" ^ "</a>") (one "a" "title" "javascript:x");
  Alcotest.(check string) "values: any item" (blocked "animate" "values" ^ "</animate>")
    (one "animate" "values" "https://a;  javascript:alert(1)");
  Alcotest.(check string) "to on another element is not a URL" (kept "p" "to" "javascript:x" ^ "</p>") (one "p" "to" "javascript:x")

let scheme_table () =
  List.iter
    (fun (tag, name, v, is_blocked) ->
      let expected = (if is_blocked then blocked tag name else kept tag name v) ^ close tag in
      Alcotest.(check string) (tag ^ " " ^ name ^ " " ^ String.escaped v) expected (one tag name v))
    [ ("a", "href", "javascript:", true); ("a", "href", " JaVa\tScript:", true); ("a", "href", "\x01javascript:", true);
      ("a", "href", "\tjavascript:x", true); ("a", "href", "j\navascript:x", true); ("a", "href", "vbscript:", true);
      ("a", "href", "VBScript:x", true); ("a", "href", "data:", true); ("a", "href", "Data:x", true);
      ("img", "src", "data:", false); ("img", "src", "javascript:x", true); ("a", "href", "/path", false);
      ("a", "href", "#x", false); ("a", "href", "?q", false); ("a", "href", "https://x", false); ("a", "href", "d", false);
      ("a", "href", "j", false); ("a", "href", "v", false); ("a", "href", "", false); ("a", "href", "   ", false);
      ("a", "href", "\x01\x02", false); ("a", "href", "x javascript:x", false); ("a", "href", "javascript", false);
      ("a", "href", "data", false); ("a", "title", "javascript:x", false); ("animate", "values", "/a;javascript:x", true);
      ("animate", "values", ";javascript:x", true); ("animate", "values", "javascript:x;", true);
      ("animate", "values", "a;\x01 VBScript:x", true); ("animate", "values", "a; j\tavascript:x", true);
      ("animate", "values", "java;script:x", false); ("animate", "values", "a;;b", false); ("animate", "values", ";", false);
      ("animate", "values", "", false); ("animate", "values", "data:x", false); ("set", "to", "a;data:x", false);
      ("set", "to", "x;javascript:", true) ]

let data_scheme () =
  List.iter
    (fun v ->
      List.iter
        (fun (tag, name) ->
          Alcotest.(check string) ("blocked " ^ tag ^ " " ^ name) (blocked tag name ^ close tag) (one tag name v))
        [ ("a", "href"); ("area", "href"); ("form", "action"); ("button", "formaction"); ("input", "formaction");
          ("iframe", "src"); ("frame", "src"); ("embed", "src"); ("object", "data"); ("use", "href"); ("use", "xlink:href");
          ("script", "src"); ("script", "href"); ("script", "xlink:href"); ("SCRIPT", "SRC") ];
      List.iter
        (fun (tag, name) ->
          Alcotest.(check string) ("kept " ^ tag ^ " " ^ name) (kept tag name v ^ close tag) (one tag name v))
        [ ("img", "src"); ("video", "src"); ("audio", "src"); ("source", "src"); ("track", "src"); ("video", "poster");
          ("link", "href"); ("input", "src") ])
    data_urls

let printer_paths () =
  raises "attr_unchecked refuses a URL name" (fun () -> runtime_attr "href" "/x");
  raises "attr_unchecked refuses any case" (fun () -> runtime_attr "SRC" "/x");
  raises "hole_attr_unchecked refuses a URL name" (fun () -> runtime_hole_attr "formaction" (fun () -> None));
  check_client "a dynamic attribute" {|<a href="about:blank#blocked">x</a>|}
    (element "a" [ hole_attr "href" (fun () -> Some " javascript:x") ] [ text "x" ]);
  let t =
    Private.Template.make
      (Private.Template.element "form" [ Private.Template.fixed "action" "javascript:alert(1)"; Private.Template.part_attr 0 ] [])
      ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
  in
  check_html "a template: fixed and part" {|<form action="about:blank#blocked" formaction="about:blank#blocked"></form>|}
    (runtime_instance t [| runtime_attribute (attr "formaction" "vbscript:x") |])

let attribute_names () =
  List.iter
    (fun name ->
      raises ("printer: " ^ String.escaped name) (fun () -> html (element "a" [ attr name "x" ] []));
      raises ("hole: " ^ String.escaped name) (fun () -> print_client (element "a" [ hole_attr name (fun () -> Some "x") ] []));
      raises ("unchecked: " ^ String.escaped name) (fun () -> runtime_attr name "x");
      raises ("hole unchecked: " ^ String.escaped name) (fun () -> runtime_hole_attr name (fun () -> None));
      raises ("template: " ^ String.escaped name) (fun () -> Private.template Private.Template.(element "a" [ fixed name "x" ] [])))
    [ "href\t"; "href "; "x onclick=alert(1)"; ""; "a\"b"; "a'b"; "a>b"; "a/b"; "a=b"; "a<b"; "a\x00b"; "a\x7fb" ];
  check_html "a valid name" {|<a data-x:y_z.1="x"></a>|} (element "a" [ attr "data-x:y_z.1" "x" ] [])

let unchecked_names () =
  List.iter
    (fun name -> raises ("refused: " ^ String.escaped name) (fun () -> runtime_attr name "x"))
    [ ""; "href"; "HREF"; "Src"; "action"; "FormAction"; "xlink:href"; "XLink:Href"; "xlinkhref"; "poster"; "cite";
      "data"; "DATA"; "background"; "longdesc"; "manifest"; "codebase"; "icon"; "srcdoc"; "SrcDoc"; "on"; "onclick";
      "ONCLICK"; "oNload"; "On"; "a b"; "a\tb"; "a\"b"; "a'b"; "a>b"; "a/b"; "a=b"; "a<b"; "a\x00b"; "a\x7fb"; "A B" ];
  check_html "accepted names"
    {|<p title="x" TITLE="x" Class="x" data-x="x" aria-label="x" o="x" no="x" hrefx="x" xhref="x" srcset="x" data-href="x"></p>|}
    (element "p"
       (List.map
          (fun name -> runtime_attr name "x")
          [ "title"; "TITLE"; "Class"; "data-x"; "aria-label"; "o"; "no"; "hrefx"; "xhref"; "srcset"; "data-href" ])
       []);
  List.iter
    (fun (tag, name) ->
      let t =
        Private.Template.make
          (Private.Template.element tag [ Private.Template.fixed name "x" ] [])
          ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
      in
      raises ("printed: " ^ tag ^ " " ^ String.escaped name) (fun () -> html (runtime_instance t [||])))
    [ ("p", "onclick"); ("p", "ONCLICK"); ("p", "a b"); ("p", "a\"b"); ("p", ""); ("a", "onclick"); ("a", "a>b"); ("A", "On") ]

let srcdoc () =
  let v = "<script>alert(1)</script>" in
  check_html "a dynamic srcdoc is empty" {|<iframe srcdoc=""></iframe>|} (element "iframe" [ attr "srcdoc" v ] []);
  check_html "any case" {|<IFRAME SrcDoc=""></IFRAME>|} (element "IFRAME" [ attr "SrcDoc" v ] []);
  check_client "a srcdoc hole is empty" {|<iframe srcdoc=""></iframe>|}
    (element "iframe" [ hole_attr "srcdoc" (fun () -> Some v) ] []);
  check_html "mlx: a srcdoc value is empty" {|<iframe srcdoc=""></iframe>|} <iframe srcdoc=v />;
  check_html "mlx: a literal srcdoc is kept" {|<iframe srcdoc="&lt;b>hi&lt;/b>"></iframe>|}
    <iframe srcdoc="<b>hi</b>" />;
  check_html "srcdoc on another element is not HTML" {|<p srcdoc="&lt;b>"></p>|} (element "p" [ attr "srcdoc" "<b>" ] []);
  raises "srcdoc unchecked" (fun () -> runtime_attr "srcdoc" v);
  raises "srcdoc hole unchecked" (fun () -> runtime_hole_attr "SRCDOC" (fun () -> None))

let animation_names () =
  let matrix = "0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0 0 0 1 0" in
  let expected = Printf.sprintf {|<svg><feColorMatrix type="matrix" values="%s"></feColorMatrix></svg>|} matrix in
  check_html "mlx: feColorMatrix values" expected <svg><feColorMatrix type_="matrix" values=matrix /></svg>;
  check_html "attr_unchecked values" expected
    (element "svg" [] [ element "feColorMatrix" [ runtime_attr "type" "matrix"; runtime_attr "values" matrix ] [] ]);
  check_client "hole_attr_unchecked to" {|<p to="a" from="b" by="c"></p>|}
    (element "p" [ runtime_hole_attr "to" (fun () -> Some "a"); runtime_attr "from" "b"; runtime_attr "by" "c" ] []);
  check_html "values on animate is still checked" {|<animate values="about:blank#blocked"></animate>|}
    (element "animate" [ attr "values" "javascript:alert(1)" ] [])

let hand_written_template () =
  let t = Private.template Private.Template.(element "a" [ fixed "href" "javascript:alert(1)"; fixed "title" "javascript:x" ] []) in
  check_html "a fixed script URL" {|<a href="about:blank#blocked" title="javascript:x"></a>|} (runtime_instance t [||]);
  let t = Private.template Private.Template.(element "iframe" [ fixed "srcdoc" "<script>alert(1)</script>" ] []) in
  check_html "a fixed srcdoc in a hand-written template" {|<iframe srcdoc=""></iframe>|} (runtime_instance t [||])

let bad_tags = [ "img src=x onerror=alert(1)"; "x><script>alert(1)</script"; "svg\x0c"; ""; "1a"; "-a"; "a_b"; "a:b" ]

let tag_names () =
  List.iter
    (fun tag ->
      let name = String.escaped tag in
      raises ("element: " ^ name) (fun () -> html (element tag [] []));
      raises ("nested: " ^ name) (fun () -> html (element "div" [] [ element tag [] [] ]));
      raises ("client print: " ^ name) (fun () -> print_client (element tag [] []));
      raises ("raw text: " ^ name) (fun () -> html (element "svg" [] [ element tag [] [ text "x" ] ]));
      raises ("Private.template: " ^ name) (fun () -> Private.template Private.Template.(element "div" [] [ element tag [] [] ]));
      let t =
        Private.Template.make (Private.Template.element tag [ Private.Template.fixed "class" "c" ] []) ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
      in
      raises ("template: " ^ name) (fun () -> html (runtime_instance t [||])))
    bad_tags;
  check_html "valid tags" {|<my-widget-2></my-widget-2><svg><feColorMatrix></feColorMatrix></svg><H1></H1>|}
    (fragment [ element "my-widget-2" [] []; element "svg" [] [ element "feColorMatrix" [] [] ]; element "H1" [] [] ])

let event_names () =
  List.iter
    (fun name ->
      raises ("printer: " ^ name) (fun () -> html (element "img" [ attr name "alert(1)" ] []));
      raises ("hole: " ^ name) (fun () -> print_client (element "img" [ hole_attr name (fun () -> Some "alert(1)") ] []));
      raises ("url_attr: " ^ name) (fun () -> html (element "img" [ runtime_url_attr "img" name "alert(1)" ] []));
      raises ("unchecked: " ^ name) (fun () -> runtime_attr name "alert(1)");
      raises ("hole unchecked: " ^ name) (fun () -> runtime_hole_attr name (fun () -> None));
      raises ("template: " ^ name) (fun () -> Private.template Private.Template.(element "img" [ fixed name "alert(1)" ] [])))
    [ "onfocus"; "onerror"; "ONCLICK"; "onbegin"; "On"; "one" ];
  check_html "names that do not start with on" {|<p data-onclick="x" o="2" no="3"></p>|}
    (element "p" [ attr "data-onclick" "x"; attr "o" "2"; attr "no" "3" ] [])

let base_href () =
  let v = "https://evil.example/" in
  check_html "a dynamic base href is empty" {|<base href="">|} (element "base" [ attr "href" v ] []);
  check_html "any case" {|<BASE HREF="">|} (element "BASE" [ attr "HREF" v ] []);
  check_client "a base href hole" {|<base href="">|} (element "base" [ hole_attr "href" (fun () -> Some v) ] []);
  check_html "mlx: a base href value" {|<base href="">|} <base href=v />;
  check_html "mlx: a literal base href is kept" {|<base href="/app/">|} <base href="/app/" />;
  check_html "a hand-written template" {|<base href="">|}
    (runtime_instance (Private.template Private.Template.(element "base" [ fixed "href" "/app/" ] [])) [||]);
  check_html "href on a link is a URL, not a base" {|<a href="https://evil.example/"></a>|} (element "a" [ attr "href" v ] [])

let mlx () =
  let url = "java\tscript:alert(1)" in
  check_html "a template part from mlx" {|<a href="about:blank#blocked" class="c">x</a>|} <a href=url class_="c">"x"</a>;
  let state = State.make url in
  check_client "a hole from mlx" {|<a href="about:blank#blocked">x</a>|} <a href=(State.get state)>"x"</a>;
  let data = "data:image/png;base64,iVBORw0KGgo=" in
  check_html "a data image in mlx" {|<img src="data:image/png;base64,iVBORw0KGgo=">|} <img src=data />

let escape_reference ~quote s =
  String.concat ""
    (List.map
       (function
         | '&' -> "&amp;"
         | '<' -> "&lt;"
         | '>' when not quote -> "&gt;"
         | '"' when quote -> "&quot;"
         | c -> String.make 1 c)
       (List.of_seq (String.to_seq s)))

let escape_inputs =
  let fills = [ 'a'; '\xa6'; '\xbc'; '\xbe'; '\xa2'; '\''; '='; '$'; '?'; '\x00'; '\xff' ] in
  let one_special =
    List.concat_map
      (fun fill ->
        List.concat_map
          (fun c ->
            List.concat_map
              (fun n -> List.init n (fun at -> String.init n (fun i -> if i = at then c else fill)))
              (List.init 25 Fun.id))
          [ '&'; '<'; '>'; '"' ])
      fills
  in
  List.init 25 (fun n -> String.make n 'a')
  @ one_special
  @ [ "a&b<c>d\"e"; "&&&&&&&&&&&&&&&&&"; "<<>>\"\"&&"; "caf\xc3\xa9 & th\xc3\xa9 <b>"; "\xe2\x80\x94\"quoted\"\xe2\x80\x94";
      "0123456&89abcdef<123456>89abcde\"" ^ String.make 40 'x' ^ "&";
      String.init 256 Char.chr; String.init 512 (fun i -> Char.chr (255 - (i mod 256))) ]

let escapes () =
  List.iter
    (fun s ->
      Alcotest.(check string) ("text " ^ String.escaped s) (escape_reference ~quote:false s) (html (text s));
      Alcotest.(check string) ("attribute " ^ String.escaped s)
        ({|<p title="|} ^ escape_reference ~quote:true s ^ {|"></p>|})
        (html (element "p" [ attr "title" s ] [])))
    escape_inputs

let raw_text () =
  check_html "script text is not HTML-escaped, its end tag and <!-- are made safe"
    {|<script>if (a < b && c > d) { s = "<\/script><b>"; t = '<\/SCRIPT '; } <\!-- x</script>|}
    (element "script" [] [ text {|if (a < b && c > d) { s = "</script><b>"; t = '</SCRIPT '; } <!-- x|} ]);
  check_html "a module script" {|<script type="module">a<\/script></script>|}
    (element "script" [ attr "type" "module" ] [ text "a</script>" ]);
  check_html "style text" {|<style>a > b { content: "<\/style>"; } <!-- kept</style>|}
    (element "style" [] [ text {|a > b { content: "</style>"; } <!-- kept|} ]);
  check_html "a JSON script: every < is \\u003c"
    {|<script type="application/json">{"a":"\u003c/script>\u003c!--"}</script>|}
    (element "script" [ attr "type" "application/json" ] [ text {|{"a":"</script><!--"}|} ]);
  check_html "an import map" {|<script type="importmap">{"imports":{"\u003ca":"/x"}}</script>|}
    (element "script" [ attr "type" "importmap" ] [ text {|{"imports":{"<a":"/x"}}|} ]);
  check_client "one hole: one text, no markers" {|<script>a && "<\/script>"</script>|}
    (element "script" [] [ hole (fun () -> text {|a && "</script>"|}) ]);
  check_html "mlx: texts and a value joined, then made safe as one string"
    {|<div><script>x = 1 < 2 && "<\/script>"</script><style>p > a {} <\/style></style></div>|}
    (let tail = "/style>" in
     <div><script>{|x = 1 < 2 && "</script>"|}</script><style>"p > a {} <"(Yuka.text tail)</style></div>);
  check_html "inside svg, style is foreign content: escaped"
    {|<svg><style>&lt;img src=x onerror=alert(1)&gt;</style></svg>|}
    (element "svg" [] [ element "style" [] [ text "<img src=x onerror=alert(1)>" ] ]);
  check_html "inside math, script is escaped" {|<math><script>a &lt; b</script></math>|}
    (element "math" [] [ element "script" [] [ text "a < b" ] ]);
  check_html "foreignObject is HTML again" {|<svg><foreignObject><style>a > b</style></foreignObject></svg>|}
    (element "svg" [] [ element "foreignObject" [] [ element "style" [] [ text "a > b" ] ] ]);
  check_html "mlx: style in svg" {|<svg><style>&lt;img src=x onerror=alert(1)&gt;</style></svg>|}
    (let user = "<img src=x onerror=alert(1)>" in
     <svg><style>(Yuka.text user)</style></svg>);
  let t =
    Private.Template.make
      (Private.Template.element "svg" [] [ Private.Template.part 0 ])
      ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
  in
  check_html "a template svg with a style part" {|<svg><style>&lt;b&gt;</style></svg>|}
    (runtime_instance t [| runtime_child (element "style" [] [ text "<b>" ]) |]);
  check_html "raw text inside noscript: every </ is escaped"
    {|<noscript><style><\/noscript><img src=x onerror=alert(1)></style></noscript>|}
    (let user = "</noscript><img src=x onerror=alert(1)>" in
     <noscript><style>(Yuka.text user)</style></noscript>);
  List.iter
    (fun parent ->
      check_html ("script in " ^ parent) (Printf.sprintf {|<%s><script>a<\/%s>b<\/ x</script></%s>|} parent parent parent)
        (element parent [] [ element "script" [] [ text (Printf.sprintf "a</%s>b</ x" parent) ] ]))
    [ "noscript"; "textarea"; "title"; "iframe"; "noembed"; "noframes"; "xmp" ];
  check_html "a JSON script in noscript" {|<noscript><script type="application/json">\u003c/noscript></script></noscript>|}
    (element "noscript" [] [ element "script" [ attr "type" "application/json" ] [ text "</noscript>" ] ]);
  check_html "math > foreignObject stays MathML" {|<math><foreignObject><style>&lt;/math&gt;</style></foreignObject></math>|}
    (element "math" [] [ element "foreignObject" [] [ element "style" [] [ text "</math>" ] ] ]);
  check_html "math > svg > foreignObject stays MathML" {|<math><svg><foreignObject><script>a &lt; b</script></foreignObject></svg></math>|}
    (element "math" [] [ element "svg" [] [ element "foreignObject" [] [ element "script" [] [ text "a < b" ] ] ] ]);
  check_html "mlx: math > svg > foreignObject" {|<math><svg><foreignObject><style>&lt;b&gt;</style></foreignObject></svg></math>|}
    (let user = "<b>" in
     <math><svg><foreignObject><style>(Yuka.text user)</style></foreignObject></svg></math>);
  let t =
    Private.Template.make
      (Private.Template.element "math" [] [ Private.Template.element "foreignObject" [] [ Private.Template.part 0 ] ])
      ~html:"" ~walk:[||] ~kids:[||] ~attrs:[||] ~values:[||]
  in
  check_html "a template math > foreignObject" {|<math><foreignObject><style>&lt;b&gt;</style></foreignObject></math>|}
    (runtime_instance t [| runtime_child (element "style" [] [ text "<b>" ]) |]);
  check_html "tag case: SVG and Math are foreign" {|<SVG><STYLE>&lt;b&gt;</STYLE></SVG><Math><Script>&lt;b&gt;</Script></Math>|}
    (fragment [ element "SVG" [] [ element "STYLE" [] [ text "<b>" ] ]; element "Math" [] [ element "Script" [] [ text "<b>" ] ] ]);
  check_html "tag case: STYLE is raw text" {|<STYLE>a > b<\/style></STYLE>|} (element "STYLE" [] [ text "a > b</style>" ]);
  check_html "tag case: svg > FOREIGNOBJECT is HTML" {|<svg><FOREIGNOBJECT><style>a > b</style></FOREIGNOBJECT></svg>|}
    (element "svg" [] [ element "FOREIGNOBJECT" [] [ element "style" [] [ text "a > b" ] ] ]);
  let user = "<input autofocus onfocus=alert(1)>" in
  check_html "select > style is escaped" {|<select><style>&lt;input autofocus onfocus=alert(1)&gt;</style></select>|}
    (element "select" [] [ element "style" [] [ text user ] ]);
  check_html "select > option > script is escaped" {|<select><option><script>&lt;input autofocus onfocus=alert(1)&gt;</script></option></select>|}
    (element "select" [] [ element "option" [] [ element "script" [] [ text user ] ] ]);
  check_html "mlx: select > optgroup > style" {|<select><optgroup><style>&lt;input autofocus onfocus=alert(1)&gt;</style></optgroup></select>|}
    <select><optgroup><style>(Yuka.text user)</style></optgroup></select>;
  check_html "after select, raw again" {|<select></select><style>a > b</style>|}
    (fragment [ element "select" [] []; element "style" [] [ text "a > b" ] ]);
  check_html "text outside script is still escaped" {|<p>a &lt; b &amp;&amp; c</p>|} (element "p" [] [ text "a < b && c" ])

let raw_text_children () =
  raises "two texts" (fun () -> html (element "script" [] [ text "a"; text "b" ]));
  raises "an element" (fun () -> html (element "style" [] [ element "b" [] [] ]));
  raises "a hole that gives an element" (fun () -> print_client (element "script" [] [ hole (fun () -> element "b" [] []) ]));
  raises "two texts in svg" (fun () -> html (element "svg" [] [ element "style" [] [ text "a"; text "b" ] ]));
  raises "an element in math" (fun () -> html (element "math" [] [ element "script" [] [ element "b" [] [] ] ]));
  raises "two texts in SCRIPT" (fun () -> html (element "SCRIPT" [] [ text "a"; text "b" ]));
  let printed =
    match html (element "div" [] [ text "before"; Catch.make ~fallback:(fun ~error:_ ~reset:_ -> text "caught") ~children:(fun () -> element "script" [] [ text "a"; text "b" ]) () ]) with
    | s -> s
    | exception Invalid_argument _ -> "raised"
  in
  Alcotest.(check bool) "no partial script" false (Str_like.contains printed "<script")

let () =
  Alcotest.run "safety"
    [
      ( "urls",
        [
          Alcotest.test_case "script schemes, any case and clean-up, any URL attribute" `Quick script_schemes;
          Alcotest.test_case "data: only where it loads a document" `Quick data_scheme;
          Alcotest.test_case "the scheme check, value by value" `Quick scheme_table;
          Alcotest.test_case "unchecked constructors, dynamic and template attributes" `Quick printer_paths;
          Alcotest.test_case "mlx attributes and holes" `Quick mlx;
          Alcotest.test_case "attribute names" `Quick attribute_names;
          Alcotest.test_case "names of unchecked attributes, and hand-built names at print" `Quick unchecked_names;
          Alcotest.test_case "srcdoc" `Quick srcdoc;
          Alcotest.test_case "values, to, from and by outside animations" `Quick animation_names;
          Alcotest.test_case "hand-written templates" `Quick hand_written_template;
          Alcotest.test_case "tag names" `Quick tag_names;
          Alcotest.test_case "event handler names" `Quick event_names;
          Alcotest.test_case "base href" `Quick base_href;
        ] );
      ( "raw text",
        [
          Alcotest.test_case "script and style" `Quick raw_text;
          Alcotest.test_case "text and attribute escapes" `Quick escapes;
          Alcotest.test_case "only one text or one hole" `Quick raw_text_children;
        ] );
    ]
