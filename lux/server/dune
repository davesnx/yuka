(executable
 (name lux_server)
 (libraries lux_shared yuka yuka-dream dream)
 (preprocess
  (pps yuka.ppx)))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Lux_shared.Routes
    --source
    %{dep:../Routes.ml}))))
