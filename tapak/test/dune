(rule
 (targets routes.ml)
 (action
  (with-stdout-to
   routes.ml
   (run %{bin:yuka} routes --shared --source %{dep:tree/Routes.ml}))))

(rule
 (targets routes_server.ml)
 (action
  (with-stdout-to
   routes_server.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Routes
    --source
    %{dep:tree/Routes.ml}))))

(test
 (name run)
 (package yuka-tapak)
 (modules app routes routes_server run)
 (libraries alcotest yuka yuka-tapak tapak cows eio eio_main eio.unix http bytesrw logs unix))
