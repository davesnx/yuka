open Jsonkit.Primitives

let home () =
  Yuka.Server.page ~title:"Home" (fun () ->
      <main>
        <h1>"Yuka on tapak"</h1>
        <a href="/slow">"/slow"</a>
        <a href="/hello.json">"/hello.json"</a>
        <a href="/api/time">"/api/time"</a>
      </main>)

let slow () =
  Yuka.Server.page ~title:"Slow" (fun () ->
      let data =
        Yuka_tapak.async ~sw:(Yuka_tapak.switch ()) (fun () ->
            Eio_unix.sleep 1.;
            "loaded after one second")
      in
      <main>
        <h1>"Slow"</h1>
        <Yuka.Await async=data loading=(<p>"loading..."</p>)>
          (fun text -> <p>(Yuka.text text)</p>)
        </Yuka.Await>
      </main>)

type hello = { from : string } [@@deriving json]

let hello (_ : Tapak.Request.t) = Yuka.Server.json (hello_to_json { from = "yuka endpoint" })
let not_found ~path () = Yuka.Server.page ~title:"Missing" (fun () -> <p>(Yuka.text ("missing " ^ path))</p>)
