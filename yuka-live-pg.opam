# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A Postgres LISTEN/NOTIFY bus for the live data of Yuka"
description:
  "Server.Live.use_bus with Postgres: each server node of a Yuka app tells the other nodes that a live key changed through NOTIFY on one channel, and listens with LISTEN on its own connection."
maintainer: ["David Sancho Moreno"]
authors: ["David Sancho Moreno"]
license: "MIT"
homepage: "https://github.com/davesnx/yuka"
bug-reports: "https://github.com/davesnx/yuka/issues"
depends: [
  "dune" {>= "3.25"}
  "ocaml" {>= "5.4"}
  "yuka" {= version}
  "postgresql" {>= "5.0"}
  "lwt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/davesnx/yuka.git"
x-maintenance-intent: ["(latest)"]
