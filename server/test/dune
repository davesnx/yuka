(rule
 (targets routes.ml)
 (action
  (with-stdout-to
   routes.ml
   (run %{bin:yuka} routes --shared --source %{dep:tree/Routes.ml}))))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Routes
    --source
    %{dep:tree/Routes.ml}))))

(test
 (name run)
 (package yuka-server)
 (modules app routes yuka_routes ws run)
 (libraries alcotest yuka yuka-server ache lwt lwt.unix unix))
