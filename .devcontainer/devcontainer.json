{
  "name": "yuka",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "cacheFrom": "ghcr.io/davesnx/yuka-devcontainer"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "npm ci",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["ocamllabs.ocaml-platform"]
    }
  }
}
