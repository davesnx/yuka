let items = Yuka.Action.query ~name:"items" ~input:Yuka.Codec.unit ~output:(Yuka.Codec.list Yuka.Codec.string)

let[@client] make () =
  let r = Yuka.Remote.use items (fun () -> ()) in
  <ul>
    (Yuka.hole (fun () ->
         match Yuka.Remote.status r with
         | Yuka.Status.Ready { data; _ } -> Yuka.fragment (List.map (fun s -> <li>(Yuka.text s)</li>) data)
         | _ -> Yuka.empty))
  </ul>
