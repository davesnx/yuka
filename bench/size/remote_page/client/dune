(melange.emit
 (target out)
 (alias size-remote-page)
 (libraries size_remote_page yuka yuka.js)
 (preprocess
  (pps yuka.ppx melange.ppx))
 (module_systems
  (esm js)))

(rule
 (targets yuka_islands.ml)
 (deps
  (source_tree ../shared)
  (sandbox always))
 (action
  (with-stdout-to
   yuka_islands.ml
   (run %{bin:yuka} islands --dir ../shared))))
