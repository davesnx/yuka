open Ssr_data.Data
open Ssr_view

let () =
  let port, issues = args () in
  let styles = [ "/static/style.css" ] in
  let stream = Yuka_dream.handler (Yuka.Server.config ~styles ()) (stream_app issues) in
  Dream.run ~interface:"127.0.0.1" ~port
  @@ Dream.router
       [
         Dream.get "/" (fun _ -> Dream.html (Yuka.Server.document ~title:"Issues" ~styles (view issues)));
         Dream.get "/stream" stream;
       ]
