open Ssr_data.Data

module Row = struct
  let make ~issue:i () : Yuka.server Yuka.element =
    <li class_="issue">
      <a class_="row" href=("/issue/" ^ i.id)>
        <span class_="id">(Yuka.text i.id)</span>
        <span class_="title">(Yuka.text i.title)</span>
        <span class_=("status status-" ^ slug i.status)>(Yuka.text i.status)</span>
        <span class_="priority">(Yuka.text i.priority)</span>
        <span class_="assignee">(Yuka.text (Option.value i.assignee ~default:"Unassigned"))</span>
        <span class_="labels">
          (Yuka.fragment (List.map (fun l -> <span class_="label">(Yuka.text l)</span>) i.labels))
        </span>
      </a>
    </li>
end

let view issues () : Yuka.server Yuka.element =
  <main>
    <h1>"All issues"</h1>
    <ul class_="issues">(Yuka.fragment (List.map (fun issue -> <Row issue />) issues))</ul>
  </main>

let document ~title ~styles view =
  "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>" ^ title ^ "</title>"
  ^ String.concat "" (List.map (fun s -> "<link rel=\"stylesheet\" href=\"" ^ s ^ "\">") styles)
  ^ "</head><body>" ^ Yuka.Server.to_string view ^ "</body></html>"

let stream_app issues : Dream.request Yuka.Server.app =
  let open Yuka.Server.Generated in
  let fallback : fallback = { layers = []; not_found = default_not_found; error = default_error } in
  let rules = rules ~headers:[] ~prerender:false () in
  let plan : plan = { layers = []; page = Yuka.Server.page ~title:"Issues" (view issues) } in
  app ~build:"ssr" ~headers:[] ~prerender:[] ~pages:[ rules ]
    ~find:(fun meth segments _ ->
      match (meth, segments) with
      | (`GET | `HEAD), [ "stream" ] -> Yuka.Router.Found ()
      | _, [ "stream" ] -> Yuka.Router.Wrong_method [ `GET ]
      | _ -> Yuka.Router.Missing)
    ~resolve:(fun _ () ->
      Page { rules; guards = []; fallback; load = (fun () -> Yuka.Async.return (Ok plan)) })
    ~missing:fallback

