(* top: the summary of a machine and its processes, a new screen each second. The
   server renders the first screen; in the browser, [Machine.step] makes the next
   ones, and the keys of top sort, select, kill and quit. *)

open Machine

type column = { title : string; class_ : string; sort : sort option; key : string }

let columns =
  [
    { title = "PID"; class_ = "num"; sort = Some Pid; key = "N" };
    { title = "USER"; class_ = "user"; sort = None; key = "" };
    { title = "PR"; class_ = "num"; sort = None; key = "" };
    { title = "NI"; class_ = "num"; sort = None; key = "" };
    { title = "VIRT"; class_ = "num"; sort = None; key = "" };
    { title = "RES"; class_ = "num"; sort = None; key = "" };
    { title = "SHR"; class_ = "num"; sort = None; key = "" };
    { title = "S"; class_ = "state"; sort = None; key = "" };
    { title = "%CPU"; class_ = "num"; sort = Some Cpu; key = "P" };
    { title = "%MEM"; class_ = "num"; sort = Some Mem; key = "M" };
    { title = "TIME+"; class_ = "num"; sort = Some Time; key = "T" };
    { title = "COMMAND"; class_ = "command"; sort = Some Command; key = "C" };
  ]

let icon = Zed_ui.icon

let value text = <b class_="value">(Yuka.text text)</b>

let label text = <span class_="dim">(Yuka.text text)</span>

(* A part of a summary line: the number, bold, then its name. *)
let field ?(width = 5) number name =
  let number = if String.length number >= width then " " ^ number else pad width number in
  Yuka.fragment [ value number; label (" " ^ name) ]

let comma = label ","

let uptime_line (t : t) (host : host) =
  let l1, l5, l15 = t.load in
  <div class_="line">
    <span class_="dim">"top - "</span>
    (value (Machine.clock t.clock))
    (label (" up " ^ Machine.uptime t.uptime ^ ", "))
    (value (pad 2 (Int.to_string host.users)))
    (label (if host.users = 1 then " user,  load average: " else " users,  load average: "))
    (value (hundredths l1)) comma (value (" " ^ hundredths l5)) comma (value (" " ^ hundredths l15))
  </div>

let tasks_line (t : t) =
  let total = Array.length t.procs and running = Machine.running t in
  <div class_="line">
    <span class_="dim">"Tasks: "</span>
    (field ~width:3 (Int.to_string total) "total") comma
    (field ~width:4 (Int.to_string running) "running") comma
    (field ~width:4 (Int.to_string (total - running)) "sleeping") comma
    (field ~width:4 "0" "stopped") comma
    (field ~width:4 "0" "zombie")
  </div>

let cpu_text name (cpu : cpu) =
  <div class_="line">
    <span class_="dim">(Yuka.text name)</span>
    (field (tenths cpu.us) "us") comma (field (tenths cpu.sy) "sy") comma (field (tenths cpu.ni) "ni") comma
    (field (tenths cpu.id) "id") comma (field (tenths cpu.wa) "wa") comma (field (tenths cpu.hi) "hi") comma
    (field (tenths cpu.si) "si") comma (field "0.0" "st")
  </div>

let percent part = "width:" ^ tenths part ^ "%"

(* The bar of top's graph mode ([t]): user, system, nice and wait time. *)
let cpu_graph name (cpu : cpu) =
  let used = 1000 - cpu.id in
  <div class_="line graph">
    <span class_="dim">(Yuka.text name)</span>
    (value (pad 5 (tenths (cpu.us + cpu.ni)) ^ "/" ^ tenths cpu.sy))
    (value (pad 5 (Int.to_string ((used + 5) / 10))))
    <span class_="meter" aria_hidden=true>
      <span class_="fill us" style=(percent cpu.us) />
      <span class_="fill ni" style=(percent cpu.ni) />
      <span class_="fill sy" style=(percent cpu.sy) />
      <span class_="fill wa" style=(percent cpu.wa) />
    </span>
  </div>

let core_name i = "%Cpu" ^ Int.to_string i ^ String.make (if i < 10 then 3 else 2) ' ' ^ ": "

let cpu_lines ~graphs ~per_core (t : t) =
  let line = if graphs then cpu_graph else cpu_text in
  if per_core then
    <div class_=(if graphs then "cores graphs" else "cores")>
      (Yuka.fragment (Array.to_list (Array.mapi (fun i cpu -> line (core_name i) cpu) t.cores)))
    </div>
  else line "%Cpu(s): " t.total

let mem_lines ~graphs (t : t) (host : host) =
  let free = host.mem - t.used - t.cache in
  let swap_free = host.swap - t.swap_used in
  let avail = free + (t.cache * 4 / 5) in
  let share part whole = if whole = 0 then 0 else part * 1000 / whole in
  if graphs then
    Yuka.fragment
      [
        <div class_="line graph">
          <span class_="dim">"MiB Mem : "</span>
          (value (pad 5 (tenths (share t.used host.mem)) ^ "/" ^ tenths host.mem))
          <span class_="meter" aria_hidden=true>
            <span class_="fill used" style=(percent (share t.used host.mem)) />
            <span class_="fill cache" style=(percent (share t.cache host.mem)) />
          </span>
        </div>;
        <div class_="line graph">
          <span class_="dim">"MiB Swap: "</span>
          (value (pad 5 (tenths (share t.swap_used host.swap)) ^ "/" ^ tenths host.swap))
          <span class_="meter" aria_hidden=true>
            <span class_="fill swap" style=(percent (share t.swap_used host.swap)) />
          </span>
        </div>;
      ]
  else
    Yuka.fragment
      [
        <div class_="line">
          <span class_="dim">"MiB Mem : "</span>
          (field ~width:8 (tenths host.mem) "total") comma (field ~width:8 (tenths free) "free") comma
          (field ~width:8 (tenths t.used) "used") comma (field ~width:8 (tenths t.cache) "buff/cache")
        </div>;
        <div class_="line">
          <span class_="dim">"MiB Swap: "</span>
          (field ~width:8 (tenths host.swap) "total") comma (field ~width:8 (tenths swap_free) "free") comma
          (field ~width:8 (tenths t.swap_used) "used.") (field ~width:8 (tenths avail) "avail Mem")
        </div>;
      ]

let heat cpu = if cpu >= 500 then "cell num hot" else if cpu >= 100 then "cell num warm" else "cell num"

let row ~selected ~on_select ~(me : string) (p : proc) =
  let classes =
    String.concat " "
      (List.concat [ [ "proc" ]; (if p.state = 'R' then [ "running" ] else []); (if p.user = me then [ "mine" ] else []) ])
  in
  <div id=("pid-" ^ Int.to_string p.pid)
    class_=(if Yuka.State.get selected = Some p.pid then classes ^ " selected" else classes)
    role=`row data_pid=(Int.to_string p.pid)
    aria_selected=(Yuka.State.get selected = Some p.pid)
    on_click=(fun _ -> on_select p.pid)>
    <span class_="cell num pid" role=`cell>(Yuka.text (Int.to_string p.pid))</span>
    <span class_="cell user" role=`cell>(Yuka.text (user p.user))</span>
    <span class_="cell num" role=`cell>(Yuka.text (Int.to_string p.pr))</span>
    <span class_="cell num" role=`cell>(Yuka.text (Int.to_string p.ni))</span>
    <span class_="cell num" role=`cell>(Yuka.text (kib p.virt))</span>
    <span class_="cell num" role=`cell>(Yuka.text (kib p.res))</span>
    <span class_="cell num" role=`cell>(Yuka.text (kib p.shr))</span>
    <span class_=("cell state state-" ^ String.make 1 p.state) role=`cell>(Yuka.text (String.make 1 p.state))</span>
    <span class_=(heat p.cpu) role=`cell>(Yuka.text (tenths p.cpu))</span>
    <span class_="cell num" role=`cell>(Yuka.text (tenths p.mem))</span>
    <span class_="cell num" role=`cell>(Yuka.text (Machine.time p.time))</span>
    <span class_="cell command" role=`cell>(Yuka.text p.command)</span>
  </div>

(* The keys of the bar under the screen; a click does what the key does. *)
let keys =
  [
    ("P", "%CPU");
    ("M", "%MEM");
    ("T", "TIME+");
    ("N", "PID");
    ("R", "reverse");
    ("t", "graphs");
    ("1", "cores");
    ({js|↑↓|js}, "select");
    ("k", "kill");
    ("Space", "pause");
    ("q", "quit");
  ]

let[@client] make ~(host : string) () =
  let machine = match Machine.find host with Some machine -> machine | None -> Machine.laptop in
  let snapshot = Yuka.State.make (Machine.start machine) in
  let sort = Yuka.State.make Cpu in
  let reverse = Yuka.State.make false in
  let graphs = Yuka.State.make true in
  let per_core = Yuka.State.make false in
  let paused = Yuka.State.make false in
  let quit = Yuka.State.make false in
  let selected = Yuka.State.make ~equal:( = ) None in
  let message = Yuka.State.make "" in
  let rows =
    Yuka.State.memo (fun () ->
        Machine.sorted ~sort:(Yuka.State.get sort) ~reverse:(Yuka.State.get reverse) (Yuka.State.get snapshot))
  in
  let tick () = Yuka.State.update snapshot Machine.step in
  let sort_by column =
    if Yuka.State.peek sort = column then Yuka.State.update reverse not
    else begin
      Yuka.State.set sort column;
      Yuka.State.set reverse false
    end
  in
  let move step =
    let list = Yuka.State.peek rows in
    let size = Array.length list in
    if size > 0 then begin
      let index =
        match Yuka.State.peek selected with
        | None -> if step > 0 then 0 else size - 1
        | Some pid ->
            let rec find i = if i >= size then 0 else if list.(i).pid = pid then i else find (i + 1) in
            clamp 0 (size - 1) (find 0 + step)
      in
      let pid = list.(index).pid in
      Yuka.State.set selected (Some pid);
      Yuka.Browser.scroll_into_view ("pid-" ^ Int.to_string pid)
    end
  in
  let kill () =
    match Yuka.State.peek selected with
    | None -> Yuka.State.set message "Select a process with the arrows or a click, then press k."
    | Some pid -> (
        match Array.to_list (Yuka.State.peek snapshot).procs |> List.find_opt (fun p -> p.pid = pid) with
        | None -> Yuka.State.set selected None
        | Some p when p.user <> machine.user_name ->
            Yuka.State.set message
              ("Failed signal pid '" ^ Int.to_string pid ^ "' with '15': Operation not permitted")
        | Some p ->
            Yuka.State.update snapshot (fun t -> Machine.kill t pid);
            Yuka.State.set selected None;
            if String.length p.command >= 3 && String.sub p.command 0 3 = "top" then Yuka.State.set quit true
            else Yuka.State.set message ("Sent signal SIGTERM to pid " ^ Int.to_string pid ^ " (" ^ p.command ^ ")"))
  in
  let toggle_pause () =
    Yuka.State.update paused not;
    Yuka.State.set message (if Yuka.State.peek paused then "Paused. Press Space to go on." else "")
  in
  let press key =
    match key with
    | "P" -> sort_by Cpu
    | "M" -> sort_by Mem
    | "T" -> sort_by Time
    | "N" -> sort_by Pid
    | "C" -> sort_by Command
    | "R" -> Yuka.State.update reverse not
    | "t" -> Yuka.State.update graphs not
    | "1" -> Yuka.State.update per_core not
    | "ArrowDown" | "j" -> move 1
    | "ArrowUp" -> move (-1)
    | "k" -> kill ()
    | " " | "Space" -> toggle_pause ()
    | "Enter" -> tick ()
    | "q" -> Yuka.State.set quit true
    | "Escape" -> Yuka.State.set selected None
    | _ -> ()
  in
  let restart _ =
    Yuka.State.set snapshot (Machine.start machine);
    Yuka.State.set selected None;
    Yuka.State.set message "";
    Yuka.State.set paused false;
    Yuka.State.set quit false
  in
  Yuka.Effect.after (fun () ->
      let last = ref (Yuka.Browser.now ()) in
      Yuka.Browser.on_frame (fun now ->
          if now -. !last >= Float.of_int (Machine.delay * 1000) then begin
            last := now;
            if not (Yuka.State.peek paused || Yuka.State.peek quit) then tick ()
          end);
      Yuka.Browser.on_window "keydown" (fun event ->
          let key = Yuka.Event.key event in
          let modified = Yuka.Event.ctrl_key event || Yuka.Event.meta_key event || Yuka.Event.alt_key event in
          let known =
            match key with
            | "P" | "M" | "T" | "N" | "C" | "R" | "t" | "1" | "ArrowDown" | "ArrowUp" | "j" | "k" | " " | "Enter"
            | "q" | "Escape" ->
                true
            | _ -> false
          in
          (* Space and Enter on a focused button press the button. *)
          let on_button = Yuka.Event.target_tag event = "BUTTON" && (key = " " || key = "Enter") in
          if known && (not modified) && (not on_button) && not (Yuka.State.peek quit) then begin
            Yuka.Event.prevent_default event;
            press key
          end));
  <div class_="terminal">
    (if Yuka.State.get quit then
       <div class_="screen exited">
         <span>(Yuka.text ("top exited. " ^ machine.user_name ^ "@" ^ machine.name ^ ":~$"))</span>
         <button class_="button" type_=`button on_click=restart>"Start again"</button>
       </div>
     else
       <div class_="screen">
         <div class_="summary" aria_label="Summary">
           (uptime_line (Yuka.State.get snapshot) machine)
           (tasks_line (Yuka.State.get snapshot))
           (cpu_lines ~graphs:(Yuka.State.get graphs) ~per_core:(Yuka.State.get per_core) (Yuka.State.get snapshot))
           (mem_lines ~graphs:(Yuka.State.get graphs) (Yuka.State.get snapshot) machine)
         </div>
         <div class_="message" role=`status>(Yuka.text (Yuka.State.get message))</div>
         <div class_="procs" role=`table aria_label="Processes">
           <div class_="proc head" role=`row>
             (Yuka.fragment
                (List.map
                   (fun column ->
                     match column.sort with
                     | None -> <span class_=("cell " ^ column.class_) role=`columnheader>(Yuka.text column.title)</span>
                     | Some by ->
                         let on = Yuka.State.get sort = by in
                         <button
                           class_=("cell sortable " ^ column.class_ ^ if on then " on" else "")
                           type_=`button tabindex=(-1) role=`columnheader
                           aria_sort=(if not on then `none
                             else if (by = Command) <> Yuka.State.get reverse then `ascending
                             else `descending)
                           title=("Sort by " ^ column.title ^ " (" ^ column.key ^ ")")
                           on_click=(fun _ -> sort_by by)>
                           (Yuka.text column.title)
                           (if on then icon (if (by = Command) <> Yuka.State.get reverse then "arrow_up" else "arrow_down")
                            else Yuka.empty)
                         </button>)
                   columns))
           </div>
           (Yuka.each ~key:(fun (p : proc) -> Int.to_string p.pid)
              (fun () -> Yuka.State.get rows)
              (fun p ->
                row ~selected ~me:machine.user_name
                  ~on_select:(fun pid -> Yuka.State.set selected (Some pid))
                  p))
         </div>
       </div>)
    <div class_="keybar" aria_label="Keys">
      (Yuka.fragment
         (List.map
            (fun (key, name) ->
              let on =
                match key with
                | "t" -> Yuka.State.get graphs
                | "1" -> Yuka.State.get per_core
                | "R" -> Yuka.State.get reverse
                | "Space" -> Yuka.State.get paused
                | _ -> false
              in
              <button class_=(if on then "key on" else "key") type_=`button tabindex=(-1)
                on_click=(fun _ -> if key = {js|↑↓|js} then move 1 else press key)>
                <kbd>(Yuka.text key)</kbd>(Yuka.text name)
              </button>)
            keys))
      <span class_="spacer" />
      <span class_="live">
        (icon (if Yuka.State.get paused then "debug_pause" else "play_filled"))
        (Yuka.text (if Yuka.State.get paused then "paused" else "every " ^ Int.to_string Machine.delay ^ " s"))
      </span>
    </div>
  </div>
