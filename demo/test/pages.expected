on-button" aria-label="Change priority"><svg class="icon priority-none" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-18</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-canceled" viewBox="0 0 14 14" width="14" height="14"><path d="M5 5 L9 9 M9 5 L5 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-18">Cancel the board view</a><span class="labels"><span class="label label-design">design</span></span><span class="avatar empty" title="Unassigned">?</span><span class="row-date">Oct 18</span></div><div id="row-YUK-21" class="row" data-id="YUK-21"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-none" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-21</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-canceled" viewBox="0 0 14 14" width="14" height="14"><path d="M5 5 L9 9 M9 5 L5 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-21">Duplicate of YUK-9</a><span class="labels"><span class="label label-bug">bug</span></span><span class="avatar empty" title="Unassigned">?</span><span class="row-date">Oct 29</span></div><!--]--></section></div><!--[--><!--]--><!--[--><!--]--></div></yuka-island><script type="application/json" data-yuka-answer="l:csrf">{"ok":"TOKEN"}</script><script type="application/json" data-yuka-answer="l:issues &quot;All&quot;">{"ok":[{"id":"YUK-1","title":"Hydration mismatch on nested holes","description":"A hole inside an each item loses its marker when the item is empty. Reproduce with a filter that matches nothing, then clear it.","status":"In_progress","priority":"Urgent","assignee":{"id":"maya","name":"Maya Chen"},"labels":["bug","client"],"created_at":"Nov 2"},{"id":"YUK-2","title":"Stream comments after the shell","description":"Send the shell first and the comments later in the same response, with out of order placement.","status":"In_progress","priority":"High","assignee":{"id":"dev","name":"Dev Patel"},"labels":["feature","server"],"created_at":"Nov 2"},{"id":"YUK-3","title":"Keyboard navigation in the issue list","description":"j and k move the selection, Enter opens the issue. Ignore keys while the filter has focus.","status":"Done","priority":"Medium","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["feature"],"created_at":"Oct 30"},{"id":"YUK-4","title":"Status menu closes on outside click","description":"The menu stays open when the user clicks the page. Use a backdrop.","status":"Todo","priority":"Medium","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["bug"],"created_at":"Nov 3"},{"id":"YUK-5","title":"Decode props of islands","description":"The client reads the JSON script of each island and decodes the props with the codec.","status":"Todo","priority":"High","assignee":{"id":"dev","name":"Dev Patel"},"labels":["feature","codec"],"created_at":"Nov 3"},{"id":"YUK-6","title":"Document the ppx attribute checks","description":"List the valid attributes and the error messages.","status":"Backlog","priority":"Low","assignee":null,"labels":["docs"],"created_at":"Oct 28"},{"id":"YUK-7","title":"Escape attribute values with quotes","description":"A quote in a title attribute broke the markup.","status":"Done","priority":"High","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["bug","server"],"created_at":"Oct 27"},{"id":"YUK-8","title":"Add a new issue dialog","description":"Press c to open a dialog with title and description.","status":"Todo","priority":"Medium","assignee":{"id":"maya","name":"Maya Chen"},"labels":["feature"],"created_at":"Nov 4"},{"id":"YUK-9","title":"Keyed list moves lose focus","description":"Moving an item in a keyed list recreates its DOM when the key stays.","status":"Backlog","priority":"High","assignee":null,"labels":["bug","client"],"created_at":"Nov 1"},{"id":"YUK-10","title":"Server action for status change","description":"POST the new status and answer with the updated issue.","status":"Todo","priority":"High","assignee":{"id":"dev","name":"Dev Patel"},"labels":["feature","server"],"created_at":"Nov 4"},{"id":"YUK-11","title":"Optimistic update rolls back on error","description":"Show the new status now and restore the old one when the action fails.","status":"Backlog","priority":"Medium","assignee":null,"labels":["feature"],"created_at":"Nov 4"},{"id":"YUK-12","title":"Dark theme contrast on labels","description":"Raise the contrast of label text on the dark background.","status":"Done","priority":"Low","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["design"],"created_at":"Oct 25"},{"id":"YUK-13","title":"Sidebar collapses on small screens","description":"Hide the sidebar under 700px.","status":"Backlog","priority":"Low","assignee":null,"labels":["design"],"created_at":"Oct 24"},{"id":"YUK-14","title":"Effects must not run on the server","description":"Component bodies run with effects off during rendering.","status":"Done","priority":"Urgent","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["bug","server"],"created_at":"Oct 22"},{"id":"YUK-15","title":"Priority icons for each level","description":"Four bars, filled by level.","status":"Done","priority":"Low","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["design"],"created_at":"Oct 21"},{"id":"YUK-16","title":"Assign issues from the page","description":"A menu on the properties panel to change the assignee.","status":"Backlog","priority":"Medium","assignee":null,"labels":["feature"],"created_at":"Nov 5"},{"id":"YUK-17","title":"Label filter in the list","description":"Filter by label next to the title filter.","status":"Backlog","priority":"Low","assignee":null,"labels":["feature"],"created_at":"Nov 5"},{"id":"YUK-18","title":"Cancel the board view","description":"Out of scope for v0.1.","status":"Canceled","priority":"No_priority","assignee":null,"labels":["design"],"created_at":"Oct 18"},{"id":"YUK-19","title":"Slow first byte on the issue page","description":"The page waits for every comment before it sends the first byte.","status":"In_progress","priority":"Medium","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["perf","server"],"created_at":"Nov 5"},{"id":"YUK-20","title":"Bundle size of the client entry","description":"Measure the emitted modules and remove what the page does not use.","status":"Todo","priority":"Medium","assignee":{"id":"dev","name":"Dev Patel"},"labels":["perf","client"],"created_at":"Nov 5"},{"id":"YUK-21","title":"Duplicate of YUK-9","description":"Closed as duplicate.","status":"Canceled","priority":"No_priority","assignee":null,"labels":["bug"],"created_at":"Oct 29"},{"id":"YUK-22","title":"Show relative dates","description":"Show 3 days ago and keep the full date in the title.","status":"Backlog","priority":"Low","assignee":null,"labels":["design"],"created_at":"Nov 6"},{"id":"YUK-23","title":"Empty state for the filter","description":"Show a message when no issue matches.","status":"Done","priority":"Low","assignee":{"id":"maya","name":"Maya Chen"},"labels":["design"],"created_at":"Oct 26"},{"id":"YUK-24","title":"Reconnect after server restart","description":"The client shows an error and retries the action.","status":"Backlog","priority":"Medium","assignee":null,"labels":["server"],"created_at":"Nov 6"},{"id":"YUK-25","title":"Write the release notes","description":"Summarize what v0.1 includes.","status":"Todo","priority":"No_priority","assignee":{"id":"maya","name":"Maya Chen"},"labels":["docs"],"created_at":"Nov 6"}]}</script><script type="application/json" data-yuka-answer="r:labels null">{"ok":[{"label":"bug","open_":3},{"label":"client","open_":3},{"label":"codec","open_":1},{"label":"design","open_":2},{"label":"docs","open_":2},{"label":"feature","open_":7},{"label":"perf","open_":2},{"label":"server","open_":4}]}</script><script type="application/json" data-yuka-props="i3">{"title":"All issues","view":"All"}</script></yuka-outlet></main></div></body></html>
