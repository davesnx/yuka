"comment-body"><div class="comment-meta"><b>Tomas Novak</b><span class="muted">Nov 3</span></div><p>Please add a test with an empty filter result.</p></div></li></ul><div class="comment-box"><textarea class="comment-input" placeholder="Leave a comment" rows="3"></textarea><!--[--><!--]--><button class="button primary" disabled="">Comment</button></div></div></yuka-island><script type="application/json" data-yuka-props="i7">{"issue_id":"YUK-1","me":{"id":"maya","name":"Maya Chen"},"comments":[{"id":"c1","author":{"id":"dev","name":"Dev Patel"},"body":"I can reproduce it. The marker after the empty item is missing.","created_at":"Nov 2"},{"id":"c2","author":{"id":"maya","name":"Maya Chen"},"body":"Found it: the printer skips the closing marker. Working on a fix.","created_at":"Nov 3"},{"id":"c3","author":{"id":"tomas","name":"Tomas Novak"},"body":"Please add a test with an empty filter result.","created_at":"Nov 3"}]}</script></template><script>__yukaFill("s1")</script><script type="application/json" data-yuka-async="a1">{"ok":[{"id":"YUK-4","workspace":"Yuka","title":"Status menu closes on outside click","description":"The menu stays open when the user clicks the page. Use a backdrop.","status":"Todo","priority":"Medium","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["bug"],"created_at":"Nov 3"},{"id":"YUK-7","workspace":"Yuka","title":"Escape attribute values with quotes","description":"A quote in a title attribute broke the markup.","status":"Done","priority":"High","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["bug","server"],"created_at":"Oct 27"},{"id":"YUK-9","workspace":"Yuka","title":"Keyed list moves lose focus","description":"Moving an item in a keyed list recreates its DOM when the key stays.","status":"Backlog","priority":"High","assignee":null,"labels":["bug","client"],"created_at":"Nov 1"},{"id":"YUK-14","workspace":"Yuka","title":"Effects must not run on the server","description":"Component bodies run with effects off during render