d">YUK-23</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-done" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="6.5" fill="currentColor"></circle><path d="M4.5 7.2 L6.4 9 L9.6 5.2" fill="none" stroke="#fff" stroke-width="1.5"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-23">Empty state for the filter</a><span class="labels"><span class="label label-design">design</span></span><span class="wrap_3b780164"><button class="trigger_3b780164" popovertarget="user-YUK-23" aria-haspopup="dialog" aria-label="Maya Chen"><span class="avatar" title="Maya Chen">MC</span></button><!--[--><!--]--></span><span class="row-date">Oct 26</span></div><!--]--></section><section class="group"><header class="group-header"><svg class="icon status-canceled" viewBox="0 0 14 14" width="14" height="14"><path d="M5 5 L9 9 M9 5 L5 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg><span class="group-name">Canceled</span><span class="group-count">2</span></header><!--[--><div id="row-YUK-18" class="row" data-id="YUK-18"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-none" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-18</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-canceled" viewBox="0 0 14 14" width="14" height="14"><path d="M5 5 L9 9 M9 5 L5 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-18">Cancel the board view</a><span class="labels"><span class="label label-design">design</span></span><span class="avatar empty" title="Unassigned">?</span><span class="row-date">Oct 18</span></div><div id="row-YUK-21" class="row" data-id="YUK-21"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-none" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-21</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-canceled" viewBox="0 0 14 14" width="14" height="14"><path d="M5 5 L9 9 M9 5 L5 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-21">Duplicate of YUK-9</a><span class="labels"><span class="label label-bug">bug</span></span><span class="avatar empty" title="Unassigned">?</span><span class="row-date">Oct 29</span></div><!--]--></section></div><!--[--><!--]--><!--[--><!--]--></div></yuka-island><script type="application/json" data-yuka-answer="l:csrf">{"ok":"TOKEN"}</script><script type="application/json" data-yuka-answer="l:issues {&quot;workspace&quot;:&quot;Yuka&quot;,&quot;view&quot;:&quot;All&quot;}">{"ok":[{"id":"YUK-1","workspace":"Yuka","title":"Hydration mismatch on nested holes","description":"A hole inside an `each` item loses its marker when the item is empty. Reproduce with a filter that matches nothing, then clear it.\n\n## Steps\n\n1. Open the issue list.\n2. Type `zzz` in the filter: no row matches.\n3. Clear the filter.\n\nThe rows come back, but the **first hole** of each row no longer updates.\n\n## Cause\n\nThe printer writes the closing marker only when the item has children:\n\n```ocaml\nlet print_hole buffer ~children =\n  Buffer.add_string buffer \"\u003c!--[-->\";\n  List.iter (print buffer) children;\n  if children \u003c> [] then Buffer.add_string buffer \"\u003c!--]-->\"\n```\n\n> The client looks for the closing marker to know where the hole ends. With no marker it takes the next sibling.\n\nSee the [hydration notes](https://github.com/davesnx/yuka/blob/main/docs/islands.md) for the marker format.","status":"In_progress","priority":"Urgent","assignee":{"id":"maya","name":"Maya Chen"},"labels":["bug","client"],"created_at":"Nov 2"},{"id":"YUK-2","workspace":"Yuka","title":"Stream comments after the shell","description":"Send the shell first and the comments later in the same response, with out of order placement.\n\n| Part | Sent | Placed by |\n| --- | --- | --- |\n| Shell | first chunk | the HTML parser |\n| Comments | when the query ends | `__yukaFill` |\n| Related issues | last | `__yukaFill` |\n\nThe fill script moves each part into its slot:\n\n```javascript\nfunction fill(id) {\n  const template = document.getElementById(`yuka-fill-${id}`);\n  const slot = document.querySelector(`[data-yuka-slot=\"${id}\"]`);\n  slot.replaceWith(template.content);\n}\n```","status":"In_progress","priority":"High","assignee":{"id":"dev","name":"Dev Patel"},"labels":["feature","server"],"created_at":"Nov 2"},{"id":"YUK-3","workspace":"Yuka","title":"Keyboard navigation in the issue list","description":"j and k move the selection, Enter opens the issue. Ignore keys while the filter has focus.","status":"Done","priority":"Medium","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["feature"],"created_at":"Oct 30"},{"id":"YUK-4","workspace":"Yuka","title":"Status menu closes on outside click","description":"The menu stays open when the user clicks the page. Use a backdrop.","status":"Todo","priority":"Medium","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["bug"],"created_at":"Nov 3"},{"id":"YUK-5","workspace":"Yuka","title":"Decode props of islands","description":"The client reads the JSON script of each island and decodes the props with the codec.\n\nThe server prints the props next to the island:\n\n```json\n{\n  \"issue_id\": \"YUK-5\",\n  \"me\": { \"id\": \"maya\", \"name\": \"Maya Chen\" },\n  \"comments\": []\n}\n```\n\nThe client decodes them with the codec of the props:\n\n```ocaml\ntype props = { issue_id : string; me : User.t }\n\nlet decode json =\n  match Yuka.Codec.decode props_codec json with\n  | Ok props -> render props\n  | Error message -> Console.error message\n```\n\n- [x] Records and variants\n- [x] Lists and options\n- [ ] Recursive types","status":"Todo","priority":"High","assignee":{"id":"dev","name":"Dev Patel"},"labels":["feature","codec"],"created_at":"Nov 3"},{"id":"YUK-6","workspace":"Yuka","title":"Document the ppx attribute checks","description":"List the valid attributes and the error messages.","status":"Backlog","priority":"Low","assignee":null,"labels":["docs"],"created_at":"Oct 28"},{"id":"YUK-7","workspace":"Yuka","title":"Escape attribute values with quotes","description":"A quote in a title attribute broke the markup.","status":"Done","priority":"High","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["bug","server"],"created_at":"Oct 27"},{"id":"YUK-8","workspace":"Yuka","title":"Add a new issue dialog","description":"Press c to open a dialog with title and description.","status":"Todo","priority":"Medium","assignee":{"id":"maya","name":"Maya Chen"},"labels":["feature"],"created_at":"Nov 4"},{"id":"YUK-9","workspace":"Yuka","title":"Keyed list moves lose focus","description":"Moving an item in a keyed list recreates its DOM when the key stays.","status":"Backlog","priority":"High","assignee":null,"labels":["bug","client"],"created_at":"Nov 1"},{"id":"YUK-10","workspace":"Yuka","title":"Server action for status change","description":"POST the new status and answer with the updated issue.\n\n```shell\ncurl -X POST http://localhost:8080/_yuka/action/update_issue \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"id\":\"YUK-4\",\"status\":\"Done\"}'\n```\n\nThe answer is the issue as JSON. A missing issue answers `422` with the message *No issue YUK-4*.","status":"Todo","priority":"High","assignee":{"id":"dev","name":"Dev Patel"},"labels":["feature","server"],"created_at":"Nov 4"},{"id":"YUK-11","workspace":"Yuka","title":"Optimistic update rolls back on error","description":"Show the new status now and restore the old one when the action fails.","status":"Backlog","priority":"Medium","assignee":null,"labels":["feature"],"created_at":"Nov 4"},{"id":"YUK-12","workspace":"Yuka","title":"Dark theme contrast on labels","description":"Raise the contrast of label text on the dark background.\n\n```css\n.label {\n  color: #c4c4cc;\n  background: rgba(255, 255, 255, 0.06);\n  border: 1px solid #34343c;\n}\n```\n\nThe new pair passes **WCAG AA** (4.6:1).","status":"Done","priority":"Low","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["design"],"created_at":"Oct 25"},{"id":"YUK-13","workspace":"Yuka","title":"Sidebar collapses on small screens","description":"Hide the sidebar under 700px.","status":"Backlog","priority":"Low","assignee":null,"labels":["design"],"created_at":"Oct 24"},{"id":"YUK-14","workspace":"Yuka","title":"Effects must not run on the server","description":"Component bodies run with effects off during rendering.","status":"Done","priority":"Urgent","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["bug","server"],"created_at":"Oct 22"},{"id":"YUK-15","workspace":"Yuka","title":"Priority icons for each level","description":"Four bars, filled by level.","status":"Done","priority":"Low","assignee":{"id":"sofia","name":"Sofia Rossi"},"labels":["design"],"created_at":"Oct 21"},{"id":"YUK-16","workspace":"Yuka","title":"Assign issues from the page","description":"A menu on the properties panel to change the assignee.","status":"Backlog","priority":"Medium","assignee":null,"labels":["feature"],"created_at":"Nov 5"},{"id":"YUK-17","workspace":"Yuka","title":"Label filter in the list","description":"Filter by label next to the title filter.","status":"Backlog","priority":"Low","assignee":null,"labels":["feature"],"created_at":"Nov 5"},{"id":"YUK-18","workspace":"Yuka","title":"Cancel the board view","description":"Out of scope for v0.1.","status":"Canceled","priority":"No_priority","assignee":null,"labels":["design"],"created_at":"Oct 18"},{"id":"YUK-19","workspace":"Yuka","title":"Slow first byte on the issue page","description":"The page waits for every comment before it sends the first byte.\n\n### Measurements\n\n| Page | First byte | Full page |\n| :--- | ---: | ---: |\n| `/issue/YUK-1` | 82 ms | 140 ms |\n| `/w/stress` | 96 ms | 310 ms |\n\nReproduce with:\n\n```sh\nfor i in 1 2 3; do\n  curl -s -o /dev/null -w '%{time_starttransfer}\\n' http://localhost:8080/issue/YUK-1\ndone\n```\n\n---\n\nNext: stream the comments with `Yuka.Await`, as in YUK-2.","status":"In_progress","priority":"Medium","assignee":{"id":"tomas","name":"Tomas Novak"},"labels":["perf","server"],"created_at":"Nov 5"},{"id":"YUK-20","workspace":"Yuka","title":"Bundle size of the client entry","description":"Measure the emitted modules and remove what the page does not use.\n\n```typescript\nimport { build } from \"esbuild\";\n\nconst result = await build({\n  entryPoints: [\"demo/client/main.js\"],\n  bundle: true,\n  metafile: true,\n  write: false,\n});\nfor (const [file, info] of Object.entries(result.metafile.outputs)) {\n  console.log(file, info.bytes);\n}\n```\n\nRun `make size` to check the budget in `bench/size/budget.json`.","status":"Todo","priority":"Medium","assignee":{"id":"dev","name":"Dev Patel"},"labels":["perf","client"],"created_at":"Nov 5"},{"id":"YUK-21","workspace":"Yuka","title":"Duplicate of YUK-9","description":"Closed as duplicate.","status":"Canceled","priority":"No_priority","assignee":null,"labels":["bug"],"created_at":"Oct 29"},{"id":"YUK-22","workspace":"Yuka","title":"Show relative dates","description":"Show 3 days ago and keep the full date in the title.","status":"Backlog","priority":"Low","assignee":null,"labels":["design"],"created_at":"Nov 6"},{"id":"YUK-23","workspace":"Yuka","title":"Empty state for the filter","description":"Show a message when no issue matches.","status":"Done","priority":"Low","assignee":{"id":"maya","name":"Maya Chen"},"labels":["design"],"created_at":"Oct 26"},{"id":"YUK-24","workspace":"Yuka","title":"Reconnect after server restart","description":"The client shows an error and retries the action.","status":"Backlog","priority":"Medium","assignee":null,"labels":["server"],"created_at":"Nov 6"},{"id":"YUK-25","workspace":"Yuka","title":"Write the release notes","description":"Summarize what v0.1 includes.\n\n# Yuka v0.1\n\n- Server pages with **islands**\n- Client navigation and prefetch\n- Forms that work with JavaScript off\n- Live updates over a socket\n\n## To do\n\n- [x] Collect the changes from `CHANGES.md`\n- [ ] Write the upgrade notes\n- [ ] Publish on [opam](https://opam.ocaml.org)","status":"Todo","priority":"No_priority","assignee":{"id":"maya","name":"Maya Chen"},"labels":["docs"],"created_at":"Nov 6"}]}</script><script type="application/json" data-yuka-answer="r:labels &quot;Yuka&quot;">{"ok":[{"label":"bug","open_":3},{"label":"client","open_":3},{"label":"codec","open_":1},{"label":"design","open_":2},{"label":"docs","open_":2},{"label":"feature","open_":7},{"label":"perf","open_":2},{"label":"server","open_":4}]}</script><script type="application/json" data-yuka-props="i4">{"workspace":"Yuka","title":"All issues","view":"All","query":"","chosen":[]}</script></yuka-outlet></main></div></div></body></html>
==== /my 200
