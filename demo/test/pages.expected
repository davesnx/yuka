class="icon priority-low" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar on"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-13</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-backlog" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-13">Sidebar collapses on small screens</a><span class="labels"><span class="label label-design">design</span></span><span class="avatar empty" title="Unassigned">?</span><span class="row-date">Oct 24</span></div><div id="row-YUK-16" class="row" data-id="YUK-16"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-medium" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar on"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar on"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-16</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-backlog" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-16">Assign issues from the page</a><span class="labels"><span class="label label-feature">feature</span></span><span class="avatar empty" title="Unassigned">?</span><span class="row-date">Nov 5</span></div><div id="row-YUK-17" class="row" data-id="YUK-17"><span class="status-wrap"><button class="icon-button" aria