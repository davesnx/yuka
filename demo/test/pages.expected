 class="nav-link" href="/insights">Insights</a><a class="nav-link" href="/report">Report</a><a class="nav-link" href="/canvas">Canvas</a></nav><div class="sidebar-extra"><yuka-island data-name="Demo_shared.New_issue" data-id="i3" style="display:contents"><div class="new-issue"><button class="new-issue-button">+ New issue (c)</button><!--[--><!--]--></div></yuka-island><script type="application/json" data-yuka-props="i3">{"workspace":"Yuka"}</script></div></aside><main class="main"><yuka-outlet data-k="L0" style="display:contents"><link rel="stylesheet" href="/_yuka/css/issue_list-b38e7566.css" data-yuka-css><link rel="stylesheet" href="/_yuka/css/user_popup-3b780164.css" data-yuka-css><yuka-island data-name="Demo_shared.Issue_list" data-id="i4" style="display:contents"><div class="issues"><header class="page-header"><span>My issues</span><span class="group-count">4</span><!--[--><!--]--></header><div class="toolbar"><input class="filter" type="text" placeholder="Filter issues (j/k to move, Enter to open)" value=""><!--[--><div class="bar_b38e7566"><div class="chips"><button class="chip" aria-pressed="false" data-label="bug" type="button">bug<!----> <span class="chip-count">3</span></button><button class="chip" aria-pressed="false" data-label="client" type="button">client<!----> <span class="chip-count">3</span></button><button class="chip" aria-pressed="false" data-label="codec" type="button">codec<!----> <span class="chip-count">1</span></button><button class="chip" aria-pressed="false" data-label="design" type="button">design<!----> <span class="chip-count">2</span></button><button class="chip" aria-pressed="false" data-label="docs" type="button">docs<!----> <span class="chip-count">2</span></button><button class="chip" aria-pressed="false" data-label="feature" type="button">feature<!----> <span class="chip-count">7</span></button><button class="chip" aria-pressed="false" data-label="perf" type="button">perf<!----> <span class="chip-count">2</span></button><button class="chip" aria-pressed="false" data-label="server" type="button">server<!----> <span class="chip-count">4</span></button></div><button id="labels-button" class="more_b38e7566" type="button" popovertarget="labels-menu" aria-haspopup="menu" aria-label="All labels, 8" data-chosen="0"><svg class="icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="3" cy="8" r="1.5" fill="currentColor"></circle><circle cx="8" cy="8" r="1.5" fill="currentColor"></circle><circle cx="13" cy="8" r="1.5" fill="currentColor"></circle></svg><span class="total_b38e7566" aria-hidden="true">8</span></button><!--[--><!--]--></div><!--]--></div><!--[--><!--]--><div class="list"><section class="group"><header class="group-header"><svg class="icon status-in-progress" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M7 3.5 A3.5 3.5 0 0 1 7 10.5 Z" fill="currentColor"></path></svg><span class="group-name">In Progress</span><span class="group-count">1</span></header><!--[--><div id="row-YUK-1" class="row" data-id="YUK-1"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-urgent" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar on"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar on"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar on"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-1</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-in-progress" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M7 3.5 A3.5 3.5 0 0 1 7 10.5 Z" fill="currentColor"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-1">Hydration mismatch on nested holes</a><span class="labels"><span class="label label-bug">bug</span><span class="label label-client">client</span></span><span class="wrap_3b780164"><button class="trigger_3b780164" popovertarget="user-YUK-1" aria-haspopup="dialog" aria-label="Maya Chen"><span class="avatar" title="Maya Chen">MC</span></button><!--[--><!--]--></span><span class="row-date">Nov 2</span></div><!--]--></section><section class="group"><header class="group-header"><svg class="icon status-todo" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle></svg><span class="group-name">Todo</span><span class="group-count">2</span></header><!--[--><div id="row-YUK-8" class="row" data-id="YUK-8"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-medium" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar on"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar on"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-8</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-todo" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-8">Add a new issue dialog</a><span class="labels"><span class="label label-feature">feature</span></span><span class="wrap_3b780164"><button class="trigger_3b780164" popovertarget="user-YUK-8" aria-haspopup="dialog" aria-label="Maya Chen"><span class="avatar" title="Maya Chen">MC</span></button><!--[--><!--]--></span><span class="row-date">Nov 4</span></div><div id="row-YUK-25" class="row" data-id="YUK-25"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-none" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-25</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-todo" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-25">Write the release notes</a><span class="labels"><span class="label label-docs">docs</span></span><span class="wrap_3b780164"><button class="trigger_3b780164" popovertarget="user-YUK-25" aria-haspopup="dialog" aria-label="Maya Chen"><span class="avatar" title="Maya Chen">MC</span></button><!--[--><!--]--></span><span class="row-date">Nov 6</span></div><!--]--></section><section class="group"><header class="group-header"><svg class="icon status-done" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="6.5" fill="currentColor"></circle><path d="M4.5 7.2 L6.4 9 L9.6 5.2" fill="none" stroke="#fff" stroke-width="1.5"></path></svg><span class="group-name">Done</span><span class="group-count">1</span></header><!--[--><div id="row-YUK-23" class="row" data-id="YUK-23"><span class="status-wrap"><button class="icon-button" aria-label="Change priority"><svg class="icon priority-low" viewBox="0 0 14 14" width="14" height="14"><rect x="1" y="8" width="3" height="6" rx="1" class="bar on"></rect><rect x="5" y="5" width="3" height="9" rx="1" class="bar"></rect><rect x="9" y="2" width="3" height="12" rx="1" class="bar"></rect></svg></button><!--[--><!--]--></span><span class="row-id">YUK-23</span><span class="status-wrap"><button class="icon-button" aria-label="Change status"><svg class="icon status-done" viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="6.5" fill="currentColor"></circle><path d="M4.5 7.2 L6.4 9 L9.6 5.2" fill="none" stroke="#fff" stroke-width="1.5"></path></svg></button><!--[--><!--]--></span><a class="row-title" href="/issue/YUK-23">Empty state for the filter</a><span class="labels"><span class="label label-design">design</span></span><span class="wrap_3b780164"><button class="trigger_3b780164" popovertarget="user-YUK-23" aria-haspopup="dialog" aria-label="Maya Chen"><span class="avatar" title="Maya Chen">MC</span></button><!--[--><!--]--></span><span class="row-date">Oct 26</span></div><!--]--></section></div><!--[--><!--]--><!--[--><!--]--></div></yuka-island><script type="application/json" data-yuka-answer="l:csrf">{"ok":"TOKEN"}</script><script type="application/json" data-yuka-answer="l:issues {&quot;workspace&quot;:&quot;Yuka&quot;,&quot;view&quot;:&quot;Mine&quot;}">{"ok":[{"id":"YUK-1","workspace":"Yuka","title":"Hydration mismatch on nested holes","description":"A hole inside an `each` item loses its marker when the item is empty. Reproduce with a filter that matches nothing, then clear it.\n\n## Steps\n\n1. Open the issue list.\n2. Type `zzz` in the filter: no row matches.\n3. Clear the filter.\n\nThe rows come back, but the **first hole** of each row no longer updates.\n\n## Cause\n\nThe printer writes the closing marker only when the item has children:\n\n```ocaml\nlet print_hole buffer ~children =\n  Buffer.add_string buffer \"\u003c!--[-->\";\n  List.iter (print buffer) children;\n  if children \u003c> [] then Buffer.add_string buffer \"\u003c!--]-->\"\n```\n\n> The client looks for the closing marker to know where the hole ends. With no marker it takes the next sibling.\n\nSee the [hydration notes](https://github.com/davesnx/yuka/blob/main/docs/islands.md) for the marker format.","status":"In_progress","priority":"Urgent","assignee":{"id":"maya","name":"Maya Chen"},"labels":["bug","client"],"created_at":"Nov 2"},{"id":"YUK-8","workspace":"Yuka","title":"Add a new issue dialog","description":"Press c to open a dialog with title and description.","status":"Todo","priority":"Medium","assignee":{"id":"maya","name":"Maya Chen"},"labels":["feature"],"created_at":"Nov 4"},{"id":"YUK-23","workspace":"Yuka","title":"Empty state for the filter","description":"Show a message when no issue matches.","status":"Done","priority":"Low","assignee":{"id":"maya","name":"Maya Chen"},"labels":["design"],"created_at":"Oct 26"},{"id":"YUK-25","workspace":"Yuka","title":"Write the release notes","description":"Summarize what v0.1 includes.\n\n# Yuka v0.1\n\n- Server pages with **islands**\n- Client navigation and prefetch\n- Forms that work with JavaScript off\n- Live updates over a socket\n\n## To do\n\n- [x] Collect the changes from `CHANGES.md`\n- [ ] Write the upgrade notes\n- [ ] Publish on [opam](https://opam.ocaml.org)","status":"Todo","priority":"No_priority","assignee":{"id":"maya","name":"Maya Chen"},"labels":["docs"],"created_at":"Nov 6"}]}</script><script type="application/json" data-yuka-answer="r:labels &quot;Yuka&quot;">{"ok":[{"label":"bug","open_":3},{"label":"client","open_":3},{"label":"codec","open_":1},{"label":"design","open_":2},{"label":"docs","open_":2},{"label":"feature","open_":7},{"label":"perf","open_":2},{"label":"server","open_":4}]}</script><script type="application/json" data-yuka-props="i4">{"workspace":"Yuka","title":"My issues","view":"Mine","query":"","chosen":[]}</script></yuka-outlet></main></div></div></body></html>
==== /issue/YUK-1 200
