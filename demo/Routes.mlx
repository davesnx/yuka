let routes =
  <Router not_found=Pages.not_found error=Pages.error
    headers=[ ("x-content-type-options", "nosniff") ] cache=No_store>
    <Route name=About path="/about" page=Pages.about prerender=true />
    <Group path="/" layout=Pages.shell not_found=Pages.not_found error=Pages.error>
      <Route name=Issues path="/" page=Pages.index />
      <Route name=My_issues path="/my" page=Pages.my_issues />
      <Group path="/issue/:id<string>" loader=Loaders.issue not_found=Pages.issue_not_found>
        <Route name=Issue path="/" page=Pages.issue />
      </Group>
    </Group>
    <Endpoint name=Issues_json path="/issues.json" method_=`GET
      handler=Handlers.issues_json cache=(Public { max_age = 60; s_max_age = None }) />
    <Route path="/issues" redirect=(Permanent "/") />
  </Router>
