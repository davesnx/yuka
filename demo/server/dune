(library
 (name demo_app)
 (modules code_style markdown description stress store report pages loaders handlers yuka_routes yuka_css)
 (libraries
  demo_shared
  yuka
  yuka-dream
  dream
  lwt
  lwt.unix
  cmarkit
  ochre
  tm-grammars.ocaml
  tm-grammars.javascript
  tm-grammars.typescript
  tm-grammars.shellscript
  tm-grammars.json
  tm-grammars.less)
 (preprocess
  (pps yuka.ppx)))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Demo_shared.Routes
    --source
    %{dep:../Routes.ml}))))

(executable
 (name demo_server)
 (modules demo_server)
 (libraries demo_app yuka yuka-dream yuka-live-pg dream lwt))

(rule
 (targets yuka_css.ml)
 (deps
  (source_tree ../shared))
 (action
  (with-stdout-to
   yuka_css.ml
   (run %{bin:yuka} css --dir ../shared))))
