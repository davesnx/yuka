(library
 (name demo_app)
 (modules store pages loaders handlers routes_server yuka_css)
 (libraries demo_shared yuka yuka-dream dream lwt lwt.unix)
 (preprocess
  (pps yuka.ppx)))

(rule
 (targets routes_server.ml)
 (action
  (with-stdout-to
   routes_server.ml
   (with-stdin-from
    %{dep:../Routes.ml}
    (run
     %{bin:yuka-routes}
     --server
     --shared-module
     Demo_shared.Routes
     --source
     %{dep:../Routes.ml})))))

(executable
 (name demo_server)
 (modules demo_server)
 (libraries demo_app yuka yuka-dream dream lwt))

(rule
 (targets yuka_css.ml)
 (deps
  (source_tree ../shared))
 (action
  (with-stdout-to
   yuka_css.ml
   (run %{bin:yuka-css} ../shared))))
