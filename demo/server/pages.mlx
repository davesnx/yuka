open Demo_shared

let sidebar workspace : Yuka.server Yuka.element = <Yuka.Client start=(`Lazy `Interaction)><New_issue workspace /></Yuka.Client>
let commit = match Sys.getenv_opt "VERCEL_GIT_COMMIT_SHA" with Some "" -> None | value -> value

let shell_of workspace children : Yuka.server Yuka.element =
  <Views.Shell workspace commit sidebar=(sidebar workspace)>children</Views.Shell>

let shell ~children () = shell_of Model.Workspace.default children

let issue_list ~q ~label workspace view =
  let page_title, title = match view with Queries.All -> ("Issues", "All issues") | Mine -> ("My issues", "My issues") in
  let query = Option.value q ~default:"" in
  Yuka.Server.page ~title:page_title (fun () ->
      <Yuka.Client><Issue_list workspace title view query chosen=label /></Yuka.Client>)

let index ~q ~label () = issue_list ~q ~label Model.Workspace.default Queries.All
let my_issues ~q ~label () = issue_list ~q ~label Model.Workspace.default Queries.Mine

let overlay ~title (page : unit -> Yuka.server Yuka.element) () : Yuka.server Yuka.element =
  <div class_="overlay">
    <Yuka.Client><Overlay_backdrop /></Yuka.Client>
    <div class_="overlay-dialog" role=`dialog aria_label=title>
      <div class_="overlay-bar"><Yuka.Client><Close_button /></Yuka.Client></div>
      (page ())
    </div>
  </div>

let insights_view workspace () : Yuka.server Yuka.element = <Yuka.Client><Insights workspace /></Yuka.Client>
let insights_in workspace = Yuka.Server.page ~title:"Insights" (insights_view workspace)
let insights_dialog_in workspace = Yuka.Server.page ~title:"Insights" (overlay ~title:"Insights" (insights_view workspace))
let insights () = insights_in Model.Workspace.default
let insights_dialog () = insights_dialog_in Model.Workspace.default
let report_view workspace () = Report.view workspace (Store.issues workspace)
let report_in workspace = Yuka.Server.page ~title:"Report" (report_view workspace)
let report_dialog_in workspace = Yuka.Server.page ~title:"Report" (overlay ~title:"Report" (report_view workspace))
let report () = report_in Model.Workspace.default
let report_dialog () = report_dialog_in Model.Workspace.default
let canvas_in workspace =
  Yuka.Server.page ~title:"Canvas" (fun () ->
      <Yuka.Client>
        <Canvas workspace>
          <dl>
            (Yuka.fragment
               (List.map (fun (label, value) -> <div><dt>(Yuka.text label)</dt><dd>(Yuka.text value)</dd></div>) (Store.facts ())))
          </dl>
        </Canvas>
      </Yuka.Client>)
let canvas () = canvas_in Model.Workspace.default

let seconds_of_ms = function None -> 0. | Some ms -> Float.of_int (Int.min 10_000 (Int.max 0 ms)) /. 1000.

let issue_view ~delay ~comments (issue : Model.Issue.t) : Yuka.server Yuka.element =
  let all = comments = Some "all" in
  let comments =
    <Yuka.Await async=(Store.thread_async ~delay ~all issue.id)
      loading=(<Views.Skeleton lines=3 />)
      failed=(fun message -> <p class_="error">(Yuka.text ("Could not load comments: " ^ message))</p>)>
      (fun (thread : Comment.thread) ->
        let fragment = match List.rev thread.first with comment :: _ -> Some (Comments.dom_id comment) | [] -> None in
        let whole_thread = Links.issue issue.workspace ~id:issue.id ~comments:"all" ?fragment in
        <Yuka.Client start=(`Lazy `Idle)>
          <Comments issue_id=issue.id me=Store.me thread whole_thread />
        </Yuka.Client>)
    </Yuka.Await>
  in
  let props =
    <Yuka.Client start=(`Lazy `Interaction)>
      <Issue_props issue>
        <Yuka.Client start=(`Lazy `Visible)>
          <Related related=(Store.related_async ~delay:(delay *. 1.5) issue) />
        </Yuka.Client>
      </Issue_props>
    </Yuka.Client>
  in
  let description = Markup_view.nodes (Markdown.render issue.description) in
  <Views.Issue_page issue description comments props />

let issue ~id ~issue ~comments ~delay () = Yuka.Server.page ~title:id (fun () -> issue_view ~delay:(seconds_of_ms delay) ~comments issue)

let not_found ~path () =
  Yuka.Server.page ~title:"Not found" (fun () ->
      <div class_="not-found">
        <h1>"Page not found"</h1>
        <p>(Yuka.text ("There is no page at " ^ path ^ "."))</p>
        <a href=(Links.issues Model.Workspace.default)>"Back to issues"</a>
      </div>)

let issue_not_found_in workspace ~id = Yuka.Server.page ~title:"Not found" (fun () -> <Views.Not_found workspace id />)
let issue_not_found ~id ~path:_ () = issue_not_found_in Model.Workspace.default ~id

let error () =
  Yuka.Server.page ~title:"Error" (fun () ->
      <div class_="not-found">
        <h1>"Something went wrong"</h1>
        <a href=(Links.issues Model.Workspace.default)>"Back to issues"</a>
      </div>)

let about () =
  Yuka.Server.page ~title:"About" (fun () ->
      <main class_="about">
        <h1>"About"</h1>
        <p>"A mini Linear built with Yuka. This page has no island."</p>
        <a href=(Links.issues Model.Workspace.default)>"Back to issues"</a>
      </main>)

let before_hydration () =
  Yuka.Server.page ~title:"Type before hydration" (fun () ->
      <main class_="about">
        <h1>"Type before the script loads"</h1>
        <p>"The server sends the script of this page 3 seconds late. Type, tick and choose before the status says Interactive: what you did stays, and each State shows it."</p>
        <Yuka.Client><Before_hydration /></Yuka.Client>
      </main>)

let create_in workspace =
  Yuka.Server.page ~title:"New issue" (fun () ->
      <main class_="new-issue-page">
        <h1>"New issue"</h1>
        <Yuka.Form action=Actions.create_issue>
          (fun form ->
            <div>
              <Views.Issue_form workspace form />
              <button class_="button primary" type_=`submit>"Create issue"</button>
            </div>)
        </Yuka.Form>
      </main>)

let create () = create_in Model.Workspace.default

module Workspace = struct
  let shell ~workspace ~children () = shell_of workspace children
  let index ~workspace ~q ~label () = issue_list ~q ~label workspace Queries.All
  let my_issues ~workspace ~q ~label () = issue_list ~q ~label workspace Queries.Mine
  let insights ~workspace () = insights_in workspace
  let insights_dialog ~workspace () = insights_dialog_in workspace
  let report ~workspace () = report_in workspace
  let report_dialog ~workspace () = report_dialog_in workspace
  let canvas ~workspace () = canvas_in workspace
  let create ~workspace () = create_in workspace
  let issue ~workspace:_ ~id ~issue:found ~comments ~delay () =
    Yuka.Server.page ~title:id (fun () -> issue_view ~delay:(seconds_of_ms delay) ~comments found)
  let issue_not_found ~workspace ~id ~path:_ () = issue_not_found_in workspace ~id

end
