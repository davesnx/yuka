open Demo_shared

let sidebar () : Yuka.server Yuka.element =
  <div>
    <Yuka.Client><New_issue /></Yuka.Client>
    <Yuka.Client start=`Idle><Counter initial=0 /></Yuka.Client>
  </div>

let shell ~children () : Yuka.server Yuka.element =
  <Views.Shell workspace="Yuka" sidebar=(sidebar ())>children</Views.Shell>

let index () =
  Yuka.Server.page ~title:"Issues" (fun () ->
      <Yuka.Client><Issue_list title="All issues" view=Queries.All /></Yuka.Client>)

let my_issues () =
  Yuka.Server.page ~title:"My issues" (fun () ->
      <Yuka.Client><Issue_list title="My issues" view=Queries.Mine /></Yuka.Client>)

let issue_view ?(delay = 0.6) (i : Model.Issue.t) : Yuka.server Yuka.element =
  let comments =
    <Yuka.Await async=(Store.comments_async ~delay i.id)
      loading=(<Views.Skeleton lines=3 />)
      failed=(fun m -> <p class_="error">(Yuka.text ("Could not load comments: " ^ m))</p>)>
      (fun comments ->
        <Yuka.Client start=(`Lazy `Idle)>
          <Comments issue_id=i.id me=Store.me comments />
        </Yuka.Client>)
    </Yuka.Await>
  in
  let props =
    <Yuka.Client start=(`Lazy `Interaction)>
      <Issue_props issue=i>
        <Yuka.Client start=(`Lazy `Visible)>
          <Related related=(Store.related_async ~delay:(delay *. 1.5) i) />
        </Yuka.Client>
      </Issue_props>
    </Yuka.Client>
  in
  <Views.Issue_page issue=i comments props />

let issue ~id ~issue () = Yuka.Server.page ~title:id (fun () -> issue_view issue)

let not_found ~path () =
  Yuka.Server.page ~title:"Not found" (fun () ->
      <div class_="not-found">
        <h1>"Page not found"</h1>
        <p>(Yuka.text ("There is no page at " ^ path ^ "."))</p>
        <a href=(Routes.issues ())>"Back to issues"</a>
      </div>)

let issue_not_found ~id ~path:_ () =
  Yuka.Server.page ~title:"Not found" (fun () -> <Views.Not_found id />)

let error () =
  Yuka.Server.page ~title:"Error" (fun () ->
      <div class_="not-found">
        <h1>"Something went wrong"</h1>
        <a href=(Routes.issues ())>"Back to issues"</a>
      </div>)

let about () =
  Yuka.Server.page ~title:"About" (fun () ->
      <main class_="about">
        <h1>"About"</h1>
        <p>"A mini Linear built with Yuka. This page has no island."</p>
        <a href=(Routes.issues ())>"Back to issues"</a>
      </main>)

let create () =
  Yuka.Server.page ~title:"New issue" (fun () ->
      <main class_="new-issue-page">
        <h1>"New issue"</h1>
        <Yuka.Form action=Actions.create_issue>
          (fun form ->
            <div>
              <Views.Issue_form form />
              <button class_="button primary" type_=`submit>"Create issue"</button>
            </div>)
        </Yuka.Form>
      </main>)
