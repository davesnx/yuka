open Demo_shared

let sidebar workspace : Yuka.server Yuka.element =
  <div>
    <Yuka.Client><New_issue workspace /></Yuka.Client>
    <Yuka.Client start=`Idle><Counter initial=0 /></Yuka.Client>
  </div>

let shell_of workspace children : Yuka.server Yuka.element =
  <Views.Shell workspace sidebar=(sidebar workspace)>children</Views.Shell>

let shell ~children () = shell_of Model.Workspace.default children

let issue_list workspace view =
  let page_title, title = match view with Queries.All -> ("Issues", "All issues") | Mine -> ("My issues", "My issues") in
  Yuka.Server.page ~title:page_title (fun () -> <Yuka.Client><Issue_list workspace title view /></Yuka.Client>)

let index () = issue_list Model.Workspace.default Queries.All
let my_issues () = issue_list Model.Workspace.default Queries.Mine

let insights_in workspace =
  Yuka.Server.page ~title:"Insights" (fun () -> <Yuka.Client><Insights workspace /></Yuka.Client>)

let insights () = insights_in Model.Workspace.default

let issue_view ?(delay = 0.6) (issue : Model.Issue.t) : Yuka.server Yuka.element =
  let comments =
    <Yuka.Await async=(Store.comments_async ~delay issue.id)
      loading=(<Views.Skeleton lines=3 />)
      failed=(fun message -> <p class_="error">(Yuka.text ("Could not load comments: " ^ message))</p>)>
      (fun comments ->
        <Yuka.Client start=(`Lazy `Idle)>
          <Comments issue_id=issue.id me=Store.me comments />
        </Yuka.Client>)
    </Yuka.Await>
  in
  let props =
    <Yuka.Client start=(`Lazy `Interaction)>
      <Issue_props issue>
        <Yuka.Client start=(`Lazy `Visible)>
          <Related related=(Store.related_async ~delay:(delay *. 1.5) issue) />
        </Yuka.Client>
      </Issue_props>
    </Yuka.Client>
  in
  <Views.Issue_page issue comments props />

let issue ~id ~issue () = Yuka.Server.page ~title:id (fun () -> issue_view issue)

let not_found ~path () =
  Yuka.Server.page ~title:"Not found" (fun () ->
      <div class_="not-found">
        <h1>"Page not found"</h1>
        <p>(Yuka.text ("There is no page at " ^ path ^ "."))</p>
        <a href=(Links.issues Model.Workspace.default)>"Back to issues"</a>
      </div>)

let issue_not_found_in workspace ~id = Yuka.Server.page ~title:"Not found" (fun () -> <Views.Not_found workspace id />)
let issue_not_found ~id ~path:_ () = issue_not_found_in Model.Workspace.default ~id

let error () =
  Yuka.Server.page ~title:"Error" (fun () ->
      <div class_="not-found">
        <h1>"Something went wrong"</h1>
        <a href=(Links.issues Model.Workspace.default)>"Back to issues"</a>
      </div>)

let about () =
  Yuka.Server.page ~title:"About" (fun () ->
      <main class_="about">
        <h1>"About"</h1>
        <p>"A mini Linear built with Yuka. This page has no island."</p>
        <a href=(Links.issues Model.Workspace.default)>"Back to issues"</a>
      </main>)

let before_hydration () =
  Yuka.Server.page ~title:"Type before hydration" (fun () ->
      <main class_="about">
        <h1>"Type before the script loads"</h1>
        <p>"The server sends the script of this page 3 seconds late. Type, tick and choose before the status says Interactive: what you did stays, and each State shows it."</p>
        <Yuka.Client><Before_hydration /></Yuka.Client>
      </main>)

let create_in workspace =
  Yuka.Server.page ~title:"New issue" (fun () ->
      <main class_="new-issue-page">
        <h1>"New issue"</h1>
        <Yuka.Form action=Actions.create_issue>
          (fun form ->
            <div>
              <Views.Issue_form workspace form />
              <button class_="button primary" type_=`submit>"Create issue"</button>
            </div>)
        </Yuka.Form>
      </main>)

let create () = create_in Model.Workspace.default

module Workspace = struct
  let shell ~workspace ~children () = shell_of workspace children
  let index ~workspace () = issue_list workspace Queries.All
  let my_issues ~workspace () = issue_list workspace Queries.Mine
  let insights ~workspace () = insights_in workspace
  let create ~workspace () = create_in workspace
  let issue ~workspace:_ ~id ~issue:found () = Yuka.Server.page ~title:id (fun () -> issue_view found)
  let issue_not_found ~workspace ~id ~path:_ () = issue_not_found_in workspace ~id

end
