(* A bar at the top of the page while a client navigation loads. It is also the island of
   every page: a page with no island loads no JavaScript, so its links would load full pages,
   with no view transition. On the shelf ([shelf]) it tells the "All records" link of the album
   pages that the shelf is in the history ([Back.from_shelf]). *)

let[@client] make ~(shelf : bool) () =
  Yuka.Effect.after (fun () -> if shelf then Back.from_shelf := true);
  <div class_=(if Yuka.State.get Yuka.Browser.navigating then "progress on" else "progress") aria_hidden=true />
