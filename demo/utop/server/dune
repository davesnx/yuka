(library
 (name utop_demo_app)
 (modules pages yuka_routes serve)
 (libraries utop_demo_shared zed_ui yuka yuka-dream dream)
 (preprocess
  (pps yuka.ppx)))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Utop_demo_shared.Routes
    --source
    %{dep:../Routes.ml}))))

(executable
 (name utop_demo_server)
 (modules utop_demo_server)
 (libraries utop_demo_app dream))
