type demo = {
  name : string;
  description : string;
  path : string;
  tags : string list;
  illustration : unit -> Yuka.server Yuka.element;
}

let window_chrome ~title : Yuka.server Yuka.element =
  <g>
    <rect class_="frame" x="0.5" y="0.5" width="439" height="259" rx="10" />
    <line class_="rule" x1="0" y1="28.5" x2="440" y2="28.5" />
    <circle class_="dot" cx="16" cy="14" r="4" />
    <circle class_="dot" cx="30" cy="14" r="4" />
    <circle class_="dot" cx="44" cy="14" r="4" />
    <text class_="caption" x="220" y="18" text_anchor="middle">(Yuka.text title)</text>
  </g>

let issue_row ~y ~id ~width ~status ~priority ~selected : Yuka.server Yuka.element =
  let y_ = Int.to_string y in
  let mid = Int.to_string (y + 13) in
  <g>
    (if selected then
       <rect class_="selected" x="116" y=y_ width="312" height="26" rx="5" />
     else Yuka.fragment [])
    <circle class_=status cx="132" cy=mid r="5" />
    <text class_="caption" x="146" y=(Int.to_string (y + 17))>(Yuka.text id)</text>
    <rect class_="bar" x="184" y=(Int.to_string (y + 9)) width=(Int.to_string width) height="8" rx="4" />
    <rect class_=(if priority >= 1 then "prio on" else "prio") x="380" y=(Int.to_string (y + 14)) width="3" height="5" />
    <rect class_=(if priority >= 2 then "prio on" else "prio") x="385" y=(Int.to_string (y + 11)) width="3" height="8" />
    <rect class_=(if priority >= 3 then "prio on" else "prio") x="390" y=(Int.to_string (y + 8)) width="3" height="11" />
    <circle class_="avatar" cx="412" cy=mid r="6" />
  </g>

let mini_linear () : Yuka.server Yuka.element =
  <svg class_="art" view_box="0 0 440 260" role=`img aria_label="An issue list with a sidebar">
    (window_chrome ~title:"mini-linear")
    <line class_="rule" x1="104.5" y1="28" x2="104.5" y2="260" />
    <rect class_="accent-fill" x="14" y="42" width="14" height="14" rx="4" />
    <rect class_="bar strong" x="34" y="45" width="48" height="8" rx="4" />
    <rect class_="nav-active" x="8" y="68" width="88" height="20" rx="5" />
    <rect class_="bar" x="16" y="74" width="54" height="8" rx="4" />
    <rect class_="bar" x="16" y="100" width="64" height="8" rx="4" />
    <rect class_="bar" x="16" y="122" width="44" height="8" rx="4" />
    <rect class_="bar" x="16" y="144" width="58" height="8" rx="4" />
    <text class_="caption" x="116" y="52">"In progress"</text>
    <text class_="caption muted" x="196" y="52">"3"</text>
    <line class_="rule" x1="104" y1="62.5" x2="440" y2="62.5" />
    (issue_row ~y:70 ~id:"YK-12" ~width:150 ~status:"status progress" ~priority:3 ~selected:true)
    (issue_row ~y:100 ~id:"YK-9" ~width:112 ~status:"status progress" ~priority:2 ~selected:false)
    (issue_row ~y:130 ~id:"YK-7" ~width:170 ~status:"status progress" ~priority:1 ~selected:false)
    <text class_="caption" x="116" y="180">"Done"</text>
    <text class_="caption muted" x="150" y="180">"2"</text>
    <line class_="rule" x1="104" y1="190.5" x2="440" y2="190.5" />
    (issue_row ~y:198 ~id:"YK-4" ~width:96 ~status:"status done" ~priority:1 ~selected:false)
    (issue_row ~y:228 ~id:"YK-2" ~width:136 ~status:"status done" ~priority:2 ~selected:false)
  </svg>

let feed_item ~y ~source ~width ~time : Yuka.server Yuka.element =
  let y_ = Int.to_string y in
  <g>
    <rect class_="item" x="16.5" y=(y_ ^ ".5") width="246" height="44" rx="7" />
    <rect class_=("source " ^ source) x="28" y=(Int.to_string (y + 12)) width="20" height="20" rx="5" />
    <rect class_="bar strong" x="58" y=(Int.to_string (y + 13)) width=(Int.to_string width) height="7" rx="3.5" />
    <rect class_="bar" x="58" y=(Int.to_string (y + 26)) width=(Int.to_string (width + 40)) height="6" rx="3" />
    <text class_="caption muted" x="250" y=(Int.to_string (y + 20)) text_anchor="end">(Yuka.text time)</text>
  </g>

let async_feed () : Yuka.server Yuka.element =
  <svg class_="art" view_box="0 0 440 260" role=`img aria_label="A feed of notifications with filters and a live chart">
    (window_chrome ~title:"async-feed")
    <rect class_="chip on" x="16.5" y="40.5" width="38" height="18" rx="9" />
    <text class_="caption on" x="35.5" y="53" text_anchor="middle">"All"</text>
    <rect class_="chip" x="60.5" y="40.5" width="50" height="18" rx="9" />
    <text class_="caption" x="85.5" y="53" text_anchor="middle">"Errors"</text>
    <rect class_="chip" x="116.5" y="40.5" width="50" height="18" rx="9" />
    <text class_="caption" x="141.5" y="53" text_anchor="middle">"Deploys"</text>
    <circle class_="live" cx="388" cy="49.5" r="3.5" />
    <text class_="caption" x="424" y="53" text_anchor="end">"LIVE"</text>
    (feed_item ~y:68 ~source:"s1" ~width:120 ~time:"now")
    (feed_item ~y:114 ~source:"s2" ~width:90 ~time:"2m")
    (feed_item ~y:160 ~source:"s3" ~width:138 ~time:"5m")
    <g opacity="0.45">(feed_item ~y:206 ~source:"s4" ~width:104 ~time:"9m")</g>
    <rect class_="item" x="276.5" y="68.5" width="148" height="136" rx="7" />
    <rect class_="bar strong" x="288" y="82" width="64" height="7" rx="3.5" />
    <line class_="grid" x1="288" y1="118.5" x2="412" y2="118.5" />
    <line class_="grid" x1="288" y1="150.5" x2="412" y2="150.5" />
    <line class_="grid" x1="288" y1="182.5" x2="412" y2="182.5" />
    <path class_="area" d="M288 170 L304 160 L320 166 L336 140 L352 148 L368 120 L384 128 L400 104 L412 110 L412 182 L288 182 Z" />
    <polyline class_="line" points="288,170 304,160 320,166 336,140 352,148 368,120 384,128 400,104 412,110" />
    <circle class_="accent-fill" cx="412" cy="110" r="3.5" />
    <rect class_="bar" x="288" y="190" width="40" height="6" rx="3" />
  </svg>

let palettes =
  [
    [ "#6f4cff"; "#9b85ff"; "#c7baff"; "#ece7ff" ];
    [ "#0f766e"; "#14b8a6"; "#5eead4"; "#ccfbf1" ];
    [ "#c2410c"; "#f97316"; "#fdba74"; "#ffedd5" ];
    [ "#be123c"; "#f43f5e"; "#fda4af"; "#ffe4e6" ];
    [ "#1d4ed8"; "#3b82f6"; "#93c5fd"; "#dbeafe" ];
    [ "#a16207"; "#eab308"; "#fde047"; "#fef9c3" ];
  ]

let palette_card ~x ~y colors : Yuka.server Yuka.element =
  let px = Int.to_string in
  <g>
    <rect class_="item" x=(px x ^ ".5") y=(px y ^ ".5") width="124" height="72" rx="7" />
    (Yuka.fragment
       (List.mapi
          (fun i color ->
            <rect x=(px (x + 8 + (i * 27))) y=(px (y + 8)) width="27" height="40" fill=color />)
          colors))
    <rect class_="bar strong" x=(px (x + 8)) y=(px (y + 56)) width="56" height="7" rx="3.5" />
  </g>

let skeleton_card ~x ~y : Yuka.server Yuka.element =
  let px = Int.to_string in
  <g>
    <rect class_="skeleton" x=(px x ^ ".5") y=(px y ^ ".5") width="124" height="36" rx="7" />
    <rect class_="bar" x=(px (x + 8)) y=(px (y + 8)) width="108" height="20" rx="4" />
  </g>

let infinite_scroll () : Yuka.server Yuka.element =
  <svg class_="art" view_box="0 0 440 260" role=`img aria_label="A grid of colour palettes ending in skeleton cards">
    (window_chrome ~title:"infinite-scroll")
    (Yuka.fragment
       (List.mapi
          (fun i colors -> palette_card ~x:(16 + (i mod 3 * 138)) ~y:(42 + (i / 3 * 84)) colors)
          palettes))
    <g opacity="0.7">
      (skeleton_card ~x:16 ~y:210)
      (skeleton_card ~x:154 ~y:210)
      (skeleton_card ~x:292 ~y:210)
    </g>
    <line class_="sentinel" x1="16" y1="205.5" x2="424" y2="205.5" />
    <rect class_="chip on" x="182.5" y="196.5" width="76" height="18" rx="9" />
    <text class_="caption on" x="220.5" y="209" text_anchor="middle">"Loading…"</text>
  </svg>

let crate () : Yuka.server Yuka.element =
  let small ~x ~y ~fill = <rect x=(Int.to_string x) y=(Int.to_string y) width="40" height="40" rx="3" fill /> in
  <svg class_="art" view_box="0 0 440 260" role=`img aria_label="A small record cover growing into a large one">
    (window_chrome ~title:"crate")
    (small ~x:24 ~y:56 ~fill:"#f2a33a")
    (small ~x:72 ~y:56 ~fill:"#5b8def")
    (small ~x:24 ~y:116 ~fill:"#3fb68b")
    <rect class_="sentinel" x="72.5" y="116.5" width="39" height="39" rx="3" fill="none" />
    (small ~x:24 ~y:176 ~fill:"#e0607e")
    (small ~x:72 ~y:176 ~fill:"#8f74ff")
    <path class_="line" d="M120 136 C160 136 170 110 206 110" stroke_dasharray="4 4" />
    <path class_="line" d="M200 104 L208 110 L200 116" />
    <circle cx="348" cy="138" r="78" fill="#2b2b31" />
    <circle cx="348" cy="138" r="56" fill="none" stroke="#3a3a42" />
    <circle cx="348" cy="138" r="14" class_="accent-fill" />
    <rect x="220" y="62" width="150" height="150" rx="5" fill="#8f74ff" />
    <rect x="232" y="186" width="70" height="8" rx="2" fill="#ffffff" opacity="0.85" />
  </svg>

let poster_line y =
  Printf.sprintf "M116 %d C140 %d 160 %d 182 %d S224 %d 240 %d" y (y - 18) (y + 18) y (y - 14) (y - 4)

let posters () : Yuka.server Yuka.element =
  <svg class_="art" view_box="0 0 440 260" role=`img aria_label="A poster of flowing lines next to its settings">
    (window_chrome ~title:"posters")
    <rect class_="poster" x="104" y="40" width="148" height="208" rx="4" />
    (Yuka.fragment
       (List.init 7 (fun i -> <path class_="poster-line" d=(poster_line (78 + (i * 16))) />)))
    <rect class_="poster-title" x="116" y="208" width="84" height="9" rx="2" />
    <rect class_="poster-text" x="116" y="224" width="56" height="6" rx="2" />
    <rect class_="bar strong" x="16" y="48" width="64" height="7" rx="3.5" />
    <rect class_="item" x="16.5" y="62.5" width="72" height="18" rx="4" />
    <rect class_="bar" x="16" y="94" width="48" height="7" rx="3.5" />
    <rect class_="item" x="16.5" y="108.5" width="72" height="18" rx="4" />
    <rect class_="chip on" x="272.5" y="44.5" width="44" height="18" rx="9" />
    <text class_="caption on" x="294.5" y="57" text_anchor="middle">"Lines"</text>
    <rect class_="chip" x="322.5" y="44.5" width="48" height="18" rx="9" />
    <text class_="caption" x="346.5" y="57" text_anchor="middle">"Blocks"</text>
    <rect class_="chip" x="376.5" y="44.5" width="48" height="18" rx="9" />
    <text class_="caption" x="400.5" y="57" text_anchor="middle">"Clouds"</text>
    <text class_="caption" x="272" y="90">"Lines"</text>
    <line class_="rule" x1="272" y1="104.5" x2="424" y2="104.5" />
    <circle class_="accent-fill" cx="352" cy="104.5" r="5" />
    <text class_="caption" x="272" y="130">"Direction"</text>
    <circle class_="item" cx="300" cy="162" r="18" />
    <line class_="line" x1="300" y1="162" x2="312" y2="150" />
    <text class_="caption" x="272" y="206">"Theme"</text>
    <rect class_="chip on" x="272.5" y="214.5" width="44" height="18" rx="9" />
    <text class_="caption on" x="294.5" y="227" text_anchor="middle">"Dark"</text>
    <rect class_="chip" x="322.5" y="214.5" width="44" height="18" rx="9" />
    <text class_="caption" x="344.5" y="227" text_anchor="middle">"Light"</text>
  </svg>

let demos =
  [
    {
      name = "Mini Linear";
      description = "An issue tracker: streamed pages, islands, live updates and a shared store.";
      path = "/mini-linear";
      tags = [ "Streaming"; "Islands"; "Live"; "Store" ];
      illustration = mini_linear;
    };
    {
      name = "Async";
      description = "A feed of notifications from many sources, with filters in the URL and events streamed live.";
      path = "/async-feed";
      tags = [ "URL state"; "Yuka.Live"; "Async" ];
      illustration = async_feed;
    };
    {
      name = "Posters";
      description =
        "A generative poster playground: one Poster component in an island, an SVG route and a prerendered gallery.";
      path = "/posters";
      tags = [ "Islands"; "URL state"; "SVG"; "Prerender" ];
      illustration = posters;
    };
    {
      name = "Infinite scroll";
      description = "An endless gallery of palettes: the next page loads when the end of the list comes into view.";
      path = "/infinite-scroll";
      tags = [ "on_visible"; "keep_scroll"; "URL state" ];
      illustration = infinite_scroll;
    };
    {
      name = "Crate";
      description =
        "A crate of records with view transitions: a cover grows into its album page, and Back puts it in its slot.";
      path = "/crate";
      tags = [ "View transitions"; "~transitions"; "data-yuka-transition" ];
      illustration = crate;
    };
  ]

let style =
  {|
:root{color-scheme:light dark;--bg:#fafafa;--fg:#0b0b0f;--muted:#6b6b76;--line:#e4e4e9;--panel:#ffffff;--soft:#f1f1f4;--accent:#6f4cff;--accent-soft:rgba(111,76,255,.12);--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
@media (prefers-color-scheme:dark){:root{--bg:#0a0a0c;--fg:#ededf0;--muted:#8a8a96;--line:#25252b;--panel:#111114;--soft:#1a1a1f;--accent:#8f74ff;--accent-soft:rgba(143,116,255,.16)}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}
.page{max-width:calc(960px + 50px);margin:0 auto;padding:96px 24px 120px;min-height:100vh}
h1{font-size:44px;line-height:1.1;letter-spacing:-.03em;font-weight:600;margin:0}
.gallery{list-style:none;padding:0;margin:64px 0 0;display:grid;gap:32px}
.card{position:relative;display:grid;grid-template-columns:1fr 1.15fr;min-height:300px;background:var(--panel);border:1px solid var(--line);border-radius:14px;color:inherit;text-decoration:none;overflow:hidden;transition:border-color .2s,box-shadow .2s}
.card:hover{border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
.card:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.body{display:flex;flex-direction:column;padding:32px}
h2{font-size:24px;letter-spacing:-.02em;font-weight:600;margin:0 0 8px}
.description{color:var(--muted);margin:0;font-size:15px}
.tags{list-style:none;padding:0;margin:20px 0 0;display:flex;flex-wrap:wrap;gap:6px}
.tags li{font:500 11px/1 var(--mono);padding:6px 8px;border:1px solid var(--line);border-radius:6px;color:var(--muted);background:var(--soft)}
.preview{border-left:1px solid var(--line);background-color:var(--soft);background-image:radial-gradient(var(--line) 1px,transparent 1px);background-size:16px 16px;display:grid;place-items:center;padding:28px}
.art{width:100%;height:auto;max-width:440px;filter:drop-shadow(0 8px 24px rgba(0,0,0,.08))}
.art .frame{fill:var(--panel);stroke:var(--line)}
.art .rule,.art .grid{stroke:var(--line)}
.art .dot{fill:var(--line)}
.art .caption{font:500 10px var(--mono);fill:var(--muted)}
.art .caption.muted{opacity:.6}
.art .caption.on{fill:#fff}
.art .bar{fill:var(--line)}
.art .bar.strong{fill:var(--muted);opacity:.55}
.art .nav-active{fill:var(--soft)}
.art .selected{fill:var(--accent-soft)}
.art .accent-fill{fill:var(--accent)}
.art .status{fill:none;stroke-width:2}
.art .status.progress{stroke:#f2a33a}
.art .status.done{stroke:var(--accent);fill:var(--accent)}
.art .prio{fill:var(--line)}
.art .prio.on{fill:var(--muted)}
.art .avatar{fill:var(--line)}
.art .chip{fill:var(--panel);stroke:var(--line)}
.art .chip.on{fill:var(--accent);stroke:var(--accent)}
.art .live{fill:#22c55e}
.art .item{fill:var(--panel);stroke:var(--line)}
.art .source.s1{fill:#ef4444}.art .source.s2{fill:#3b82f6}.art .source.s3{fill:var(--accent)}.art .source.s4{fill:#22c55e}
.art .skeleton{fill:var(--panel);stroke:var(--line);stroke-dasharray:4 3}
.art .sentinel{stroke:var(--accent);stroke-dasharray:4 4}
.art .area{fill:var(--accent-soft)}
.art .poster{fill:#111114}
.art .poster-line{fill:none;stroke:#f2a33a;stroke-width:3;stroke-linecap:round}
.art .poster-title{fill:#ededf0}
.art .poster-text{fill:#8a8a96}
.art .line{fill:none;stroke:var(--accent);stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
@media (max-width:720px){.page{padding-top:56px}h1{font-size:34px}.card{grid-template-columns:1fr}.preview{border-left:0;border-top:1px solid var(--line);order:-1}.body{padding:24px}}
@media (prefers-reduced-motion:reduce){.card{transition:none}}
|}

let head = {|<meta name="viewport" content="width=device-width, initial-scale=1"><style>|} ^ style ^ {|</style>|}

let card demo : Yuka.server Yuka.element =
  <li>
    <a class_="card" href=demo.path target=`_blank rel="noopener">
      <div class_="body">
        <h2>(Yuka.text demo.name)</h2>
        <p class_="description">(Yuka.text demo.description)</p>
        <ul class_="tags">(Yuka.fragment (List.map (fun tag -> <li>(Yuka.text tag)</li>) demo.tags))</ul>
      </div>
      <div class_="preview">(demo.illustration ())</div>
    </a>
  </li>

let home () =
  Yuka.Server.page ~title:"Yuka demos" (fun () ->
      <main class_="page">
        <h1>"Yuka demos"</h1>
        <ul class_="gallery">(Yuka.fragment (List.map card demos))</ul>
      </main>)
