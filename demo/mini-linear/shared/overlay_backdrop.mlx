let[@client] make () =
  Yuka.Effect.after
    ~cleanup:(fun () -> Yuka.State.set Ui.overlays (Yuka.State.peek Ui.overlays - 1))
    (fun () -> Yuka.State.set Ui.overlays (Yuka.State.peek Ui.overlays + 1));
  <div class_="overlay-backdrop" aria_hidden=true on_click=(fun _ -> Yuka.Browser.back ()) />
