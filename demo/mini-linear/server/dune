(library
 (name demo_app)
 (modules report pages loaders handlers yuka_routes yuka_css)
 (libraries demo_shared yuka dream)
 (preprocess
  (pps yuka.ppx)))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Demo_shared.Routes
    --source
    %{dep:../Routes.ml}))))

(executable
 (name demo_server)
 (modules demo_server)
 (libraries demo_app demo_index async_feed_app posters_app yuka yuka-dream yuka-live-pg dream lwt unix))

(rule
 (targets yuka_css.ml)
 (deps
  (source_tree ../shared)
  (sandbox always))
 (action
  (with-stdout-to
   yuka_css.ml
   (run %{bin:yuka} css --dir ../shared))))
