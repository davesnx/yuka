let[@client] make ~(id : int) ~(count : int) () =
  let label () =
    match Feed.count ~id count with 1 -> "1 comment" | n -> Int.to_string n ^ " comments"
  in
  <a class_="comment-button" href=(Routes.item ~id ()) aria_label=(label ()) title=(label ())>
    <svg view_box="0 0 16 16" width="14" height="14" aria_hidden=true>
      <path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z" fill="none" stroke="currentColor" stroke_width="1.4"
        stroke_linejoin=`round />
    </svg>
    (Yuka.int (Feed.count ~id count))
  </a>
