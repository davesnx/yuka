let logo ?(size = 32) source =
  let s = Int.to_string size in
  let cls = "logo logo-" ^ Model.source_slug source in
  let label = Model.source_label source in
  match source with
  | Model.New_relic ->
      <svg class_=cls view_box="0 0 32 32" width=s height=s role=`img aria_label=label>
        <rect class_="logo-bg" width="32" height="32" rx="8" fill="#1d252c" />
        <path d="M16 6.2 L24.5 11.1 V20.9 L16 25.8 L13.1 24.1 V17.7 L18.8 14.4 V11.1 L16 9.5 L10.3 12.8 V19.3 L7.5 17.7 V11.1 Z"
          fill="#1ce783" />
        <path d="M7.5 17.7 L13.1 20.9 V24.1 L7.5 20.9 Z" fill="#ffffff" />
      </svg>
  | Vercel ->
      <svg class_=cls view_box="0 0 32 32" width=s height=s role=`img aria_label=label>
        <rect class_="logo-bg" width="32" height="32" rx="8" />
        <path class_="logo-fg" d="M16 8.5 L24.6 23.2 H7.4 Z" />
      </svg>
  | Figma ->
      <svg class_=cls view_box="0 0 32 32" width=s height=s role=`img aria_label=label>
        <rect class_="logo-bg" width="32" height="32" rx="8" fill="#1e1e1e" />
        <path d="M12.5 12.5 H16 V5.5 H12.5 A3.5 3.5 0 0 0 12.5 12.5 Z" fill="#f24e1e" />
        <path d="M16 5.5 V12.5 H19.5 A3.5 3.5 0 0 0 19.5 5.5 Z" fill="#ff7262" />
        <path d="M12.5 19.5 H16 V12.5 H12.5 A3.5 3.5 0 0 0 12.5 19.5 Z" fill="#a259ff" />
        <circle cx="19.5" cy="16" r="3.5" fill="#1abcfe" />
        <path d="M12.5 26.5 A3.5 3.5 0 0 0 16 23 V19.5 H12.5 A3.5 3.5 0 0 0 12.5 26.5 Z" fill="#0acf83" />
      </svg>
  | Reddit ->
      <svg class_=cls view_box="0 0 32 32" width=s height=s role=`img aria_label=label>
        <rect class_="logo-bg" width="32" height="32" rx="8" fill="#ff4500" />
        <path d="M16 12.8 L17.8 8.3 L21.7 9.2" fill="none" stroke="#ffffff" stroke_width="1.4" stroke_linecap=`round stroke_linejoin=`round />
        <circle cx="22.8" cy="9.4" r="1.5" fill="#ffffff" />
        <circle cx="9.2" cy="16.2" r="2.1" fill="#ffffff" />
        <circle cx="22.8" cy="16.2" r="2.1" fill="#ffffff" />
        <path d="M16 12.5 C20.8 12.5 24 15 24 18.2 C24 21.4 20.8 24 16 24 C11.2 24 8 21.4 8 18.2 C8 15 11.2 12.5 16 12.5 Z" fill="#ffffff" />
        <circle cx="13.2" cy="17.6" r="1.35" fill="#ff4500" />
        <circle cx="18.8" cy="17.6" r="1.35" fill="#ff4500" />
        <path d="M13 20.8 Q16 22.8 19 20.8" fill="none" stroke="#ff4500" stroke_width="1.3" stroke_linecap=`round />
      </svg>
  | Github ->
      <svg class_=cls view_box="0 0 32 32" width=s height=s role=`img aria_label=label>
        <rect class_="logo-bg" width="32" height="32" rx="8" />
        <path class_="logo-fg" fill_rule=`evenodd clip_rule=`evenodd
          d="M16 6.5 C10.75 6.5 6.5 10.75 6.5 16 C6.5 20.2 9.22 23.76 13 25.02 C13.48 25.1 13.65 24.81 13.65 24.56 C13.65 24.33 13.64 23.58 13.64 22.78 C11 23.35 10.44 21.66 10.44 21.66 C10.01 20.56 9.38 20.27 9.38 20.27 C8.52 19.68 9.45 19.69 9.45 19.69 C10.4 19.76 10.9 20.67 10.9 20.67 C11.75 22.12 13.12 21.7 13.67 21.46 C13.75 20.85 14 20.43 14.27 20.19 C12.16 19.95 9.94 19.14 9.94 15.5 C9.94 14.46 10.31 13.62 10.92 12.95 C10.82 12.71 10.49 11.74 11.01 10.43 C11.01 10.43 11.81 10.17 13.63 11.4 C14.39 11.19 15.2 11.09 16.01 11.08 C16.82 11.09 17.63 11.19 18.39 11.4 C20.2 10.17 21 10.43 21 10.43 C21.52 11.74 21.19 12.71 21.09 12.95 C21.7 13.62 22.07 14.46 22.07 15.5 C22.07 19.15 19.85 19.95 17.73 20.18 C18.07 20.47 18.37 21.04 18.37 21.92 C18.37 23.18 18.36 24.2 18.36 24.56 C18.36 24.81 18.53 25.11 19.02 25.02 C22.79 23.76 25.5 20.2 25.5 16 C25.5 10.75 21.25 6.5 16 6.5 Z" />
      </svg>

let make ~(event : Model.event) ?(fresh = false) ~time ~comments () =
  <li class_=(if fresh then "card card-new" else "card") data_id=(Int.to_string event.id)>
    <a class_="card-link" href=(Routes.item ~id:event.id ())>
      (logo event.source)
      <div class_="card-body">
        <div class_="card-meta">
          <span class_="card-source">(Yuka.text (Model.source_label event.source))</span>
          (if event.author = Model.source_label event.source then Yuka.empty
           else
             <span class_="card-author">
               <Avatar name=event.author size=18 />
               <span>(Yuka.text event.author)</span>
             </span>)
          time
        </div>
        <h2 class_="card-title">(Yuka.text event.title)</h2>
        <div class_="card-tags">
          <span class_="tag">(Yuka.text event.project)</span>
          <span class_="tag">(Yuka.text event.team)</span>
          <span class_="tag tag-assignee">
            <Avatar name=event.assignee size=16 />
            <span>(Yuka.text event.assignee)</span>
          </span>
          comments
        </div>
      </div>
    </a>
  </li>
