(library
 (name async_feed_shared)
 (modes native melange)
 (libraries yuka)
 (melange.libraries yuka yuka.web)
 (preprocess
  (pps yuka.ppx))
 (melange.preprocess
  (pps yuka.ppx melange.ppx)))

(rule
 (targets routes.ml)
 (action
  (with-stdout-to
   routes.ml
   (run %{bin:yuka} routes --shared --source %{dep:../Routes.ml}))))
