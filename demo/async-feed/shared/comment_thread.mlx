let comment ~time (entry : Model.comment) =
  <li class_="comment">
    <Avatar name=entry.author size=28 class_="comment-avatar" />
    <div class_="comment-body">
      <div class_="comment-meta">
        <span class_="comment-author">(Yuka.text entry.author)</span>
        (time entry.time)
      </div>
      <p class_="comment-text">(Yuka.text entry.text)</p>
    </div>
  </li>

let[@client] make ~(item : int) ~(count : int) ~children () =
  let added : Model.comment list Yuka.State.t = Yuka.State.make [] in
  let total () = count + List.length (Yuka.State.get added) in
  let draft = Yuka.State.make "" in
  let error : string option Yuka.State.t = Yuka.State.make None in
  let sending = Yuka.State.make false in
  let finish result =
    Yuka.batch (fun () ->
        Yuka.State.set sending false;
        match result with
        | Ok (Ok next) ->
            Yuka.State.set added (List.filteri (fun index _ -> index >= count) next);
            Yuka.State.set draft "";
            Yuka.State.set error None;
            Feed.set_count ~id:item (List.length next)
        | Ok (Error status) -> Yuka.State.set error (Some (Yuka.Status.error_to_string status))
        | Error message -> Yuka.State.set error (Some message))
  in
  let submit () =
    let text = Yuka.State.peek draft in
    if String.trim text = "" then Yuka.State.set error (Some "Write a comment first.")
    else if not (Yuka.State.peek sending) then begin
      Yuka.State.set sending true;
      Yuka.Async.on_result (Yuka.Action.call Feed.comment { Feed.item; text }) finish
    end
  in
  <div class_="thread">
    <section class_="comments" aria_labelledby="overlay-comments-title">
      <h3 id="overlay-comments-title" class_="section-title">
        "Comments " <span class_="muted">(Yuka.int (total ()))</span>
      </h3>
      (if total () = 0 then <p class_="hint">"No comments yet. Start the discussion."</p> else Yuka.empty)
      <ol class_="comment-list">
        children
        (Yuka.fragment
           (List.map (comment ~time:(fun time -> <Local_time time class_="comment-time" />)) (Yuka.State.get added)))
      </ol>
    </section>
    <form class_="comment-form"
      on_submit=(fun event ->
        Yuka.Event.prevent_default event;
        submit ())>
      <label class_="sr-only" for_="overlay-comment-text">"Add a comment"</label>
      <textarea id="overlay-comment-text" name="text" rows=1 placeholder="Add a comment..."
        aria_invalid=(if Yuka.State.get error = None then `false_ else `true_) aria_describedby="overlay-comment-error"
        value=(Yuka.State.get draft)
        on_input=(fun event -> Yuka.State.set draft (Yuka.Event.target_value event))
        on_keydown=(fun event ->
          if Yuka.Event.key event = "Enter" && (Yuka.Event.meta_key event || Yuka.Event.ctrl_key event) then begin
            Yuka.Event.prevent_default event;
            submit ()
          end) />
      <div class_="comment-actions">
        <p id="overlay-comment-error" class_="comment-error" role=`alert>
          (Yuka.text (Option.value (Yuka.State.get error) ~default:""))
        </p>
        <button class_="small-button primary" type_=`submit disabled=(Yuka.State.get sending)>"Comment"</button>
      </div>
    </form>
  </div>
