let[@client] make ~(filter : Model.filter) ~(since : int) () =
  let live = Yuka.Live.make Feed.recent (fun () -> ()) in
  let running = Yuka.State.make false in
  let seen = ref (-1) in
  let fresh () =
    match Yuka.Status.data (Yuka.State.get (Yuka.Live.state live)) with
    | Some events ->
        events
        |> List.filter (fun (event : Model.event) -> event.id > since && Model.matches filter event)
        |> List.rev
    | _ -> []
  in
  Yuka.Effect.after (fun () ->
      let count = List.length (fresh ()) in
      if !seen < 0 || count > !seen then begin
        seen := count;
        Yuka.Browser.scroll_into_view "feed-bottom"
      end
      else seen := count);
  let simulate _ =
    Yuka.State.set running true;
    Yuka.Async.on_result (Yuka.Action.call Feed.simulate ()) (fun _ -> Yuka.State.set running false)
  in
  <div class_="feed-live-wrap">
    <ol class_="feed feed-live" aria_live=`polite>
      (Yuka.each ~key:(fun (event : Model.event) -> Int.to_string event.id)
         (fun () -> Array.of_list (fresh ()))
         (fun (event : Model.event) ->
           <Card event fresh=true time=(<Local_time time=event.time class_="card-time" />)
             comments=(<Comment_count id=event.id count=0 />) />))
    </ol>
    <div id="feed-bottom" class_="feed-bottom" />
    <button class_="simulate" type_=`button disabled=(Yuka.State.get running) on_click=simulate>
      <span class_="pulse" aria_hidden=true />
      (Yuka.text (if Yuka.State.get running then "Streaming events" else "Simulate events"))
    </button>
  </div>
