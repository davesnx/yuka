(library
 (name demo_shared)
 (modes native melange)
 (libraries yuka)
 (preprocess
  (pps yuka.ppx))
 (preprocessor_deps
  (glob_files *.css)))

(rule
 (targets routes.ml)
 (action
  (with-stdout-to
   routes.ml
   (with-stdin-from
    %{dep:../Routes.ml}
    (run %{bin:yuka-routes} --shared --source %{dep:../Routes.ml})))))
