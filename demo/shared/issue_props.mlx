open Yuka
open Model

let%client make ~(issue : Model.Issue.t) ~(children : Yuka.slot) () =
  let live = Live.use Topics.issue (fun () -> issue.id) in
  let current =
    State.memo (fun () -> Option.value (Status.data (Live.status live)) ~default:issue)
  in
  let error : string option State.t = State.make None in
  let change ?status ?priority () =
    State.set error None;
    let edit (i : Issue.t) =
      {
        i with
        status = Option.value status ~default:i.status;
        priority = Option.value priority ~default:i.priority;
      }
    in
    Async.on_result
      (Live.mutate live edit (fun () ->
           Action.call Actions.update_issue { Actions.id = issue.id; status; priority }))
      (function Ok _ -> () | Error _ -> State.set error (Some "Could not update the issue."))
  in
  let select label items slug to_label of_slug selected on_pick =
    <select class_="select" aria_label=label value=(slug (State.get selected))
      on_change=(fun e -> Option.iter on_pick (of_slug (Event.target_value e)))>
      (Yuka.list
         (List.map
            (fun x ->
              <option value=(slug x)>
                (Yuka.text (to_label x))
              </option>)
            items))
    </select>
  in
  let status = State.memo (fun () -> (State.get current).status) in
  let priority = State.memo (fun () -> (State.get current).priority) in
  <Yuka.Catch fallback=(fun ~error:_ ~reset ->
      <div class_="props">
        <p class_="error">"The properties could not be shown."</p>
        <button class_="button" on_click=(fun _ -> reset ())>"Try again"</button>
      </div>)>
    <div class_="props">
      <Views.Property name="Status">
        (Views.Status_icon.make ~status:(State.get status) ())
        (select "Status" Issue.all_statuses Issue.status_slug Issue.status_label
           Issue.status_of_slug status (fun s -> change ~status:s ()))
      </Views.Property>
      <Views.Property name="Priority">
        (Views.Priority_icon.make ~priority:(State.get priority) ())
        (select "Priority" Issue.all_priorities Issue.priority_slug Issue.priority_label
           Issue.priority_of_slug priority (fun p -> change ~priority:p ()))
      </Views.Property>
      <Views.Property name="Assignee">
        <Views.Avatar user=issue.assignee />
        (Yuka.text (match issue.assignee with Some u -> u.User.name | None -> "Unassigned"))
      </Views.Property>
      <Views.Property name="Labels"><Views.Labels labels=issue.labels /></Views.Property>
      <Views.Property name="Created">(Yuka.text issue.created_at)</Views.Property>
      (match State.get error with
       | Some m -> <p class_="error">(Yuka.text m)</p>
       | None -> Yuka.empty)
      (Yuka.hole (fun () ->
         match Live.status live with
         | Status.Ready { stale = true; _ } -> <p class_="offline">"Offline"</p>
         | _ -> Yuka.empty))
      (Yuka.slot children)
    </div>
  </Yuka.Catch>
