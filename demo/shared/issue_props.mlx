open Model

let[@client] make ~(issue : Model.Issue.t) ~children () =
  let live = Yuka.Live.use Topics.issue (fun () -> issue.id) in
  let current =
    Yuka.State.memo (fun () -> Option.value (Yuka.Status.data (Yuka.Live.status live)) ~default:issue)
  in
  let error : string option Yuka.State.t = Yuka.State.make None in
  let change ?status ?priority () =
    Yuka.State.set error None;
    let edit (cached : Issue.t) =
      {
        cached with
        status = Option.value status ~default:cached.status;
        priority = Option.value priority ~default:cached.priority;
      }
    in
    Yuka.Async.on_result
      (Yuka.Live.optimistic live ~change:edit (fun () ->
           Yuka.Action.call Actions.update_issue { Actions.id = issue.id; status; priority }))
      (function Ok (Ok _) -> () | Ok (Error _) | Error _ -> Yuka.State.set error (Some "Could not update the issue."))
  in
  let select label items slug to_label of_slug selected on_pick =
    <select class_="select" aria_label=label value=(slug (Yuka.State.get selected))
      on_change=(fun event -> Option.iter on_pick (of_slug (Yuka.Event.target_value event)))>
      (Yuka.fragment
         (List.map
            (fun item ->
              <option value=(slug item)>
                (Yuka.text (to_label item))
              </option>)
            items))
    </select>
  in
  let status = Yuka.State.memo (fun () -> (Yuka.State.get current).status) in
  let priority = Yuka.State.memo (fun () -> (Yuka.State.get current).priority) in
  <Yuka.Catch fallback=(fun ~error:_ ~reset ->
      <div class_="props">
        <p class_="error">"The properties could not be shown."</p>
        <button class_="button" on_click=(fun _ -> reset ())>"Try again"</button>
      </div>)>
    <div class_="props">
      <Views.Property name="Status">
        (Views.Status_icon.make ~status:(Yuka.State.get status) ())
        (select "Status" Issue.all_statuses Issue.status_slug Issue.status_label
           Issue.status_of_slug status (fun status -> change ~status ()))
      </Views.Property>
      <Views.Property name="Priority">
        (Views.Priority_icon.make ~priority:(Yuka.State.get priority) ())
        (select "Priority" Issue.all_priorities Issue.priority_slug Issue.priority_label
           Issue.priority_of_slug priority (fun priority -> change ~priority ()))
      </Views.Property>
      <Views.Property name="Assignee">
        <Views.Avatar user=issue.assignee />
        (Yuka.text (match issue.assignee with Some user -> user.User.name | None -> "Unassigned"))
      </Views.Property>
      <Views.Property name="Labels"><Views.Labels labels=issue.labels /></Views.Property>
      <Views.Property name="Created">(Yuka.text issue.created_at)</Views.Property>
      (match Yuka.State.get error with
       | Some message -> <p class_="error">(Yuka.text message)</p>
       | None -> Yuka.empty)
      (Yuka.hole (fun () ->
         match Yuka.Live.status live with
         | Yuka.Status.Ready { stale = true; _ } -> <p class_="offline">"Offline"</p>
         | _ -> Yuka.empty))
      children
    </div>
  </Yuka.Catch>
