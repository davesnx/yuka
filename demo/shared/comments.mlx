let[@client] make ~(issue_id : string) ~(me : Model.User.t) ~(comments : Comment.t list) () =
  let comments = Yuka.State.make comments in
  let draft = Yuka.State.make "" in
  let error : string option Yuka.State.t = Yuka.State.make None in
  let pending = Yuka.State.make 0 in
  let submit () =
    let body = String.trim (Yuka.State.peek draft) in
    if body <> "" then (
      let count = Yuka.State.peek pending + 1 in
      let tmp : Comment.t = { id = "tmp-" ^ Int.to_string count; author = me; body = Markup.of_text body; created_at = "Just now" } in
      Yuka.batch (fun () ->
          Yuka.State.set pending count;
          Yuka.State.set error None;
          Yuka.State.set draft "";
          Yuka.State.set comments (Yuka.State.peek comments @ [ tmp ]));
      let swap with_ =
        Yuka.State.set comments
          (List.filter_map
             (fun (comment : Comment.t) ->
               if comment.id <> tmp.id then Some comment else with_)
             (Yuka.State.peek comments))
      in
      let failed message =
        Yuka.batch (fun () ->
            swap None;
            Yuka.State.set draft body;
            Yuka.State.set error (Some message))
      in
      Yuka.Async.on_result
        (Yuka.Action.call Comment.add { Comment.issue_id; body })
        (function
          | Ok (Ok saved) ->
              Yuka.State.set comments
                (List.map (fun (existing : Comment.t) -> if existing.id = tmp.id then saved else existing) (Yuka.State.peek comments))
          | Ok (Error status) -> failed (Yuka.Status.error_to_string status)
          | Error message -> failed message))
  in
  let comment (entry : Comment.t) : Yuka.client Yuka.element =
    <li class_="comment">
      <Views.Avatar user=(Some entry.author) />
      <div class_="comment-body">
        <div class_="comment-meta">
          <b>(Yuka.text entry.author.name)</b>
          <span class_="muted">(Yuka.text entry.created_at)</span>
        </div>
        <div class_="comment-text markdown">(Markup_view.nodes entry.body)</div>
      </div>
    </li>
  in
  <div class_="activity">
    <ul class_="comments">
      (Yuka.each ~key:(fun (comment : Comment.t) -> comment.id) (fun () -> Array.of_list (Yuka.State.get comments)) comment)
    </ul>
    <div class_="comment-box">
      <textarea class_="comment-input" placeholder="Leave a comment" rows=3
        value=(Yuka.State.get draft)
        on_input=(fun event -> Yuka.State.set draft (Yuka.Event.target_value event)) />
      (match Yuka.State.get error with
       | Some message -> <p class_="error">(Yuka.text message)</p>
       | None -> Yuka.empty)
      <button class_="button primary" disabled=(Yuka.State.get draft = "") on_click=(fun _ -> submit ())>"Comment"</button>
    </div>
  </div>
