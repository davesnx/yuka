module Css = [%yuka.css "theme_menu.css"]

type choice = Ui of Theme.t | Code of Theme.Code.t option

let theme_choices = List.map (fun theme -> Ui theme) Theme.all
let code_choices = Code None :: List.map (fun code -> Code (Some code)) Theme.Code.all
let choices = theme_choices @ code_choices

let item_id = function
  | Ui theme -> "theme-" ^ Theme.slug theme
  | Code None -> "code-auto"
  | Code (Some code) -> "code-" ^ Theme.Code.slug code

let index_of choice = Option.value (List.find_index (fun candidate -> candidate = choice) choices) ~default:0

let[@client] make () =
  let opened = Yuka.State.make false in
  let current = Yuka.State.make Theme.Dark in
  let code = Yuka.State.make None in
  let active = Yuka.State.make 0 in
  let close ~refocus =
    Yuka.State.set opened false;
    if refocus then Yuka.Browser.focus "theme-button"
  in
  let open_menu () =
    let theme = Theme.current () in
    Yuka.State.set current theme;
    Yuka.State.set code (Theme.current_code ());
    Yuka.State.set active (index_of (Ui theme));
    Yuka.State.set opened true;
    Yuka.Browser.focus (item_id (Ui theme))
  in
  let move step =
    let count = List.length choices in
    let next = (Yuka.State.peek active + step + count) mod count in
    Yuka.State.set active next;
    Yuka.Browser.focus (item_id (List.nth choices next))
  in
  let choose choice =
    (match choice with
    | Ui theme ->
        Theme.apply theme;
        Yuka.State.set current theme
    | Code choice ->
        Theme.apply_code choice;
        Yuka.State.set code choice);
    close ~refocus:true
  in
  Yuka.Effect.after (fun () ->
      Yuka.Browser.on_window "keydown" (fun event ->
          if Yuka.State.peek opened then
            match Yuka.Event.key event with
            | "Escape" -> close ~refocus:true
            | "Tab" -> close ~refocus:false
            | "ArrowDown" ->
                Yuka.Event.prevent_default event;
                move 1
            | "ArrowUp" ->
                Yuka.Event.prevent_default event;
                move (-1)
            | "Home" ->
                Yuka.Event.prevent_default event;
                move (- Yuka.State.peek active)
            | "End" ->
                Yuka.Event.prevent_default event;
                move (List.length choices - 1 - Yuka.State.peek active)
            | _ -> ()));
  let item choice =
    let checked =
      match choice with Ui theme -> Yuka.State.get current = theme | Code choice -> Yuka.State.get code = choice
    in
    <button id=(item_id choice) class_="menu-item" type_=`button role=`menuitemradio
      tabindex=(if Yuka.State.get active = index_of choice then 0 else -1)
      aria_checked=(if checked then `true_ else `false_)
      on_click=(fun _ -> choose choice)>
      (match choice with
      | Ui theme -> <span class_=Css.swatch data_theme=(Theme.slug theme) />
      | Code None -> <span class_=Css.swatch data_theme=(Theme.slug (Yuka.State.get current)) />
      | Code (Some code) -> <span class_=(Css.swatch ^ " " ^ Css.code_swatch) data_code=(Theme.Code.slug code) />)
      (Yuka.text
         (match choice with
         | Ui theme -> Theme.label theme
         | Code None -> "Auto"
         | Code (Some code) -> Theme.Code.label code))
      (if checked then
         <svg class_=Css.check view_box="0 0 14 14" width="14" height="14" aria_hidden=true>
           <path d="M3 7.5 L6 10.5 L11 4" fill="none" stroke="currentColor" stroke_width="1.75" />
         </svg>
       else Yuka.empty)
    </button>
  in
  let group ~id ~label items =
    <div class_=Css.group role=`group aria_labelledby=id>
      <div id class_=Css.heading role=`presentation>(Yuka.text label)</div>
      (Yuka.fragment (List.map item items))
    </div>
  in
  <div class_=Css.theme>
    <button id="theme-button" class_=("topbar-link " ^ Css.button) type_=`button aria_label="Theme" aria_haspopup=`menu
      aria_expanded=(Yuka.State.get opened)
      on_click=(fun _ -> if Yuka.State.peek opened then close ~refocus:false else open_menu ())>
      <svg class_="icon" view_box="0 0 16 16" width="16" height="16" aria_hidden=true>
        <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke_width="1.5" />
        <path d="M8 1.75 A6.25 6.25 0 0 1 8 14.25 Z" fill="currentColor" />
      </svg>
      <span class_="topbar-label">"Theme"</span>
    </button>
    (if Yuka.State.get opened then
       <div>
         <div class_="backdrop" on_click=(fun _ -> close ~refocus:false) />
         <div class_=("menu " ^ Css.menu) role=`menu aria_label="Theme and code style">
           (group ~id:"theme-group" ~label:"Theme" theme_choices)
           (group ~id:"code-group" ~label:"Code" code_choices)
         </div>
       </div>
     else Yuka.empty)
  </div>
