open Model

module Status_icon = struct
  let make ~status () : _ Yuka.element =
    let mark =
      match status with
      | Issue.Backlog -> <circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke_width="1.5" />
      | Todo -> <circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke_width="1.5" />
      | In_progress -> <path d="M7 3.5 A3.5 3.5 0 0 1 7 10.5 Z" fill="currentColor" />
      | Done -> <path d="M4.5 7.2 L6.4 9 L9.6 5.2" fill="none" stroke="#fff" stroke_width="1.5" />
      | Canceled -> <path d="M5 5 L9 9 M9 5 L5 9" fill="none" stroke="currentColor" stroke_width="1.5" />
    in
    let ring =
      match status with
      | Issue.Done -> <circle cx="7" cy="7" r="6.5" fill="currentColor" />
      | In_progress -> <circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke_width="1.5" />
      | _ -> Yuka.empty
    in
    <svg class_=("icon status-" ^ Issue.status_slug status) view_box="0 0 14 14" width="14" height="14">
      ring
      mark
    </svg>
end

module Priority_icon = struct
  let make ~priority () : _ Yuka.element =
    let level = match priority with
      | Issue.Urgent -> 4 | High -> 3 | Medium -> 2 | Low -> 1 | No_priority -> 0 in
    let bar index =
      let height = 3 + (index * 3) in
      <rect x=(Int.to_string ((index - 1) * 4 + 1)) y=(Int.to_string (14 - height)) width="3" height=(Int.to_string height) rx="1"
        class_=(if index <= level then "bar on" else "bar") />
    in
    <svg class_=("icon priority-" ^ Issue.priority_slug priority) view_box="0 0 14 14" width="14" height="14">
      (Yuka.fragment (List.map bar [ 1; 2; 3 ]))
    </svg>
end

module Avatar = struct
  let make ~user () : _ Yuka.element =
    match user with
    | Some user -> <span class_="avatar" title=user.User.name>(Yuka.text (User.initials user))</span>
    | None -> <span class_="avatar empty" title="Unassigned">"?"</span>
end

module Labels = struct
  let make ~labels () : _ Yuka.element =
    <span class_="labels">
      (Yuka.fragment
         (List.map (fun label -> <span class_=("label label-" ^ label)>(Yuka.text label)</span>) labels))
    </span>
end

module Group_header = struct
  let make ~status ~count () : _ Yuka.element =
    <header class_="group-header">
      <Status_icon status />
      <span class_="group-name">(Yuka.text (Issue.status_label status))</span>
      <span class_="group-count">(Yuka.int count)</span>
    </header>
end

module Logo = struct
  let make () : _ Yuka.element =
    <svg class_="logo" view_box="0 0 256 256" width="20" height="20" fill="currentColor" aria_hidden=true>
      <path d="M128 136 127.8 114.3 99 46.6 115.4 118.3ZM128 136 140.6 118.3 157 46.6 128.2 114.3ZM128 136 121.4 115.8 73.9 61.6 110.8 123.4ZM128 136 145.2 123.4 182.1 61.6 134.6 115.8ZM128 136 115.8 119.1 55.2 83.1 108.2 129.6ZM128 136 147.8 129.6 200.8 83.1 140.2 119.1ZM128 136 111.6 123.8 44.3 108.8 107.6 136.2ZM128 136 148.4 136.2 211.7 108.8 144.4 123.8ZM128 136 109.1 129.5 42 136 109.1 142.5ZM128 136 146.9 142.5 214 136 146.9 129.5ZM128 136 108.4 135.5 48.1 162 112.4 147.9ZM128 136 143.6 147.9 207.9 162 147.6 135.5ZM128 136 109.6 141.3 61.7 184.2 117.2 151.9ZM128 136 138.8 151.9 194.3 184.2 146.4 141.3ZM128 136m-8 0a8 8 0 1 0 16 0a8 8 0 1 0 -16 0ZM128 136 122.5 152.8 128 248 133.5 152.8ZM128 136 135.5 105.5 128 14 120.5 105.5Z" />
    </svg>
end

module Github_icon = struct
  let make () : _ Yuka.element =
    <svg class_="icon" view_box="0 0 16 16" width="16" height="16" fill="currentColor" aria_hidden=true>
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
    </svg>
end

module Header = struct
  let make ~workspace () : _ Yuka.element =
    let switch (choice : Workspace.t) =
      <a class_="workspace-link" href=(Links.issues choice)
        aria_current=(if choice = workspace then `true_ else `false_)>
        <span class_="workspace-logo">(Yuka.text (String.sub (Workspace.name choice) 0 1))</span>
        <span>(Yuka.text (Workspace.name choice))</span>
      </a>
    in
    <header class_="topbar">
      <a class_="brand" href=(Links.issues Workspace.default) aria_label="Yuka">
        <Logo />
        <span class_="brand-name">"Yuka"</span>
      </a>
      <nav class_="workspaces" aria_label="Workspaces">(Yuka.fragment (List.map switch Workspace.all))</nav>
      <div class_="topbar-end">
        <div class_="topbar-tools" />
        <a class_="topbar-link" href="https://github.com/davesnx/yuka" target=`_blank rel="noopener" aria_label="Yuka on GitHub">
          <Github_icon />
          <span class_="topbar-label">"GitHub"</span>
        </a>
        <a class_="topbar-link" href="https://x.com/davesnx" target=`_blank rel="noopener">
          <img class_="profile-avatar" src="/static/davesnx.jpg" alt="" width="22" height="22" />
          <span>"@davesnx"</span>
        </a>
      </div>
    </header>
end

module Shell = struct
  let make ~workspace ~sidebar ~children () : _ Yuka.element =
    let links = [ (Links.issues workspace, "Issues"); (Links.my_issues workspace, "My issues") ] in
    <div class_="app">
      <Header workspace />
      <div class_="app-body">
        <aside class_="sidebar">
          <nav class_="nav">
            (Yuka.fragment (List.map (fun (href, label) -> <a class_="nav-link" href>(Yuka.text label)</a>) links))
          </nav>
          <div class_="sidebar-extra">sidebar</div>
        </aside>
        <main class_="main">children</main>
      </div>
    </div>
end

module Skeleton = struct
  let make ~lines () : _ Yuka.element =
    <div class_="skeleton">
      (Yuka.fragment (List.init lines (fun index -> <div class_=("skeleton-line w" ^ Int.to_string (index mod 3)) />)))
    </div>
end

module Property = struct
  let make ~name ~children () : _ Yuka.element =
    <div class_="property">
      <span class_="property-name">(Yuka.text name)</span>
      <span class_="property-value">children</span>
    </div>
end

module Issue_page = struct
  let make ~issue ~comments ~props () : _ Yuka.element =
    <div class_="issue-page">
      <header class_="page-header">
        <a href=(Links.issues issue.Issue.workspace) class_="crumb">"Issues"</a>
        <span class_="muted">"/"</span>
        <span>(Yuka.text issue.id)</span>
      </header>
      <div class_="issue-layout">
        <article class_="issue-main">
          <h1 class_="issue-title">(Yuka.text issue.title)</h1>
          <p class_="issue-description">(Yuka.text issue.description)</p>
          <h2 class_="section-title">"Activity"</h2>
          comments
        </article>
        <aside class_="properties">props</aside>
      </div>
    </div>
end

module Not_found = struct
  let make ~workspace ~id () : _ Yuka.element =
    <div class_="not-found">
      <h1>"Issue not found"</h1>
      <p>(Yuka.text ("There is no issue " ^ id ^ "."))</p>
      <a href=(Links.issues workspace)>"Back to issues"</a>
    </div>
end

module Issue_form = struct
  let make ~workspace ~form () : _ Yuka.element =
    let sent_status = match Yuka.Form.value form `Status with "" -> "todo" | value -> value in
    let sent_priority = match Yuka.Form.value form `Priority with "" -> "no-priority" | value -> value in
    <div class_="issue-form">
      <input type_=`hidden name="workspace" value=(Workspace.slug workspace) />
      <input class_="dialog-title" type_=`text id="dialog-title" name="title" placeholder="Issue title"
        autofocus=true value=(Yuka.Form.value form `Title) />
      (Yuka.Form.error_view form `Title (fun message -> <p class_="error">(Yuka.text message)</p>))
      <textarea class_="dialog-description" name="description" placeholder="Description" rows=4
        value=(Yuka.Form.value form `Description) />
      <div class_="dialog-row">
        <select class_="select" aria_label="Status" name="status">
          (Yuka.fragment
             (List.map
                (fun status ->
                  <option value=(Issue.status_slug status) selected=(Issue.status_slug status = sent_status)>
                    (Yuka.text (Issue.status_label status))
                  </option>)
                Issue.all_statuses))
        </select>
        <select class_="select" aria_label="Priority" name="priority">
          (Yuka.fragment
             (List.map
                (fun priority ->
                  <option value=(Issue.priority_slug priority) selected=(Issue.priority_slug priority = sent_priority)>
                    (Yuka.text (Issue.priority_label priority))
                  </option>)
                Issue.all_priorities))
        </select>
      </div>
      (Yuka.Form.errors_view form (fun message -> <p class_="error">(Yuka.text message)</p>))
    </div>
end
