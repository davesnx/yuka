open Model
module Css = [%yuka.css "related.css"]

let[@client] make ~(related : Model.Issue.t list Yuka.Async.t) () =
  <div class_=Css.related>
    <h2 class_="section-title">"Related issues"</h2>
    <Yuka.Await async=related
       loading=(<Views.Skeleton lines=3 />)
       failed=(fun message -> <p class_="error">(Yuka.text ("Could not load: " ^ message))</p>)>
       (fun issues ->
         if issues = [] then <p class_="muted">"None."</p>
         else
           <ul class_=Css.related_list>
             (Yuka.fragment
                (List.map
                   (fun (issue : Issue.t) ->
                     <li>
                       <Views.Status_icon status=issue.status />
                       <a href=(Links.issue issue.workspace ~id:issue.id)>(Yuka.text (issue.id ^ " " ^ issue.title))</a>
                     </li>)
                   issues))
           </ul>)
    </Yuka.Await>
  </div>
