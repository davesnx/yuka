open Model

let%client[@yuka.lazy] make ~(related : Model.Issue.t list Yuka.Async.t) () =
  <div class_="related">
    <h2 class_="section-title">"Related issues"</h2>
    <Yuka.Await async=related
       loading=(<Views.Skeleton lines=3 />)
       failed=(fun m -> <p class_="error">(Yuka.text ("Could not load: " ^ m))</p>)>
       (fun issues ->
         if issues = [] then <p class_="muted">"None."</p>
         else
           <ul class_="related-list">
             (Yuka.list
                (List.map
                   (fun (i : Issue.t) ->
                     <li>
                       <Views.Status_icon status=i.status />
                       <a href=(Routes.issue_url i.id)>(Yuka.text (i.id ^ " " ^ i.title))</a>
                     </li>)
                   issues))
           </ul>)
    </Yuka.Await>
  </div>
