open Model

type menu = Status of string | Priority of string

let index_of id items =
  let rec go index = function
    | [] -> None
    | (issue : Issue.t) :: rest -> if issue.id = id then Some index else go (index + 1) rest
  in
  go 0 items

let[@client] make ~(title : string) ~(view : Queries.view) () =
  let source = Yuka.Live.use Topics.issues (fun () -> view) in
  let issues =
    Yuka.State.memo (fun () -> Option.value (Yuka.Status.data (Yuka.Live.status source)) ~default:[])
  in
  let labels = Yuka.Remote.use Queries.labels (fun () -> ()) in
  let filter = Yuka.State.make "" in
  let label : string option Yuka.State.t = Yuka.State.make None in
  let selected : string option Yuka.State.t = Yuka.State.make None in
  let menu : menu option Yuka.State.t = Yuka.State.make None in
  let toast : string option Yuka.State.t = Yuka.State.make None in
  let visible =
    Yuka.State.memo ~equal:( = ) (fun () ->
        let query = Yuka.State.get filter and only = Yuka.State.get label in
        List.filter
          (fun (issue : Issue.t) ->
            Issue.matches ~query issue && match only with Some chosen -> List.mem chosen issue.labels | None -> true)
          (Yuka.State.get issues))
  in
  let groups = Yuka.State.memo ~equal:( = ) (fun () -> Issue.group (Yuka.State.get visible)) in
  let ordered = Yuka.State.memo ~equal:( = ) (fun () -> List.concat_map snd (Yuka.State.get groups)) in
  let change ~id ?status ?priority () =
    Yuka.State.set menu None;
    Yuka.State.set toast None;
    let edit (issue : Issue.t) =
      if issue.id <> id then issue
      else
        {
          issue with
          status = Option.value status ~default:issue.status;
          priority = Option.value priority ~default:issue.priority;
        }
    in
    Yuka.Async.on_result
      (Yuka.Live.optimistic source ~change:(List.map edit) (fun () ->
           Yuka.Action.call Actions.update_issue { Actions.id; status; priority }))
      (function
        | Ok (Ok _) -> if status <> None then Yuka.Remote.invalidate Queries.labels
        | Ok (Error _) | Error _ -> Yuka.State.set toast (Some ("Could not update " ^ id ^ ".")))
  in
  let move step =
    let items = Yuka.State.peek ordered in
    let count = List.length items in
    if count > 0 then
      let current =
        match Yuka.State.peek selected with
        | None -> if step > 0 then -1 else count
        | Some id -> Option.value (index_of id items) ~default:(if step > 0 then -1 else count)
      in
      let next = (List.nth items (max 0 (min (count - 1) (current + step)))).id in
      Yuka.State.set selected (Some next);
      Yuka.Browser.scroll_into_view ("row-" ^ next)
  in
  let on_key event =
    if not (Ui.typing event || Yuka.State.peek Ui.dialog_open || Yuka.Event.ctrl_key event || Yuka.Event.meta_key event)
    then
      match Yuka.Event.key event with
      | "j" -> move 1
      | "k" -> move (-1)
      | "Escape" -> Yuka.State.set menu None
      | "Enter" -> (
          match Yuka.State.peek selected with
          | Some id -> Yuka.Browser.navigate (Routes.issue ~id ())
          | None -> ())
      | _ -> ()
  in
  Yuka.Effect.after (fun () -> Yuka.Browser.on_window "keydown" on_key);
  let popup items : Yuka.client Yuka.element =
    Yuka.fragment
      [
        <div class_="backdrop" on_click=(fun _ -> Yuka.State.set menu None) />;
        <ul class_="menu">(Yuka.fragment items)</ul>;
      ]
  in
  let status_menu (issue : Issue.t) =
    popup
      (List.map
         (fun status ->
           <li>
             <button class_="menu-item" on_click=(fun _ -> change ~id:issue.id ~status ())>
               <Views.Status_icon status />
               (Yuka.text (Issue.status_label status))
             </button>
           </li>)
         Issue.all_statuses)
  in
  let priority_menu (issue : Issue.t) =
    popup
      (List.map
         (fun priority ->
           <li>
             <button class_="menu-item" on_click=(fun _ -> change ~id:issue.id ~priority ())>
               <Views.Priority_icon priority />
               (Yuka.text (Issue.priority_label priority))
             </button>
           </li>)
         Issue.all_priorities)
  in
  let row (issue : Issue.t) : Yuka.client Yuka.element =
    <div
      id=("row-" ^ issue.id)
      class_=(if Yuka.State.get selected = Some issue.id then "row selected" else "row")
      data_id=issue.id>
      <span class_="status-wrap">
        <button class_="icon-button" aria_label="Change priority"
          on_click=(fun _ -> Yuka.State.set menu (Some (Priority issue.id)))>
          <Views.Priority_icon priority=issue.priority />
        </button>
        (if Yuka.State.get menu = Some (Priority issue.id) then priority_menu issue else Yuka.empty)
      </span>
      <span class_="row-id">(Yuka.text issue.id)</span>
      <span class_="status-wrap">
        <button class_="icon-button" aria_label="Change status"
          on_click=(fun _ -> Yuka.State.set menu (Some (Status issue.id)))>
          <Views.Status_icon status=issue.status />
        </button>
        (if Yuka.State.get menu = Some (Status issue.id) then status_menu issue else Yuka.empty)
      </span>
      <a class_="row-title" href=(Routes.issue ~id:issue.id ())>(Yuka.text issue.title)</a>
      <Views.Labels labels=issue.labels />
      <Views.Avatar user=issue.assignee />
      <span class_="row-date">(Yuka.text issue.created_at)</span>
    </div>
  in
  let group ((status, items) : Issue.status * Issue.t list) : Yuka.client Yuka.element =
    <section class_="group">
      <Views.Group_header status count=(List.length items) />
      (Yuka.each ~key:(fun (issue : Issue.t) -> issue.id) (fun () -> Array.of_list items) row)
    </section>
  in
  <div class_="issues">
    <header class_="page-header">
      <span>(Yuka.text title)</span>
      <span class_="group-count">(Yuka.int (List.length (Yuka.State.get issues)))</span>
      (Yuka.hole (fun () ->
         match Yuka.Live.status source with
         | Yuka.Status.Ready { stale = true; _ } -> <span class_="offline">"Offline, reconnecting"</span>
         | _ -> Yuka.empty))
    </header>
    <div class_="toolbar">
      <input class_="filter" type_=`text placeholder="Filter issues (j/k to move, Enter to open)"
        on_input=(fun event -> Yuka.State.set filter (Yuka.Event.target_value event)) />
      (Yuka.hole (fun () ->
         match Yuka.Remote.status labels with
         | Yuka.Status.Ready { data; _ } | Yuka.Status.Loading (Some data) ->
             Yuka.fragment
               (List.map
                  (fun (count : Queries.label_count) ->
                    <button
                      class_=(if Yuka.State.get label = Some count.label then "chip on" else "chip")
                      data_label=count.label
                      on_click=(fun _ ->
                        Yuka.State.set label (if Yuka.State.peek label = Some count.label then None else Some count.label))>
                      (Yuka.text (count.label ^ " " ^ Int.to_string count.open_))
                    </button>)
                  data)
         | _ -> Yuka.empty))
    </div>
    (match Yuka.State.get toast with
     | Some message ->
         <div class_="toast">
           <span>(Yuka.text message)</span>
           <button class_="icon-button" aria_label="Dismiss" on_click=(fun _ -> Yuka.State.set toast None)>"x"</button>
         </div>
     | None -> Yuka.empty)
    <div class_="list">
      (Yuka.each ~equal:( = ) ~key:(fun (status, _) -> Issue.status_slug status) (fun () -> Array.of_list (Yuka.State.get groups)) group)
    </div>
    <Yuka.Show status=(fun () -> Yuka.Live.status source)
      loading=(<p class_="list-empty">"Loading issues..."</p>)
      failed=(fun error ->
        <p class_="list-empty error">
          (Yuka.text ("Could not load the issues: " ^ Yuka.Status.error_to_string error ^ ". "))
          <a class_="button retry" href="">"Reload"</a>
        </p>)>
      (fun _ -> Yuka.empty)
    </Yuka.Show>
    (if Yuka.State.get visible = [] && Option.is_some (Yuka.Status.data (Yuka.Live.status source)) then
       <p class_="list-empty">"No issues match."</p>
     else Yuka.empty)
  </div>
