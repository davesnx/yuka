open Yuka
open Model

type menu = Status of string | Priority of string

let index_of id items =
  let rec go i = function
    | [] -> None
    | (x : Issue.t) :: rest -> if x.id = id then Some i else go (i + 1) rest
  in
  go 0 items

let%client make ~(title : string) ~(view : Queries.view) () =
  let source = Live.use Topics.issues (fun () -> view) in
  let issues =
    State.memo (fun () -> Option.value (Status.data (Live.status source)) ~default:[])
  in
  let labels = Remote.use Queries.labels (fun () -> ()) in
  let filter = State.make "" in
  let label : string option State.t = State.make None in
  let selected : string option State.t = State.make None in
  let menu : menu option State.t = State.make None in
  let toast : string option State.t = State.make None in
  let visible =
    State.memo ~equal:( = ) (fun () ->
        let query = State.get filter and only = State.get label in
        List.filter
          (fun (i : Issue.t) ->
            Issue.matches ~query i && match only with Some l -> List.mem l i.labels | None -> true)
          (State.get issues))
  in
  let groups = State.memo ~equal:( = ) (fun () -> Issue.group (State.get visible)) in
  let ordered = State.memo ~equal:( = ) (fun () -> List.concat_map snd (State.get groups)) in
  let change ~id ?status ?priority () =
    State.set menu None;
    State.set toast None;
    let edit (i : Issue.t) =
      if i.id <> id then i
      else
        {
          i with
          status = Option.value status ~default:i.status;
          priority = Option.value priority ~default:i.priority;
        }
    in
    Async.on_result
      (Live.mutate source ~change:(List.map edit) (fun () ->
           Action.call Actions.update_issue { Actions.id; status; priority }))
      (function
        | Ok (Ok _) -> if status <> None then Remote.invalidate Queries.labels
        | Ok (Error _) | Error _ -> State.set toast (Some ("Could not update " ^ id ^ ".")))
  in
  let move step =
    let items = State.peek ordered in
    let n = List.length items in
    if n > 0 then
      let current =
        match State.peek selected with
        | None -> if step > 0 then -1 else n
        | Some id -> Option.value (index_of id items) ~default:(if step > 0 then -1 else n)
      in
      let next = (List.nth items (max 0 (min (n - 1) (current + step)))).id in
      State.set selected (Some next);
      Browser.scroll_into_view ("row-" ^ next)
  in
  let on_key e =
    if not (Ui.typing e || State.peek Ui.dialog_open || Event.ctrl_key e || Event.meta_key e)
    then
      match Event.key e with
      | "j" -> move 1
      | "k" -> move (-1)
      | "Escape" -> State.set menu None
      | "Enter" -> (
          match State.peek selected with
          | Some id -> Browser.navigate (Routes.href (Issue { id }))
          | None -> ())
      | _ -> ()
  in
  Effect.run (fun () -> Browser.on_window "keydown" on_key);
  let popup items : client element =
    Yuka.fragment
      [
        <div class_="backdrop" on_click=(fun _ -> State.set menu None) />;
        <ul class_="menu">(Yuka.fragment items)</ul>;
      ]
  in
  let status_menu (issue : Issue.t) =
    popup
      (List.map
         (fun s ->
           <li>
             <button class_="menu-item" on_click=(fun _ -> change ~id:issue.id ~status:s ())>
               <Views.Status_icon status=s />
               (Yuka.text (Issue.status_label s))
             </button>
           </li>)
         Issue.all_statuses)
  in
  let priority_menu (issue : Issue.t) =
    popup
      (List.map
         (fun p ->
           <li>
             <button class_="menu-item" on_click=(fun _ -> change ~id:issue.id ~priority:p ())>
               <Views.Priority_icon priority=p />
               (Yuka.text (Issue.priority_label p))
             </button>
           </li>)
         Issue.all_priorities)
  in
  let row (issue : Issue.t) : client element =
    <div
      id=("row-" ^ issue.id)
      class_=(if State.get selected = Some issue.id then "row selected" else "row")
      data_id=issue.id>
      <span class_="status-wrap">
        <button class_="icon-button" aria_label="Change priority"
          on_click=(fun _ -> State.set menu (Some (Priority issue.id)))>
          <Views.Priority_icon priority=issue.priority />
        </button>
        (if State.get menu = Some (Priority issue.id) then priority_menu issue else Yuka.empty)
      </span>
      <span class_="row-id">(Yuka.text issue.id)</span>
      <span class_="status-wrap">
        <button class_="icon-button" aria_label="Change status"
          on_click=(fun _ -> State.set menu (Some (Status issue.id)))>
          <Views.Status_icon status=issue.status />
        </button>
        (if State.get menu = Some (Status issue.id) then status_menu issue else Yuka.empty)
      </span>
      <a class_="row-title" href=(Routes.href (Issue { id = issue.id }))>(Yuka.text issue.title)</a>
      <Views.Labels labels=issue.labels />
      <Views.Avatar user=issue.assignee />
      <span class_="row-date">(Yuka.text issue.created_at)</span>
    </div>
  in
  let group ((status, items) : Issue.status * Issue.t list) : client element =
    <section class_="group">
      <Views.Group_header status count=(List.length items) />
      (Yuka.each ~key:(fun (i : Issue.t) -> i.id) (fun () -> Array.of_list items) row)
    </section>
  in
  <div class_="issues">
    <header class_="page-header">
      <span>(Yuka.text title)</span>
      <span class_="group-count">(Yuka.int (List.length (State.get issues)))</span>
      (Yuka.hole (fun () ->
         match Live.status source with
         | Status.Ready { stale = true; _ } -> <span class_="offline">"Offline, reconnecting"</span>
         | _ -> Yuka.empty))
    </header>
    <div class_="toolbar">
      <input class_="filter" type_=`text placeholder="Filter issues (j/k to move, Enter to open)"
        on_input=(fun e -> State.set filter (Event.target_value e)) />
      (Yuka.hole (fun () ->
         match Remote.status labels with
         | Status.Ready { data; _ } | Status.Loading (Some data) ->
             Yuka.fragment
               (List.map
                  (fun (l : Queries.label_count) ->
                    <button
                      class_=(if State.get label = Some l.label then "chip on" else "chip")
                      data_label=l.label
                      on_click=(fun _ ->
                        State.set label (if State.peek label = Some l.label then None else Some l.label))>
                      (Yuka.text (l.label ^ " " ^ string_of_int l.open_))
                    </button>)
                  data)
         | _ -> Yuka.empty))
    </div>
    (match State.get toast with
     | Some message ->
         <div class_="toast">
           <span>(Yuka.text message)</span>
           <button class_="icon-button" aria_label="Dismiss" on_click=(fun _ -> State.set toast None)>"x"</button>
         </div>
     | None -> Yuka.empty)
    <div class_="list">
      (Yuka.each ~equal:( = ) ~key:(fun (s, _) -> Issue.status_slug s) (fun () -> Array.of_list (State.get groups)) group)
    </div>
    <Yuka.Show status=(fun () -> Live.status source)
      loading=(<p class_="list-empty">"Loading issues..."</p>)
      failed=(fun error ->
        <p class_="list-empty error">
          (Yuka.text ("Could not load the issues: " ^ Status.error_to_string error ^ ". "))
          <a class_="button retry" href="">"Reload"</a>
        </p>)>
      (fun _ -> Yuka.empty)
    </Yuka.Show>
    (if State.get visible = [] && Option.is_some (Status.data (Live.status source)) then
       <p class_="list-empty">"No issues match."</p>
     else Yuka.empty)
  </div>
