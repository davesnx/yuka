(melange.emit
 (target out)
 (alias demo-client)
 (libraries demo_shared yuka yuka.js)
 (preprocess
  (pps yuka.ppx melange.ppx))
 (module_systems
  (esm js)))

(rule
 (targets yuka_islands.ml)
 (deps
  (source_tree ../shared)
  (sandbox always))
 (action
  (with-stdout-to
   yuka_islands.ml
   (run %{bin:yuka} islands --dir ../shared))))

(rule
 (targets yuka_islands.json)
 (deps
  (source_tree ../shared)
  (sandbox always))
 (action
  (with-stdout-to
   yuka_islands.json
   (run %{bin:yuka} islands --manifest --dir ../shared))))
