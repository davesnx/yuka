(library
 (name posters_app)
 (modules pages handlers yuka_routes serve)
 (libraries posters_shared yuka yuka-dream dream unix)
 (preprocess
  (pps yuka.ppx)))

(rule
 (targets yuka_routes.ml)
 (action
  (with-stdout-to
   yuka_routes.ml
   (run
    %{bin:yuka}
    routes
    --server
    --shared-module
    Posters_shared.Routes
    --source
    %{dep:../Routes.ml}))))

(executable
 (name posters_server)
 (modules posters_server)
 (libraries posters_app dream))
